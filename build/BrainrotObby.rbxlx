    <Item class="ModuleScript" referent="12">
      <Properties>
        <string name="Name">Codes</string>
        <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- PROMO CODES (server only - players can't read this file, so codes for future
-- promotions stay secret until you announce them).
--
-- Codes are case-insensitive. Post them on social media / YouTube descriptions
-- to drive traffic. Optional Expires = unix timestamp (https://www.epochconverter.com).
-- Reward keys: Coins, Brainrot (given once; BrainrotCoins instead if owned).
--------------------------------------------------------------------------------

return {
	RELEASE = { Coins = 500 },
	BRAINROT = { Coins = 250 },
	SAHUR = { Brainrot = "Bongo Banana", BrainrotCoins = 300 },
	-- EXAMPLE = { Coins = 1000, Expires = 1767225600 },
}
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="13">
      <Properties>
        <string name="Name">Server</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- Brainrot Obby - server bootstrap
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Services = script.Parent:WaitForChild("Services")

Remotes.Init()

-- Build the course first so services can reference checkpoints.
local CourseBuilder = require(Services.CourseBuilder)
CourseBuilder.Build()

local START_ORDER = {
	"DataService",
	"GamepassService",
	"EconomyService",
	"EventService",
	"MoverService",
	"StageService",
	"CoinService",
	"BrainrotService",
	"FragmentService",
	"RewardService",
	"QuestService",
	"ShopService",
	"LeaderboardService",
	"PlayerService",
}

for _, serviceName in ipairs(START_ORDER) do
	local module = Services:FindFirstChild(serviceName)
	if not module then
		warn("[Server] Missing service module: " .. serviceName)
		continue
	end
	local service = require(module)
	if type(service.Init) == "function" then
		local ok, err = pcall(service.Init)
		if not ok then
			warn("[Server] " .. serviceName .. ".Init failed: " .. tostring(err))
		end
	end
end

local brainrots = 0
for _ in pairs(Config.Brainrots) do
	brainrots += 1
end
print(string.format("[%s] Server ready (v%d). %d stages, %d worlds, %d brainrots.", Config.GameName, Config.Version, Config.TotalStages(), #Config.Worlds, brainrots))
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="14">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">BrainrotService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- BrainrotService - buying, unlocking and wearing brainrots.
-- The equipped brainrot is welded onto the character as a costume (built with
-- BrainrotBuilder) and sets the humanoid's speed and jump. Perks that run on
-- the client (double jump, dash, glide) read the "Brainrot" player attribute.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BrainrotBuilder = require(Shared.BrainrotBuilder)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local GamepassService = require(script.Parent.GamepassService)
local RateLimiter = require(script.Parent.RateLimiter)

local BrainrotService = {}

local COSTUME_SCALE = 1.55
-- R15 parts hidden under the costume (legs stay visible so walking still reads).
local HIDDEN_PARTS = { Head = true, UpperTorso = true, LowerTorso = true, LeftUpperArm = true, LeftLowerArm = true, LeftHand = true, RightUpperArm = true, RightLowerArm = true, RightHand = true, Torso = true, ["Left Arm"] = true, ["Right Arm"] = true }

local function notify(player: Player, message: string, kind: string?)
	Remotes.Get("Notify"):FireClient(player, message, kind or "info")
end

--------------------------------------------------------------------------------
-- Costume
--------------------------------------------------------------------------------

local function hideBody(character: Model, hidden: boolean)
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("BasePart") and HIDDEN_PARTS[child.Name] then
			child.Transparency = if hidden then 1 else 0
			for _, decal in ipairs(child:GetChildren()) do
				if decal:IsA("Decal") then
					decal.Transparency = if hidden then 1 else 0
				end
			end
		elseif child:IsA("Accessory") then
			local handle = child:FindFirstChild("Handle")
			if handle and handle:IsA("BasePart") then
				handle.Transparency = if hidden then 1 else 0
			end
		end
	end
end

function BrainrotService.ApplyCostume(player: Player)
	local profile = DataService:GetProfile(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local root = character:FindFirstChild("HumanoidRootPart")
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not root or not root:IsA("BasePart") or not humanoid then
		return
	end
	local name = profile.Data.Equipped
	local def = Config.Brainrots[name]
	if not def then
		return
	end

	local old = character:FindFirstChild("Costume")
	if old then
		old:Destroy()
	end

	local ok, built = pcall(BrainrotBuilder.Build, name, { Effects = true, Weld = true, Scale = COSTUME_SCALE })
	if ok and built then
		local model = built.Model
		model.Name = "Costume"
		-- Feet of the costume just above the knees; it faces where the player faces.
		local bottom = root.CFrame * CFrame.new(0, -1.4, 0)
		model:PivotTo(bottom)
		built.Root.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = built.Root
		weld.Parent = built.Root
		for _, part in ipairs(model:GetDescendants()) do
			if part:IsA("BasePart") then
				part.CanCollide = false
				part.CanQuery = false
				part.CanTouch = false
				part.Massless = true
			end
		end
		model.Parent = character
		hideBody(character, true)
	end

	humanoid.UseJumpPower = true
	local speed = def.Speed
	if GamepassService.Owns(player, "SpeedBoost") then
		speed *= Config.Gamepasses.SpeedBoost.SpeedMultiplier
	end
	humanoid.WalkSpeed = speed
	humanoid.JumpPower = def.Jump
	player:SetAttribute("Brainrot", name)
	-- trail: the Rainbow Trail gamepass beats everything, else the equipped one
	if GamepassService.Owns(player, "RainbowTrail") then
		player:SetAttribute("Trail", "Rainbow")
	else
		player:SetAttribute("Trail", profile.Data.EquippedTrail or "None")
	end
end

--------------------------------------------------------------------------------
-- Owning and equipping
--------------------------------------------------------------------------------

function BrainrotService.Owns(player: Player, name: string): boolean
	local profile = DataService:GetProfile(player)
	return profile ~= nil and profile.Data.Owned[name] == true
end

-- Gives a brainrot (rewards, gamepasses, unlocks). Returns true if it was new.
function BrainrotService.Give(player: Player, name: string, quiet: boolean?): boolean
	local profile = DataService:GetProfile(player)
	if not profile or not Config.Brainrots[name] or profile.Data.Owned[name] then
		return false
	end
	profile.Data.Owned[name] = true
	DataService:Replicate(player, { Owned = profile.Data.Owned })
	if not quiet then
		notify(player, "New brainrot unlocked: " .. name .. "! Equip it in the BRAINROTS menu.", "reward")
	end
	return true
end

function BrainrotService.Equip(player: Player, name: string)
	local profile = DataService:GetProfile(player)
	if not profile or not profile.Data.Owned[name] then
		return
	end
	profile.Data.Equipped = name
	DataService:Replicate(player, { Equipped = name })
	EconomyService.RefreshMultiplier(player)
	BrainrotService.ApplyCostume(player)
end

function BrainrotService.Buy(player: Player, name: string)
	local profile = DataService:GetProfile(player)
	local def = Config.Brainrots[name]
	if not profile or not def then
		return
	end
	if profile.Data.Owned[name] then
		BrainrotService.Equip(player, name)
		return
	end
	local ok, reason = Config.CanUnlock(name, profile.Data)
	if not ok then
		notify(player, reason or "You can't unlock that yet.", "error")
		return
	end
	if def.Price > 0 and not EconomyService.SpendCoins(player, def.Price) then
		notify(player, "You need " .. Util.FormatNumber(def.Price - profile.Data.Coins) .. " more coins.", "error")
		return
	end
	BrainrotService.Give(player, name, true)
	notify(player, "You unlocked " .. name .. "!", "reward")
	BrainrotService.Equip(player, name)
end

-- Free unlocks earned by playing (stage / prestige / gamepass).
local function grantEarned(player: Player)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end
	local data = profile.Data
	for name, def in pairs(Config.Brainrots) do
		local unlock = def.Unlock
		if unlock and not data.Owned[name] then
			local earned = false
			if unlock.Stage and (data.Stats.BestStage or 1) >= unlock.Stage then
				earned = true
			elseif unlock.Prestige and data.Prestige >= unlock.Prestige then
				earned = true
			elseif unlock.Gamepass and GamepassService.Owns(player, unlock.Gamepass) then
				earned = true
			end
			if earned and def.Price == 0 then
				BrainrotService.Give(player, name)
			end
		end
	end
	-- the Legend Pack gamepass
	if GamepassService.Owns(player, "LegendPack") then
		for _, name in ipairs(Config.Gamepasses.LegendPack.Brainrots) do
			BrainrotService.Give(player, name)
		end
	end
end
BrainrotService.GrantEarned = grantEarned

--------------------------------------------------------------------------------
-- Trails (coin cosmetics)
--------------------------------------------------------------------------------

function BrainrotService.BuyTrail(player: Player, key: string)
	local profile = DataService:GetProfile(player)
	local def = Config.Trails[key]
	if not profile or not def then
		return
	end
	local data = profile.Data
	if not data.Trails[key] then
		if def.Price > 0 and not EconomyService.SpendCoins(player, def.Price) then
			notify(player, "You need " .. Util.FormatNumber(def.Price - data.Coins) .. " more coins for that trail.", "error")
			return
		end
		data.Trails[key] = true
		notify(player, "Unlocked the " .. def.Name .. " trail!", "reward")
	end
	data.EquippedTrail = key
	DataService:Replicate(player, { Trails = data.Trails, EquippedTrail = key })
	BrainrotService.ApplyCostume(player)
end

function BrainrotService.Init()
	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character)
			character:WaitForChild("HumanoidRootPart", 10)
			character:WaitForChild("Humanoid", 10)
			if DataService:GetProfile(player) then
				BrainrotService.ApplyCostume(player)
			end
		end)
	end
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)

	DataService.ProfileLoaded:Connect(function(player, profile)
		-- Heal bad saves (a brainrot removed from Config, nothing equipped).
		if not Config.Brainrots[profile.Data.Equipped] or not profile.Data.Owned[profile.Data.Equipped] then
			profile.Data.Owned[Config.StarterBrainrot] = true
			profile.Data.Equipped = Config.StarterBrainrot
		end
		grantEarned(player)
		if player.Character then
			BrainrotService.ApplyCostume(player)
		end
	end)
	GamepassService.Changed:Connect(function(player, passKey)
		grantEarned(player)
		if passKey == "SpeedBoost" or passKey == "RainbowTrail" then
			BrainrotService.ApplyCostume(player)
		end
	end)

	Remotes.Get("EquipBrainrot").OnServerEvent:Connect(function(player, name)
		if type(name) == "string" and RateLimiter.Allow(player, "Equip", 4, 1) then
			BrainrotService.Equip(player, name)
		end
	end)
	Remotes.Get("BuyBrainrot").OnServerEvent:Connect(function(player, name)
		if type(name) == "string" and RateLimiter.Allow(player, "Buy", 3, 1) then
			BrainrotService.Buy(player, name)
		end
	end)
	local function trailRequest(player, key)
		if type(key) == "string" and RateLimiter.Allow(player, "Trail", 3, 1) then
			BrainrotService.BuyTrail(player, key)
		end
	end
	Remotes.Get("BuyTrail").OnServerEvent:Connect(trailRequest)
	Remotes.Get("EquipTrail").OnServerEvent:Connect(trailRequest)
end

return BrainrotService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">CoinService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- CoinService - floating coins on the stages. Each coin can be taken once per
-- player every Config.Coins.RespawnSeconds; the client hides it locally and
-- the server validates distance and timing.
--------------------------------------------------------------------------------

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local RateLimiter = require(script.Parent.RateLimiter)

local CoinService = {}

local coins: { [string]: BasePart } = {}
local taken: { [Player]: { [string]: number } } = {} -- coinId -> os.clock() when taken

local function magnetRange(player: Player): number
	local profile = DataService:GetProfile(player)
	local def = profile and Config.Brainrots[profile.Data.Equipped]
	if def and def.Perk == "Magnet" then
		return def.Value
	end
	return 0
end

local function onCollect(player: Player, coinId: any)
	if type(coinId) ~= "string" then
		return
	end
	local coin = coins[coinId]
	local profile = DataService:GetProfile(player)
	if not coin or not profile then
		return
	end
	local record = taken[player]
	if not record then
		record = {}
		taken[player] = record
	end
	local now = os.clock()
	if record[coinId] and now - record[coinId] < Config.Coins.RespawnSeconds then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then
		return
	end
	if (root.Position - coin.Position).Magnitude > Config.Coins.MaxPickupDistance + magnetRange(player) then
		return
	end
	if not RateLimiter.Allow(player, "Coin", 10, 5) then
		return
	end
	record[coinId] = now
	local stage = coin:GetAttribute("Stage")
	local value = Config.GetCoinValue(if type(stage) == "number" then stage else 1)
	if coin:GetAttribute("Lucky") then
		value *= 10
	end
	local amount = EconomyService.AddCoins(player, value, true)
	profile.Data.Stats.CoinsCollected += 1
	Remotes.Get("CoinTaken"):FireClient(player, coinId, amount)
end

function CoinService.Init()
	for _, coin in ipairs(CollectionService:GetTagged("Coin")) do
		local id = coin:GetAttribute("CoinId")
		if type(id) == "string" and coin:IsA("BasePart") then
			coins[id] = coin
		end
	end
	Remotes.Get("CollectCoin").OnServerEvent:Connect(onCollect)
	Players.PlayerRemoving:Connect(function(player)
		taken[player] = nil
	end)
end

return CoinService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">CourseBuilder</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- CourseBuilder - generates the whole obby from Config (no uploaded assets):
-- a lobby, 100 stages of obstacles that get harder world by world, coins,
-- checkpoints, a finish portal, terrain, scenery and lighting.
--
-- The course is deterministic (Config.Course.Seed), so every server has the
-- same stages and saved checkpoint numbers always match.
--
-- Attributes other services and the client rely on:
--   Checkpoint trigger parts: "Stage" (number)      Finish trigger: "Finish" = true
--   Kill parts: "Kill" = true                        Coins: "CoinId", "Stage"
--   Jump pads: "Launch" (Vector3 velocity)          Movers: see MoverService
--   Stage models: "Stage", "FloorY" (lowest platform top, for fall respawns)
--------------------------------------------------------------------------------

local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local BrainrotBuilder = require(Shared.BrainrotBuilder)

local CourseDecor = require(script.Parent.CourseDecor)

local CourseBuilder = {}

local V = Vector3.new
local rgb = Color3.fromRGB
local Terrain = Workspace.Terrain

local PAD_SIZE = 12
local MAX_Z = 48 -- the course meanders inside this corridor

local checkpoints: { [number]: CFrame } = {}
local floorY: { [number]: number } = {}
local stageStartX: { [number]: number } = {}
local worldRange: { [number]: { Min: number, Max: number } } = {}
local leaderboardBoards: { [string]: Part } = {}
local courseFolder: Folder

CourseBuilder.Folders = {}

--------------------------------------------------------------------------------
-- Part helpers
--------------------------------------------------------------------------------

local function part(props: { [string]: any }, parent: Instance?): BasePart
	local p: BasePart
	if props.Wedge then
		p = Instance.new("WedgePart")
	elseif props.Truss then
		p = Instance.new("TrussPart")
	else
		p = Instance.new("Part")
	end
	p.Anchored = true
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "Wedge" and key ~= "Truss" then
			(p :: any)[key] = value
		end
	end
	p.Parent = parent
	return p
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * math.clamp(t, 0, 1)
end

-- Builder state for one stage.
type Ctx = {
	Model: Model,
	Theme: any,
	D: number, -- difficulty 0..1
	Rng: Random,
	Stage: number,
	Walkables: { BasePart }, -- platforms coins may sit on
	MinY: number,
}

local function walkable(c: Ctx, p: BasePart)
	table.insert(c.Walkables, p)
	c.MinY = math.min(c.MinY, p.Position.Y + p.Size.Y / 2)
end

-- Per-theme platform looks: a lighter top plate on a darker base, plus a
-- themed extra (neon underglow, a cloud puff, hanging vines, wooden posts).
local STYLES = {
	Meadow = { Top = rgb(130, 222, 95), Side = rgb(150, 105, 65), Extra = "Posts" },
	Beach = { Top = rgb(255, 234, 170), Side = rgb(205, 165, 110), Extra = "Posts" },
	Jungle = { Top = rgb(80, 175, 90), Side = rgb(95, 70, 50), Extra = "Vines" },
	City = { Top = rgb(150, 110, 90), Side = rgb(80, 62, 58), Extra = "Neon" },
	Sky = { Top = rgb(248, 250, 255), Side = rgb(175, 208, 255), Extra = "Cloud" },
	Void = { Top = rgb(110, 80, 200), Side = rgb(40, 26, 80), Extra = "Neon" },
}

local function platform(c: Ctx, cf: CFrame, size: Vector3, color: Color3?): BasePart
	local style = STYLES[c.Theme.Decor] or STYLES.Meadow
	local topColor = color or style.Top
	-- the walkable part is the whole slab; the plate and base are the look
	-- The slab is invisible and does the colliding; its look is made of child
	-- parts so moving / vanishing platforms carry their look with them.
	local p = part({ Name = "Platform", CFrame = cf, Size = size, Color = topColor, Transparency = 1 }, c.Model)
	p.CastShadow = false
	part({ Name = "Plate", CFrame = cf * CFrame.new(0, size.Y / 2 - 0.18, 0), Size = V(size.X, 0.36, size.Z), Color = topColor, CanCollide = false }, p)
	part({ Name = "Base", CFrame = cf * CFrame.new(0, -0.18, 0), Size = V(size.X + 0.3, size.Y - 0.36, size.Z + 0.3), Color = style.Side, CanCollide = false }, p)
	local extra = style.Extra
	if extra == "Neon" then
		part({ Name = "Glow", CFrame = cf * CFrame.new(0, -size.Y / 2 + 0.1, 0), Size = V(size.X + 0.9, 0.2, size.Z + 0.9), Color = c.Theme.Accent, Material = Enum.Material.Neon, Transparency = 0.2, CanCollide = false, CastShadow = false }, p)
	elseif extra == "Cloud" then
		part({ Name = "Puff", Shape = Enum.PartType.Ball, Size = V(1, 1, 1) * math.min(size.X, size.Z) * 0.9, CFrame = cf * CFrame.new(0, -size.Y / 2 - 0.6, 0), Color = Color3.new(1, 1, 1), CanCollide = false, CastShadow = false }, p)
	elseif extra == "Vines" and c.Rng:NextNumber() < 0.5 then
		part({ Name = "Vine", CFrame = cf * CFrame.new(size.X * 0.3, -size.Y / 2 - 1.6, size.Z * 0.35), Size = V(0.3, 3, 0.3), Color = rgb(95, 180, 80), CanCollide = false, CastShadow = false }, p)
	elseif extra == "Posts" and size.X >= 5 and size.Z >= 5 then
		for _, sx in ipairs({ -1, 1 }) do
			part({ Name = "Post", CFrame = cf * CFrame.new(sx * (size.X / 2 - 0.6), -size.Y / 2 - 1.2, size.Z / 2 - 0.6), Size = V(0.6, 2.4, 0.6), Color = style.Side, CanCollide = false, CastShadow = false }, p)
		end
	end
	walkable(c, p)
	return p
end

-- Slippery platform (ice / grease / glass)
local function icy(p: BasePart)
	p.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.02, 0.3)
	p:SetAttribute("Ice", true)
end

local function kill(c: Ctx, cf: CFrame, size: Vector3, name: string?): BasePart
	local p = part({
		Name = name or "Lava",
		CFrame = cf,
		Size = size,
		Color = c.Theme.Hazard,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CastShadow = false,
	}, c.Model)
	p:SetAttribute("Kill", true)
	CollectionService:AddTag(p, "Kill")
	return p
end

-- Hazard pool: a glowing slab with floating crust blobs, a light and bubbles.
local function lavaPool(c: Ctx, center: Vector3, size: Vector3)
	local pool = kill(c, CFrame.new(center), size, "LavaPool")
	pool.Transparency = 0.15
	local dark = c.Theme.Hazard:Lerp(Color3.new(0, 0, 0), 0.55)
	local blobs = math.clamp(math.floor(size.X * size.Z / 120), 2, 6)
	for i = 1, blobs do
		local bx = center.X + c.Rng:NextNumber(-size.X * 0.4, size.X * 0.4)
		local bz = center.Z + c.Rng:NextNumber(-size.Z * 0.4, size.Z * 0.4)
		local blob = part({ Name = "Crust", Size = V(c.Rng:NextNumber(2, 4), 0.4, c.Rng:NextNumber(2, 4)), CFrame = CFrame.new(bx, center.Y + 0.35, bz) * CFrame.Angles(0, c.Rng:NextNumber(0, 3), 0), Color = dark, CanCollide = false, CastShadow = false }, c.Model)
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = blob
	end
	local light = Instance.new("PointLight")
	light.Color = c.Theme.Hazard
	light.Range = math.clamp(size.X * 0.6, 10, 40)
	light.Brightness = 0.8
	light.Shadows = false
	light.Parent = pool
	local bubbles = Instance.new("ParticleEmitter")
	bubbles.Color = ColorSequence.new(c.Theme.Hazard:Lerp(Color3.new(1, 1, 1), 0.4))
	bubbles.LightEmission = 1
	bubbles.Rate = math.clamp(size.X * size.Z / 60, 2, 12)
	bubbles.Lifetime = NumberRange.new(0.8, 1.4)
	bubbles.Speed = NumberRange.new(2, 4)
	bubbles.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	bubbles.Parent = pool
end

-- A little flag on a pole (decor between sections).
local function flag(c: Ctx, position: Vector3)
	part({ Name = "FlagPole", Size = V(0.3, 5, 0.3), CFrame = CFrame.new(position + V(0, 2.5, 0)), Color = c.Theme.Trim, CanCollide = false, CastShadow = false }, c.Model)
	part({ Name = "Flag", Wedge = true, Size = V(0.15, 1.6, 2.4), CFrame = CFrame.new(position + V(0, 4.2, 1.2)) * CFrame.Angles(0, 0, math.rad(180)), Color = c.Theme.Accent, CanCollide = false, CastShadow = false }, c.Model)
end

-- A lamp post that lights the path at night-ish worlds.
local function lamp(c: Ctx, position: Vector3)
	part({ Name = "LampPost", Size = V(0.4, 7, 0.4), CFrame = CFrame.new(position + V(0, 3.5, 0)), Color = c.Theme.Trim, CanCollide = false, CastShadow = false }, c.Model)
	local bulb = part({ Name = "LampBulb", Shape = Enum.PartType.Ball, Size = V(1.3, 1.3, 1.3), CFrame = CFrame.new(position + V(0, 7.3, 0)), Color = c.Theme.Accent, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, c.Model)
	local light = Instance.new("PointLight")
	light.Color = c.Theme.Accent
	light.Range = 14
	light.Brightness = 1
	light.Shadows = false
	light.Parent = bulb
end

--------------------------------------------------------------------------------
-- Obstacle sections. Each takes the cursor (ground-level start point, x axis is
-- forward) and returns the cursor where the next section begins.
--------------------------------------------------------------------------------

local Sections = {}

-- Platforms with growing gaps.
Sections.Jumps = function(c: Ctx, cursor: Vector3): Vector3
	local count = c.Rng:NextInteger(3, 5)
	local size = lerp(8, 4.5, c.D)
	local gap = lerp(4, 9, c.D)
	local x = cursor.X
	local y = cursor.Y
	local z = cursor.Z
	for i = 1, count do
		x += gap + c.Rng:NextNumber(-0.5, 0.8) + size / 2
		y += c.Rng:NextNumber(-1, 1.5) * c.D
		z += c.Rng:NextNumber(-3, 3) * c.D
		platform(c, CFrame.new(x, y - 0.5, z), V(size, 1, size))
		x += size / 2
	end
	return V(x, y, z)
end

-- Stepping stones across a lava pool.
Sections.LavaSteps = function(c: Ctx, cursor: Vector3): Vector3
	local count = c.Rng:NextInteger(4, 7)
	local spacing = lerp(4.5, 7.5, c.D)
	local size = lerp(5, 2.8, c.D)
	local length = count * spacing + 8
	lavaPool(c, V(cursor.X + length / 2, cursor.Y - 4, cursor.Z), V(length + 6, 1, 26))
	local x, z = cursor.X + 4, cursor.Z
	for i = 1, count do
		x += spacing
		z += c.Rng:NextNumber(-4, 4) * (0.4 + c.D)
		platform(c, CFrame.new(x, cursor.Y - 0.5, z), V(size, 1, size))
	end
	return V(x + size / 2 + 2, cursor.Y, z)
end

-- Platforms that slide back and forth over a gap.
Sections.Movers = function(c: Ctx, cursor: Vector3): Vector3
	local count = c.Rng:NextInteger(2, 3)
	local span = lerp(14, 20, c.D)
	local size = lerp(7, 4.5, c.D)
	lavaPool(c, V(cursor.X + (span * count) / 2 + 4, cursor.Y - 5, cursor.Z), V(span * count + 10, 1, 30))
	local x = cursor.X + 2
	for i = 1, count do
		x += span
		local sideways = c.Rng:NextNumber() < 0.5
		local p = platform(c, CFrame.new(x - span / 2 + 2, cursor.Y - 0.5, cursor.Z), V(size, 1, size), c.Theme.Accent)
		p.Name = "MovingPlatform"
		p:SetAttribute("MoveKind", "Slide")
		p:SetAttribute("Carry", true)
		p:SetAttribute("MoveAxis", if sideways then V(0, 0, 1) else V(1, 0, 0))
		p:SetAttribute("MoveDistance", if sideways then lerp(6, 10, c.D) else span - size - 2)
		p:SetAttribute("MovePeriod", lerp(4.5, 2.6, c.D))
		p:SetAttribute("MovePhase", c.Rng:NextNumber(0, 1))
	end
	return V(x + 2, cursor.Y, cursor.Z)
end

-- A round arena with spinning kill bars.
Sections.Spinner = function(c: Ctx, cursor: Vector3): Vector3
	local radius = lerp(9, 11, c.D)
	local center = V(cursor.X + radius + 1, cursor.Y - 0.5, cursor.Z)
	local disc = part({ Name = "Arena", Shape = Enum.PartType.Cylinder, Size = V(1, radius * 2, radius * 2), CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Platform }, c.Model)
	walkable(c, disc)
	part({ Name = "Rim", Shape = Enum.PartType.Cylinder, Size = V(0.4, radius * 2 + 0.8, radius * 2 + 0.8), CFrame = CFrame.new(center - V(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Trim, CanCollide = false, CastShadow = false }, c.Model)
	local hub = part({ Name = "Hub", Shape = Enum.PartType.Cylinder, Size = V(3, 2.4, 2.4), CFrame = CFrame.new(center + V(0, 1.5, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Trim }, c.Model)
	hub.CanCollide = true
	local bars = if c.D > 0.6 then 2 else 1
	for i = 1, bars do
		local bar = kill(c, CFrame.new(center + V(0, 1.6, 0)) * CFrame.Angles(0, (i - 1) * math.pi / 2, 0), V(radius * 2 - 1, 1.6, 1.2), "SpinBar")
		bar.CanCollide = true
		bar:SetAttribute("MoveKind", "Spin")
		bar:SetAttribute("SpinSpeed", lerp(55, 140, c.D) * (if i == 2 then -1 else 1))
	end
	return V(center.X + radius, cursor.Y, cursor.Z)
end

-- Platforms that fade out on a timer.
Sections.Vanish = function(c: Ctx, cursor: Vector3): Vector3
	local count = c.Rng:NextInteger(5, 8)
	local size = lerp(6, 4, c.D)
	local spacing = size + lerp(2.5, 5, c.D)
	local x, z = cursor.X, cursor.Z
	for i = 1, count do
		x += spacing
		z += c.Rng:NextNumber(-2, 2) * c.D
		local p = platform(c, CFrame.new(x, cursor.Y - 0.5, z), V(size, 1, size), c.Theme.Accent)
		p.Name = "VanishPlatform"
		p:SetAttribute("MoveKind", "Vanish")
		p:SetAttribute("VanishPeriod", lerp(3.2, 2.2, c.D))
		p:SetAttribute("VanishPhase", (i % 2) * 0.5)
	end
	return V(x + size / 2 + 1, cursor.Y, z)
end

-- Conveyor belts over lava with blocks to dodge.
Sections.Conveyor = function(c: Ctx, cursor: Vector3): Vector3
	local length = lerp(22, 30, c.D)
	local width = 7
	local center = V(cursor.X + length / 2 + 2, cursor.Y - 0.5, cursor.Z)
	lavaPool(c, V(center.X, cursor.Y - 4, cursor.Z), V(length + 8, 1, 26))
	local backwards = c.Rng:NextNumber() < 0.6
	local belt = part({ Name = "Conveyor", CFrame = CFrame.new(center), Size = V(length, 1, width), Color = c.Theme.Trim }, c.Model)
	walkable(c, belt)
	local speed = lerp(8, 18, c.D)
	belt.AssemblyLinearVelocity = if backwards then V(-speed, 0, 0) else V(0, 0, (if c.Rng:NextNumber() < 0.5 then speed else -speed))
	belt:SetAttribute("Conveyor", true)
	-- arrows painted on the belt so the direction is obvious
	for x = -length / 2 + 3, length / 2 - 3, 4 do
		part({ Name = "Arrow", Wedge = true, Size = V(2, 0.1, 1.4), CFrame = CFrame.new(center + V(x, 0.55, 0)) * CFrame.Angles(0, if backwards then math.rad(-90) else 0, 0), Color = c.Theme.Accent, CanCollide = false, CastShadow = false }, c.Model)
	end
	local blocks = c.Rng:NextInteger(2, 4)
	for i = 1, blocks do
		local bx = center.X - length / 2 + (i / (blocks + 1)) * length
		local bz = cursor.Z + c.Rng:NextNumber(-width / 2 + 1, width / 2 - 1)
		local block = kill(c, CFrame.new(bx, cursor.Y + 1.2, bz), V(2, 2.4, 2), "KillBlock")
		block.CanCollide = true
		block.Material = Enum.Material.Neon
	end
	return V(center.X + length / 2 + 1, cursor.Y, cursor.Z)
end

-- A wall of ledges with truss ladders that gains a lot of height.
Sections.Climb = function(c: Ctx, cursor: Vector3): Vector3
	local steps = c.Rng:NextInteger(3, 4)
	local rise = lerp(4, 6, c.D)
	local x, y, z = cursor.X + 3, cursor.Y, cursor.Z
	for i = 1, steps do
		local ledge = platform(c, CFrame.new(x + 3, y - 0.5, z), V(7, 1, 7))
		if i < steps then
			-- a ladder leaning up to the next ledge
			part({ Name = "Ladder", Truss = true, Size = V(2, rise + 1, 2), CFrame = CFrame.new(x + 6.5, y + rise / 2, z + (if i % 2 == 0 then 2 else -2)), Color = c.Theme.Trim }, c.Model)
		end
		ledge.Size = V(7, 1, 7)
		x += 7
		y += rise
	end
	y -= rise
	platform(c, CFrame.new(x + 2, y - 0.5, z), V(6, 1, 8))
	return V(x + 5, y, z)
end

-- Narrow beams over lava.
Sections.Beams = function(c: Ctx, cursor: Vector3): Vector3
	local width = lerp(2.2, 0.9, c.D)
	local length = lerp(16, 24, c.D)
	lavaPool(c, V(cursor.X + length + 4, cursor.Y - 4, cursor.Z), V(length * 2 + 12, 1, 30))
	local x = cursor.X + 1
	local beam = part({ Name = "Beam", CFrame = CFrame.new(x + length / 2, cursor.Y - 0.5, cursor.Z), Size = V(length, 1, width), Color = c.Theme.Accent }, c.Model)
	walkable(c, beam)
	x += length
	local dz = (if c.Rng:NextNumber() < 0.5 then 1 else -1) * lerp(4, 8, c.D)
	-- a side step: second beam offset in Z, joined by a tiny landing
	local landing = platform(c, CFrame.new(x + 2, cursor.Y - 0.5, cursor.Z), V(3, 1, 3))
	landing.Name = "Landing"
	local beam2 = part({ Name = "Beam", CFrame = CFrame.new(x + 2, cursor.Y - 0.5, cursor.Z + dz / 2), Size = V(width, 1, math.abs(dz)), Color = c.Theme.Accent }, c.Model)
	walkable(c, beam2)
	local beam3 = part({ Name = "Beam", CFrame = CFrame.new(x + 2 + length * 0.6 / 2, cursor.Y - 0.5, cursor.Z + dz), Size = V(length * 0.6, 1, width), Color = c.Theme.Accent }, c.Model)
	walkable(c, beam3)
	return V(x + 2 + length * 0.6, cursor.Y, cursor.Z + dz)
end

-- A jump pad that launches you over a big gap.
Sections.Pads = function(c: Ctx, cursor: Vector3): Vector3
	local gap = lerp(18, 26, c.D)
	local launch = platform(c, CFrame.new(cursor.X + 4, cursor.Y - 0.5, cursor.Z), V(8, 1, 8))
	launch.Name = "LaunchPlatform"
	local pad = part({ Name = "JumpPad", Shape = Enum.PartType.Cylinder, Size = V(0.4, 5, 5), CFrame = CFrame.new(cursor.X + 5.5, cursor.Y + 0.2, cursor.Z) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Accent, Material = Enum.Material.Neon, CanCollide = false }, c.Model)
	-- Flight time with gravity 196.2: pick vertical speed for a nice arc, then
	-- horizontal speed to cover the gap.
	local up = 62
	local flight = 2 * up / Workspace.Gravity
	local forward = (gap + 4) / flight
	pad:SetAttribute("Launch", V(forward, up, 0))
	local glow = Instance.new("PointLight")
	glow.Color = c.Theme.Accent
	glow.Range = 8
	glow.Parent = pad
	lavaPool(c, V(cursor.X + 8 + gap / 2, cursor.Y - 6, cursor.Z), V(gap + 2, 1, 24))
	local landing = platform(c, CFrame.new(cursor.X + 8 + gap + 6, cursor.Y - 0.5, cursor.Z), V(12, 1, 12))
	landing.Name = "Landing"
	return V(cursor.X + 8 + gap + 12, cursor.Y, cursor.Z)
end

-- Tall pillars of different heights.
Sections.Pillars = function(c: Ctx, cursor: Vector3): Vector3
	local count = c.Rng:NextInteger(4, 7)
	local spacing = lerp(5, 7.5, c.D)
	local top = lerp(3.5, 2.2, c.D)
	local x, z = cursor.X, cursor.Z
	local y = cursor.Y
	for i = 1, count do
		x += spacing
		z += c.Rng:NextNumber(-2.5, 2.5)
		y = cursor.Y + c.Rng:NextNumber(-1, 3) * (0.5 + c.D)
		local height = 10 + (y - cursor.Y)
		local pillar = part({ Name = "Pillar", CFrame = CFrame.new(x, y - height / 2, z), Size = V(top, height, top), Color = c.Theme.Platform }, c.Model)
		walkable(c, pillar)
		part({ Name = "Cap", CFrame = CFrame.new(x, y + 0.05, z), Size = V(top + 0.4, 0.1, top + 0.4), Color = c.Theme.Accent, CanCollide = false, CastShadow = false }, c.Model)
	end
	return V(x + top / 2 + 1, y, z)
end

-- A corridor with walls sliding across it.
Sections.Walls = function(c: Ctx, cursor: Vector3): Vector3
	local length = lerp(22, 30, c.D)
	local width = 10
	local floor = platform(c, CFrame.new(cursor.X + length / 2 + 1, cursor.Y - 0.5, cursor.Z), V(length, 1, width))
	floor.Name = "Corridor"
	local count = c.Rng:NextInteger(2, 4)
	for i = 1, count do
		local x = cursor.X + 1 + (i / (count + 1)) * length
		local wall = kill(c, CFrame.new(x, cursor.Y + 2, cursor.Z - width / 2), V(1.2, 4, width * 0.55), "SlidingWall")
		wall.CanCollide = true
		wall:SetAttribute("MoveKind", "Slide")
		wall:SetAttribute("MoveAxis", V(0, 0, 1))
		wall:SetAttribute("MoveDistance", width)
		wall:SetAttribute("MovePeriod", lerp(3, 1.8, c.D))
		wall:SetAttribute("MovePhase", (i % 2) * 0.5 + c.Rng:NextNumber(0, 0.2))
	end
	return V(cursor.X + length + 1, cursor.Y, cursor.Z)
end

-- Swinging hammers over a bridge.
Sections.Pendulum = function(c: Ctx, cursor: Vector3): Vector3
	local length = lerp(22, 30, c.D)
	local bridge = platform(c, CFrame.new(cursor.X + length / 2 + 1, cursor.Y - 0.5, cursor.Z), V(length, 1, 6))
	bridge.Name = "Bridge"
	lavaPool(c, V(cursor.X + length / 2 + 1, cursor.Y - 5, cursor.Z), V(length + 6, 1, 26))
	local count = c.Rng:NextInteger(2, 3)
	for i = 1, count do
		local x = cursor.X + 1 + (i / (count + 1)) * length
		local pivot = V(x, cursor.Y + 10, cursor.Z)
		part({ Name = "PendulumFrame", Size = V(1, 1, 16), CFrame = CFrame.new(pivot), Color = c.Theme.Trim, CanCollide = false }, c.Model)
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "FramePost", Size = V(0.8, 11, 0.8), CFrame = CFrame.new(x, cursor.Y + 4.5, cursor.Z + side * 7.6), Color = c.Theme.Trim, CanCollide = false }, c.Model)
		end
		local arm = part({ Name = "PendulumArm", Size = V(0.5, 8, 0.5), CFrame = CFrame.new(pivot - V(0, 4, 0)), Color = c.Theme.Trim, CanCollide = false, CastShadow = false }, c.Model)
		local head = kill(c, CFrame.new(pivot - V(0, 8.5, 0)), V(3.2, 3.2, 3.2), "Hammer")
		head.Shape = Enum.PartType.Ball
		head.CanCollide = true
		for _, p in ipairs({ arm, head }) do
			p:SetAttribute("MoveKind", "Pendulum")
			p:SetAttribute("PendulumPivot", pivot)
			p:SetAttribute("PendulumAmp", math.rad(lerp(40, 70, c.D)))
			p:SetAttribute("PendulumPeriod", lerp(3.2, 2.2, c.D))
			p:SetAttribute("PendulumPhase", (i % 2) * 0.5)
		end
	end
	return V(cursor.X + length + 2, cursor.Y, cursor.Z)
end

-- A spinning disc you have to cross while it turns under you.
Sections.Turntable = function(c: Ctx, cursor: Vector3): Vector3
	local radius = lerp(7, 9, c.D)
	local center = V(cursor.X + radius + 4, cursor.Y - 0.5, cursor.Z)
	lavaPool(c, V(center.X, cursor.Y - 5, cursor.Z), V(radius * 2 + 14, 1, 30))
	local disc = part({ Name = "Turntable", Shape = Enum.PartType.Cylinder, Size = V(1, radius * 2, radius * 2), CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Accent }, c.Model)
	walkable(c, disc)
	disc:SetAttribute("MoveKind", "Turntable")
	disc:SetAttribute("Carry", true)
	disc:SetAttribute("SpinSpeed", lerp(25, 60, c.D) * (if c.Rng:NextNumber() < 0.5 then 1 else -1))
	-- stripes so the spin is visible
	for i = 0, 3 do
		part({ Name = "Stripe", Size = V(radius * 1.8, 0.1, 0.8), CFrame = CFrame.new(center + V(0, 0.55, 0)) * CFrame.Angles(0, i * math.pi / 4, 0), Color = c.Theme.Trim, CanCollide = false, CastShadow = false }, c.Model):SetAttribute("FollowTurntable", true)
	end
	if c.D > 0.5 then
		local post = kill(c, CFrame.new(center + V(0, 2, 0)), V(1.6, 3, 1.6), "SpinPost")
		post.CanCollide = true
		post:SetAttribute("MoveKind", "Spin")
		post:SetAttribute("SpinSpeed", disc:GetAttribute("SpinSpeed"))
		post:SetAttribute("SpinRadius", radius * 0.6)
	end
	return V(center.X + radius + 3, cursor.Y, cursor.Z)
end

-- Slippery ice slabs with gaps.
Sections.Ice = function(c: Ctx, cursor: Vector3): Vector3
	local count = c.Rng:NextInteger(3, 5)
	local length = lerp(9, 7, c.D)
	local gap = lerp(3, 6, c.D)
	local x, z = cursor.X, cursor.Z
	lavaPool(c, V(cursor.X + (length + gap) * count / 2 + 2, cursor.Y - 5, cursor.Z), V((length + gap) * count + 8, 1, 26))
	for i = 1, count do
		x += gap + length / 2
		z += c.Rng:NextNumber(-3, 3) * c.D
		local slab = platform(c, CFrame.new(x, cursor.Y - 0.5, z), V(length, 1, lerp(5, 3.5, c.D)), rgb(190, 235, 255))
		slab.Name = "IcePlatform"
		for _, child in ipairs(slab:GetChildren()) do
			if child:IsA("BasePart") then
				child.Material = Enum.Material.Glass
				child.Transparency = 0.15
				child.Reflectance = 0.2
			end
		end
		icy(slab)
		x += length / 2
	end
	return V(x + 1, cursor.Y, z)
end

-- A speed pad that fires you across a long flat gap.
Sections.SpeedPad = function(c: Ctx, cursor: Vector3): Vector3
	local gap = lerp(20, 30, c.D)
	local runway = platform(c, CFrame.new(cursor.X + 6, cursor.Y - 0.5, cursor.Z), V(12, 1, 7))
	runway.Name = "Runway"
	local pad = part({ Name = "SpeedPad", Size = V(4, 0.3, 5), CFrame = CFrame.new(cursor.X + 10, cursor.Y + 0.15, cursor.Z), Color = c.Theme.Accent, Material = Enum.Material.Neon, CanCollide = false }, c.Model)
	pad:SetAttribute("Launch", V(lerp(48, 58, c.D), 22, 0))
	for i = 0, 2 do
		part({ Name = "Arrow", Wedge = true, Size = V(1.4, 0.1, 1.2), CFrame = CFrame.new(cursor.X + 7 + i * 1.6, cursor.Y + 0.35, cursor.Z) * CFrame.Angles(0, math.rad(-90), 0), Color = Color3.new(1, 1, 1), CanCollide = false, CastShadow = false }, c.Model)
	end
	lavaPool(c, V(cursor.X + 12 + gap / 2, cursor.Y - 6, cursor.Z), V(gap + 2, 1, 24))
	local landing = platform(c, CFrame.new(cursor.X + 12 + gap + 7, cursor.Y - 0.5, cursor.Z), V(14, 1, 12))
	landing.Name = "Landing"
	return V(cursor.X + 12 + gap + 14, cursor.Y, cursor.Z)
end

-- A narrow corridor with a crosswind pushing you toward the edge.
Sections.Wind = function(c: Ctx, cursor: Vector3): Vector3
	local length = lerp(24, 32, c.D)
	local width = lerp(8, 5, c.D)
	local corridor = platform(c, CFrame.new(cursor.X + length / 2 + 1, cursor.Y - 0.5, cursor.Z), V(length, 1, width))
	corridor.Name = "WindCorridor"
	lavaPool(c, V(cursor.X + length / 2 + 1, cursor.Y - 5, cursor.Z), V(length + 6, 1, 28))
	local side = if c.Rng:NextNumber() < 0.5 then 1 else -1
	local zone = part({ Name = "WindZone", Size = V(length, 10, 24), CFrame = CFrame.new(cursor.X + length / 2 + 1, cursor.Y + 5, cursor.Z), Transparency = 1, CanCollide = false, CastShadow = false }, c.Model)
	zone.CanQuery = false
	zone:SetAttribute("Wind", V(0, 0, side * lerp(14, 26, c.D)))
	-- a fan at the windy side so players see where it comes from
	local fanX = cursor.X + length / 2 + 1
	part({ Name = "FanPole", Size = V(1, 6, 1), CFrame = CFrame.new(fanX, cursor.Y + 3, cursor.Z - side * 13), Color = c.Theme.Trim, CanCollide = false }, c.Model)
	local fan = part({ Name = "Fan", Shape = Enum.PartType.Cylinder, Size = V(0.6, 6, 6), CFrame = CFrame.new(fanX, cursor.Y + 6, cursor.Z - side * 13) * CFrame.Angles(0, math.rad(90), 0), Color = c.Theme.Accent, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, c.Model)
	fan:SetAttribute("MoveKind", "Spin")
	fan:SetAttribute("SpinSpeed", 240)
	fan:SetAttribute("SpinAxis", "X")
	local gust = Instance.new("ParticleEmitter")
	gust.Color = ColorSequence.new(Color3.new(1, 1, 1))
	gust.Transparency = NumberSequence.new(0.6)
	gust.Rate = 25
	gust.Lifetime = NumberRange.new(1, 1.6)
	gust.Speed = NumberRange.new(18, 24)
	gust.Size = NumberSequence.new(0.35)
	gust.EmissionDirection = if side > 0 then Enum.NormalId.Front else Enum.NormalId.Back
	gust.SpreadAngle = Vector2.new(8, 8)
	gust.Parent = fan
	return V(cursor.X + length + 2, cursor.Y, cursor.Z)
end

-- Laser beams that blink on and off across a corridor.
Sections.Lasers = function(c: Ctx, cursor: Vector3): Vector3
	local length = lerp(22, 30, c.D)
	local width = 8
	local corridor = platform(c, CFrame.new(cursor.X + length / 2 + 1, cursor.Y - 0.5, cursor.Z), V(length, 1, width))
	corridor.Name = "LaserCorridor"
	local count = c.Rng:NextInteger(3, 5)
	for i = 1, count do
		local x = cursor.X + 1 + (i / (count + 1)) * length
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "Emitter", Size = V(1, 4, 1), CFrame = CFrame.new(x, cursor.Y + 2, cursor.Z + side * (width / 2 + 0.5)), Color = c.Theme.Trim, CanCollide = false }, c.Model)
		end
		local beam = kill(c, CFrame.new(x, cursor.Y + 1.6, cursor.Z), V(0.5, 3, width + 1), "Laser")
		beam.Color = rgb(255, 40, 60)
		beam:SetAttribute("MoveKind", "Blink")
		beam:SetAttribute("BlinkPeriod", lerp(2.4, 1.6, c.D))
		beam:SetAttribute("BlinkPhase", (i % 2) * 0.5)
	end
	return V(cursor.X + length + 2, cursor.Y, cursor.Z)
end

-- Boulders rolling across a lane.
Sections.Rollers = function(c: Ctx, cursor: Vector3): Vector3
	local length = lerp(24, 32, c.D)
	local width = 10
	local lane = platform(c, CFrame.new(cursor.X + length / 2 + 1, cursor.Y - 0.5, cursor.Z), V(length, 1, width))
	lane.Name = "RollerLane"
	local count = c.Rng:NextInteger(2, 4)
	for i = 1, count do
		local x = cursor.X + 1 + (i / (count + 1)) * length
		local ball = kill(c, CFrame.new(x, cursor.Y + 1.6, cursor.Z - width / 2 - 2), V(3.4, 3.4, 3.4), "Boulder")
		ball.Shape = Enum.PartType.Ball
		ball.Material = Enum.Material.SmoothPlastic
		ball.Color = c.Theme.Hazard:Lerp(Color3.new(0, 0, 0), 0.3)
		ball.CanCollide = true
		ball:SetAttribute("MoveKind", "Slide")
		ball:SetAttribute("MoveAxis", V(0, 0, 1))
		ball:SetAttribute("MoveDistance", width + 4)
		ball:SetAttribute("MovePeriod", lerp(3.4, 2.2, c.D))
		ball:SetAttribute("MovePhase", (i / count) + c.Rng:NextNumber(0, 0.2))
		ball:SetAttribute("Roll", true)
	end
	return V(cursor.X + length + 2, cursor.Y, cursor.Z)
end

-- Which sections are allowed at a difficulty, with weights.
local SECTION_TABLE = {
	{ Name = "Jumps", Min = 0, Weight = 3 },
	{ Name = "LavaSteps", Min = 0.05, Weight = 3 },
	{ Name = "Pillars", Min = 0.12, Weight = 2 },
	{ Name = "Pads", Min = 0.15, Weight = 1.5 },
	{ Name = "Beams", Min = 0.2, Weight = 2 },
	{ Name = "Vanish", Min = 0.3, Weight = 2 },
	{ Name = "Movers", Min = 0.3, Weight = 2 },
	{ Name = "Climb", Min = 0.35, Weight = 1.5 },
	{ Name = "Conveyor", Min = 0.4, Weight = 2 },
	{ Name = "Spinner", Min = 0.45, Weight = 2 },
	{ Name = "Walls", Min = 0.55, Weight = 2 },
	{ Name = "SpeedPad", Min = 0.22, Weight = 1.5 },
	{ Name = "Ice", Min = 0.28, Weight = 2 },
	{ Name = "Turntable", Min = 0.38, Weight = 2 },
	{ Name = "Pendulum", Min = 0.42, Weight = 2 },
	{ Name = "Rollers", Min = 0.5, Weight = 2 },
	{ Name = "Wind", Min = 0.58, Weight = 1.5 },
	{ Name = "Lasers", Min = 0.62, Weight = 2 },
}

local function pickSection(c: Ctx, used: { [string]: boolean }): string
	local candidates, weights = {}, {}
	for _, entry in ipairs(SECTION_TABLE) do
		if c.D >= entry.Min and not used[entry.Name] then
			table.insert(candidates, entry.Name)
			table.insert(weights, entry.Weight)
		end
	end
	local total = 0
	for _, w in ipairs(weights) do
		total += w
	end
	local roll = c.Rng:NextNumber(0, total)
	for index, w in ipairs(weights) do
		roll -= w
		if roll <= 0 then
			return candidates[index]
		end
	end
	return candidates[#candidates] or "Jumps"
end

--------------------------------------------------------------------------------
-- Checkpoints, coins and the finish
--------------------------------------------------------------------------------

local function billboard(adornee: BasePart, title: string, subtitle: string?, color: Color3, offsetY: number, size: UDim2?)
	local gui = Instance.new("BillboardGui")
	gui.Name = "Label"
	gui.Size = size or UDim2.fromOffset(220, 80)
	gui.StudsOffset = V(0, offsetY, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Adornee = adornee
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.new(1, 0, 0.58, 0)
	titleLabel.Font = Enum.Font.LuckiestGuy
	titleLabel.Text = title
	titleLabel.TextColor3 = color
	titleLabel.TextScaled = true
	titleLabel.TextStrokeTransparency = 0
	titleLabel.TextStrokeColor3 = rgb(30, 22, 40)
	titleLabel.Parent = gui
	local sub = Instance.new("TextLabel")
	sub.Name = "Subtitle"
	sub.BackgroundTransparency = 1
	sub.Position = UDim2.new(0, 0, 0.58, 0)
	sub.Size = UDim2.new(1, 0, 0.42, 0)
	sub.Font = Enum.Font.FredokaOne
	sub.RichText = true
	sub.Text = subtitle or ""
	sub.TextColor3 = rgb(255, 245, 210)
	sub.TextScaled = true
	sub.TextStrokeTransparency = 0
	sub.TextStrokeColor3 = rgb(30, 22, 40)
	sub.Parent = gui
	gui.Parent = adornee
	return gui
end

local function buildCheckpoint(c: Ctx, cursor: Vector3, stage: number)
	local pad = platform(c, CFrame.new(cursor.X + PAD_SIZE / 2, cursor.Y - 0.5, cursor.Z), V(PAD_SIZE, 1, PAD_SIZE))
	pad.Name = "CheckpointPad"
	-- glowing ring + beacon
	local ring = part({ Name = "Ring", Shape = Enum.PartType.Cylinder, Size = V(0.2, 7, 7), CFrame = CFrame.new(pad.Position + V(0, 0.6, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Accent, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, c.Model)
	ring.Name = "CheckpointRing"
	part({ Name = "Inlay", Shape = Enum.PartType.Cylinder, Size = V(0.1, 9, 9), CFrame = CFrame.new(pad.Position + V(0, 0.52, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Trim, CanCollide = false, CastShadow = false }, c.Model)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			if not (sx == -1 and sz == -1) then
				flag(c, pad.Position + V(sx * (PAD_SIZE / 2 - 0.8), 0.5, sz * (PAD_SIZE / 2 - 0.8)))
			end
		end
	end
	local trigger = part({ Name = "Checkpoint", CFrame = CFrame.new(pad.Position + V(0, 4, 0)), Size = V(PAD_SIZE, 7, PAD_SIZE), Transparency = 1, CanCollide = false, CastShadow = false }, c.Model)
	trigger.CanQuery = false
	trigger:SetAttribute("Stage", stage)
	CollectionService:AddTag(trigger, "Checkpoint")
	local beacon = part({ Name = "Beacon", Size = V(0.6, 14, 0.6), CFrame = CFrame.new(pad.Position + V(0, 7.5, -PAD_SIZE / 2 + 0.8)), Color = c.Theme.Trim, CanCollide = false }, c.Model)
	local lamp = part({ Name = "Lamp", Shape = Enum.PartType.Ball, Size = V(2, 2, 2), CFrame = CFrame.new(beacon.Position + V(0, 7.5, 0)), Color = c.Theme.Accent, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, c.Model)
	local light = Instance.new("PointLight")
	light.Color = c.Theme.Accent
	light.Range = 18
	light.Brightness = 1.4
	light.Parent = lamp
	local world, inWorld = Config.GetWorld(stage)
	local worldIndex = Config.GetWorldForStage(stage)
	billboard(lamp, "STAGE " .. stage, if inWorld == 1 then world.Name else "", c.Theme.Accent, 3, UDim2.fromOffset(260, 90))
	if inWorld == 1 then
		-- a big arch announcing the world
		local archX = pad.Position.X - PAD_SIZE / 2 - 1
		for _, side in ipairs({ -1, 1 }) do
			part({ Name = "ArchPost", Size = V(2, 16, 2), CFrame = CFrame.new(archX, cursor.Y + 8, cursor.Z + side * 9), Color = c.Theme.Trim }, c.Model)
		end
		local top = part({ Name = "ArchTop", Size = V(2.4, 2.4, 20), CFrame = CFrame.new(archX, cursor.Y + 17, cursor.Z), Color = c.Theme.Accent, Material = Enum.Material.Neon }, c.Model)
		billboard(top, world.Name, "WORLD " .. worldIndex, c.Theme.Accent, 4, UDim2.fromOffset(420, 110))
	end
	checkpoints[stage] = CFrame.new(pad.Position + V(0, 3.5, 0))
	return V(cursor.X + PAD_SIZE, cursor.Y, cursor.Z)
end

local function placeCoins(c: Ctx)
	if #c.Walkables == 0 then
		return
	end
	local count = c.Rng:NextInteger(Config.Course.CoinsPerStage[1], Config.Course.CoinsPerStage[2])
	local folder = Instance.new("Folder")
	folder.Name = "Coins"
	folder.Parent = c.Model
	for i = 1, count do
		local base = c.Walkables[c.Rng:NextInteger(1, #c.Walkables)]
		local size = base.Size
		local offset = V(c.Rng:NextNumber(-size.X * 0.3, size.X * 0.3), 0, c.Rng:NextNumber(-size.Z * 0.3, size.Z * 0.3))
		if base.Shape == Enum.PartType.Cylinder then
			offset = V(0, 0, c.Rng:NextNumber(-size.Y * 0.3, size.Y * 0.3)) -- arena discs lie on their side
		end
		local coin = part({
			Name = "Coin",
			Shape = Enum.PartType.Cylinder,
			Size = V(0.4, 2.2, 2.2),
			CFrame = CFrame.new(base.Position + V(0, size.Y / 2, 0) + offset + V(0, 2.4, 0)) * CFrame.Angles(0, 0, math.rad(90)),
			Color = rgb(255, 205, 40),
			Material = Enum.Material.Neon,
			CanCollide = false,
			CanTouch = false,
			CanQuery = false,
			CastShadow = false,
		}, folder)
		coin:SetAttribute("CoinId", "S" .. c.Stage .. "_" .. i)
		coin:SetAttribute("Stage", c.Stage)
		CollectionService:AddTag(coin, "Coin")
	end
end

-- A small side platform off a random walkable, reachable with one jump.
local function sidePlatform(c: Ctx): BasePart?
	local candidates = {}
	for _, p in ipairs(c.Walkables) do
		if p.Size.X >= 5 and p.Shape ~= Enum.PartType.Cylinder then
			table.insert(candidates, p)
		end
	end
	if #candidates == 0 then
		return nil
	end
	local base = candidates[c.Rng:NextInteger(1, #candidates)]
	local side = if base.Position.Z > 0 then -1 else 1
	local position = base.Position + V(0, 0.5, side * (base.Size.Z / 2 + lerp(6, 8, c.D)))
	local p = platform(c, CFrame.new(position), V(4, 1, 4), c.Theme.Accent)
	p.Name = "SecretPlatform"
	return p
end

-- A glowing crystal shard: find them all for the secret brainrot.
local function placeFragment(c: Ctx, id: number)
	local base = sidePlatform(c)
	if not base then
		return
	end
	local shard = part({
		Name = "Fragment",
		Size = V(1.2, 2.4, 1.2),
		CFrame = CFrame.new(base.Position + V(0, 2.8, 0)) * CFrame.Angles(0, math.rad(45), 0),
		Color = rgb(190, 90, 255),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	}, c.Model)
	shard:SetAttribute("FragmentId", "F" .. id)
	shard:SetAttribute("Stage", c.Stage)
	CollectionService:AddTag(shard, "Fragment")
	local light = Instance.new("PointLight")
	light.Color = rgb(190, 90, 255)
	light.Range = 12
	light.Parent = shard
	local sparkle = Instance.new("ParticleEmitter")
	sparkle.Color = ColorSequence.new(rgb(230, 170, 255))
	sparkle.LightEmission = 1
	sparkle.Rate = 8
	sparkle.Lifetime = NumberRange.new(0.8, 1.4)
	sparkle.Speed = NumberRange.new(1, 2)
	sparkle.SpreadAngle = Vector2.new(180, 180)
	sparkle.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4), NumberSequenceKeypoint.new(1, 0) })
	sparkle.Parent = shard
end

-- A big coin worth 10 normal ones, hidden off the path.
local function placeLuckyCoin(c: Ctx)
	local base = sidePlatform(c)
	if not base then
		return
	end
	local coin = part({
		Name = "LuckyCoin",
		Shape = Enum.PartType.Cylinder,
		Size = V(0.7, 4.4, 4.4),
		CFrame = CFrame.new(base.Position + V(0, 3.4, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = rgb(255, 225, 90),
		Material = Enum.Material.Neon,
		CanCollide = false,
		CanTouch = false,
		CanQuery = false,
		CastShadow = false,
	}, c.Model)
	coin:SetAttribute("CoinId", "L" .. c.Stage)
	coin:SetAttribute("Stage", c.Stage)
	coin:SetAttribute("Lucky", true)
	CollectionService:AddTag(coin, "Coin")
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 225, 90)
	light.Range = 14
	light.Parent = coin
end

-- Boss arena: a wide disc with a giant brainrot statue, spinning bars and
-- swinging hammers. The last stage of every world.
local function buildBossArena(c: Ctx, cursor: Vector3, bossName: string): Vector3
	local radius = 17
	local center = V(cursor.X + radius + 6, cursor.Y - 0.5, cursor.Z)
	local entry = platform(c, CFrame.new(cursor.X + 3, cursor.Y - 0.5, cursor.Z), V(6, 1, 6))
	entry.Name = "Landing"
	lavaPool(c, V(center.X, cursor.Y - 6, cursor.Z), V(radius * 2 + 24, 1, radius * 2 + 20))
	local disc = part({ Name = "BossArena", Shape = Enum.PartType.Cylinder, Size = V(1, radius * 2, radius * 2), CFrame = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Platform }, c.Model)
	walkable(c, disc)
	part({ Name = "Rim", Shape = Enum.PartType.Cylinder, Size = V(0.5, radius * 2 + 1, radius * 2 + 1), CFrame = CFrame.new(center - V(0, 0.7, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Accent, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, c.Model)
	-- the boss on a pedestal in the middle
	local pedestal = part({ Name = "Pedestal", Shape = Enum.PartType.Cylinder, Size = V(3, 7, 7), CFrame = CFrame.new(center + V(0, 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = c.Theme.Trim }, c.Model)
	local ok, built = pcall(BrainrotBuilder.Build, bossName, { Effects = true, Weld = false, Scale = 3.2 })
	if ok and built then
		built.Model.Name = "Boss"
		built.Model:PivotTo(CFrame.new(center + V(0, 3.5, 0)) * CFrame.Angles(0, math.rad(90), 0))
		built.Model.Parent = c.Model
		billboard(pedestal, "BOSS: " .. string.upper(bossName), "Beat this stage for 4x coins!", c.Theme.Hazard, 18, UDim2.fromOffset(420, 110))
	end
	-- two spinning bars at different heights
	for i = 1, 2 do
		local bar = kill(c, CFrame.new(center + V(0, 1.6 + (i - 1) * 2.6, 0)) * CFrame.Angles(0, (i - 1) * math.pi / 2, 0), V(radius * 2 - 2, 1.4, 1.2), "SpinBar")
		bar.CanCollide = true
		bar:SetAttribute("MoveKind", "Spin")
		bar:SetAttribute("SpinSpeed", lerp(50, 110, c.D) * (if i == 2 then -1 else 1))
	end
	-- hammers guarding the exit
	for _, side in ipairs({ -1, 1 }) do
		local pivot = center + V(radius - 4, 10, side * 6)
		part({ Name = "FramePost", Size = V(0.8, 11, 0.8), CFrame = CFrame.new(pivot - V(0, 5.5, 0)) * CFrame.new(0, 0, side * 2.5), Color = c.Theme.Trim, CanCollide = false }, c.Model)
		local arm = part({ Name = "PendulumArm", Size = V(0.5, 7, 0.5), CFrame = CFrame.new(pivot - V(0, 3.5, 0)), Color = c.Theme.Trim, CanCollide = false, CastShadow = false }, c.Model)
		local head = kill(c, CFrame.new(pivot - V(0, 7.5, 0)), V(3, 3, 3), "Hammer")
		head.Shape = Enum.PartType.Ball
		head.CanCollide = true
		for _, p in ipairs({ arm, head }) do
			p:SetAttribute("MoveKind", "Pendulum")
			p:SetAttribute("PendulumPivot", pivot)
			p:SetAttribute("PendulumAmp", math.rad(55))
			p:SetAttribute("PendulumPeriod", 2.6)
			p:SetAttribute("PendulumPhase", if side > 0 then 0 else 0.5)
			p:SetAttribute("PendulumAxis", "X")
		end
	end
	local exit = platform(c, CFrame.new(center.X + radius + 4, cursor.Y - 0.5, cursor.Z), V(8, 1, 8))
	exit.Name = "Landing"
	return V(center.X + radius + 8, cursor.Y, cursor.Z)
end

local function buildFinish(c: Ctx, cursor: Vector3)
	local pad = platform(c, CFrame.new(cursor.X + 10, cursor.Y - 0.5, cursor.Z), V(20, 1, 20), rgb(255, 215, 80))
	pad.Name = "FinishPad"
	local purple = rgb(190, 90, 255)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Pillar", Size = V(2.5, 16, 2.5), CFrame = CFrame.new(cursor.X + 10, cursor.Y + 8, cursor.Z + side * 7.5), Color = rgb(60, 45, 95) }, c.Model)
	end
	local ring = part({ Name = "Portal", Shape = Enum.PartType.Cylinder, Size = V(1.5, 13, 13), CFrame = CFrame.new(cursor.X + 10, cursor.Y + 8.5, cursor.Z) * CFrame.Angles(0, 0, math.rad(0)), Color = purple, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, c.Model)
	local core = part({ Name = "Core", Shape = Enum.PartType.Cylinder, Size = V(0.6, 11, 11), CFrame = ring.CFrame, Color = rgb(255, 120, 255), Material = Enum.Material.ForceField, Transparency = 0.2, CanCollide = false, CastShadow = false }, c.Model)
	core.CanQuery = false
	local swirl = Instance.new("ParticleEmitter")
	swirl.Color = ColorSequence.new(rgb(255, 140, 255), rgb(140, 90, 255))
	swirl.LightEmission = 1
	swirl.Rate = 30
	swirl.Lifetime = NumberRange.new(1, 1.8)
	swirl.Speed = NumberRange.new(2, 4)
	swirl.SpreadAngle = Vector2.new(180, 180)
	swirl.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.6), NumberSequenceKeypoint.new(1, 0) })
	swirl.Parent = core
	local light = Instance.new("PointLight")
	light.Color = purple
	light.Range = 30
	light.Brightness = 2
	light.Parent = ring
	local trigger = part({ Name = "Finish", CFrame = CFrame.new(cursor.X + 10, cursor.Y + 6, cursor.Z), Size = V(6, 12, 12), Transparency = 1, CanCollide = false, CastShadow = false }, c.Model)
	trigger.CanQuery = false
	trigger:SetAttribute("Finish", true)
	CollectionService:AddTag(trigger, "Finish")
	billboard(ring, "FINISH!", "Walk through to PRESTIGE", purple, 9, UDim2.fromOffset(320, 100))
end

--------------------------------------------------------------------------------
-- Stages
--------------------------------------------------------------------------------

local function buildStage(stage: number, cursor: Vector3, parent: Instance): Vector3
	local world, worldIndex = Config.GetWorld(stage)
	local _, inWorld = Config.GetWorldForStage(stage)
	local isBoss = inWorld == world.Stages
	local rng = Random.new(Config.Course.Seed + stage * 7919)
	local model = Instance.new("Model")
	model.Name = "Stage" .. stage
	model:SetAttribute("Stage", stage)
	model:SetAttribute("World", worldIndex)

	local c: Ctx = {
		Model = model,
		Theme = world.Theme,
		D = Config.GetDifficulty(stage),
		Rng = rng,
		Stage = stage,
		Walkables = {},
		MinY = cursor.Y,
	}
	stageStartX[stage] = cursor.X

	local pos = buildCheckpoint(c, cursor, stage)
	if isBoss then
		model:SetAttribute("Boss", true)
		pos = buildBossArena(c, pos, world.Boss or "Sneaker Shark")
	else
		local length = rng:NextNumber(Config.Course.StageLengthMin, Config.Course.StageLengthMax)
		local targetX = cursor.X + length
		local used = {}
		local sections = 0
		while pos.X < targetX - 18 and sections < 3 do
			local name = pickSection(c, used)
			used[name] = true
			sections += 1
			pos = Sections[name](c, pos)
			-- a small landing between sections, with a lamp or flag
			if pos.X < targetX - 18 then
				local landing = platform(c, CFrame.new(pos.X + 3, pos.Y - 0.5, pos.Z), V(6, 1, 8))
				landing.Name = "Landing"
				if rng:NextNumber() < 0.5 then
					lamp(c, V(pos.X + 3, pos.Y, pos.Z + 3.6))
				else
					flag(c, V(pos.X + 3, pos.Y, pos.Z - 3.6))
				end
				pos = V(pos.X + 6, pos.Y, pos.Z)
			end
		end
	end
	-- secrets: a fragment every few stages, a lucky coin once per world
	local total = Config.TotalStages()
	local fragmentEvery = math.floor(total / Config.Fragments.Count)
	if stage % fragmentEvery == 3 and stage // fragmentEvery < Config.Fragments.Count then
		placeFragment(c, stage // fragmentEvery + 1)
	end
	if inWorld == math.floor(world.Stages / 2) then
		placeLuckyCoin(c)
	end
	-- keep the course rising gently and inside the corridor
	local nextY = pos.Y + Config.Course.RisePerStage
	local nextZ = math.clamp(pos.Z + rng:NextNumber(-10, 10), -MAX_Z, MAX_Z)
	-- a short ramp platform bridges any Y/Z change into the next checkpoint
	local bridge = platform(c, CFrame.new(pos.X + 4, (pos.Y + nextY) / 2 - 0.5, (pos.Z + nextZ) / 2), V(8, 1, 10))
	bridge.Name = "Bridge"
	bridge.CFrame = CFrame.lookAt(bridge.Position, V(pos.X + 8, nextY - 0.5, nextZ)) * CFrame.Angles(0, math.rad(-90), 0)
	placeCoins(c)
	model:SetAttribute("FloorY", c.MinY)
	floorY[stage] = c.MinY
	model.Parent = parent
	return V(pos.X + 8, nextY, nextZ)
end

--------------------------------------------------------------------------------
-- Lobby
--------------------------------------------------------------------------------

local function buildLeaderboard(parent: Instance, key: string, title: string, cf: CFrame)
	local board = part({ Name = key, Size = V(18, 12, 1), CFrame = cf, Color = rgb(30, 32, 45) }, parent) :: Part
	part({ Name = "Frame", Size = V(19, 13, 0.8), CFrame = cf * CFrame.new(0, 0, 0.2), Color = rgb(255, 200, 60) }, parent)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Post", Size = V(1.2, 16, 1.2), CFrame = cf * CFrame.new(side * 9.5, -2, 0.5), Color = rgb(110, 80, 55) }, parent)
	end
	local gui = Instance.new("SurfaceGui")
	gui.Name = "Board"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.ClipsDescendants = true
	gui.Adornee = board
	local titleLabel = Instance.new("TextLabel")
	titleLabel.Name = "Title"
	titleLabel.BackgroundTransparency = 1
	titleLabel.Size = UDim2.new(1, 0, 0, 80)
	titleLabel.Font = Enum.Font.LuckiestGuy
	titleLabel.Text = title
	titleLabel.TextColor3 = rgb(255, 210, 80)
	titleLabel.TextStrokeTransparency = 0
	titleLabel.TextScaled = true
	titleLabel.Parent = gui
	local list = Instance.new("Frame")
	list.Name = "Rows"
	list.BackgroundTransparency = 1
	list.Position = UDim2.new(0, 16, 0, 90)
	list.Size = UDim2.new(1, -32, 1, -100)
	list.Parent = gui
	local layout = Instance.new("UIListLayout")
	layout.Padding = UDim.new(0, 4)
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Parent = list
	local status = Instance.new("TextLabel")
	status.Name = "Status"
	status.BackgroundTransparency = 1
	status.Size = UDim2.new(1, 0, 0, 36)
	status.Font = Enum.Font.FredokaOne
	status.Text = "Loading..."
	status.TextColor3 = rgb(200, 200, 210)
	status.TextScaled = true
	status.Parent = list
	gui.Parent = board
	leaderboardBoards[key] = board
end

local function buildStatue(parent: Instance, name: string, cf: CFrame, label: string)
	local pedestal = part({ Name = "Pedestal", Shape = Enum.PartType.Cylinder, Size = V(1.5, 7, 7), CFrame = cf * CFrame.new(0, 0.75, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = rgb(235, 235, 245) }, parent)
	part({ Name = "PedestalTrim", Shape = Enum.PartType.Cylinder, Size = V(0.3, 7.4, 7.4), CFrame = cf * CFrame.new(0, 0.2, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = rgb(255, 205, 60), Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, parent)
	local ok, built = pcall(BrainrotBuilder.Build, name, { Effects = true, Weld = false, Scale = 1.8 })
	if ok and built then
		built.Model.Name = "Statue_" .. name
		built.Model:PivotTo(cf * CFrame.new(0, 1.5, 0) * CFrame.Angles(0, math.rad(180), 0))
		built.Model.Parent = parent
		billboard(pedestal, name, label, rgb(255, 230, 120), 9, UDim2.fromOffset(260, 80))
	end
end

local function buildLobby(parent: Instance, theme)
	local lobby = Instance.new("Model")
	lobby.Name = "Lobby"
	local length = Config.Course.LobbyLength
	local x0 = -length
	-- plaza floor
	part({ Name = "Floor", Size = V(length, 2, 90), CFrame = CFrame.new(x0 + length / 2, -1, 0), Color = theme.Platform }, lobby)
	part({ Name = "Path", Size = V(length, 0.2, 14), CFrame = CFrame.new(x0 + length / 2, 0.1, 0), Color = theme.Trim }, lobby)
	for _, side in ipairs({ -1, 1 }) do
		part({ Name = "Edge", Size = V(length, 1, 1.2), CFrame = CFrame.new(x0 + length / 2, 0.5, side * 45), Color = theme.Trim }, lobby)
	end

	-- spawn
	local spawn = Instance.new("SpawnLocation")
	spawn.Name = "Spawn"
	spawn.Anchored = true
	spawn.Size = V(12, 0.5, 12)
	spawn.CFrame = CFrame.new(x0 + 25, 0.25, 0)
	spawn.Color = rgb(255, 255, 255)
	spawn.Material = Enum.Material.SmoothPlastic
	spawn.Neutral = true
	spawn.Duration = 0
	spawn.TopSurface = Enum.SurfaceType.Smooth
	spawn.Parent = lobby
	part({ Name = "SpawnRing", Shape = Enum.PartType.Cylinder, Size = V(0.2, 9, 9), CFrame = CFrame.new(x0 + 25, 0.6, 0) * CFrame.Angles(0, 0, math.rad(90)), Color = theme.Accent, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, lobby)

	-- big title sign
	local signPost = part({ Name = "SignPost", Size = V(1.5, 20, 1.5), CFrame = CFrame.new(x0 + 25, 10, -30), Color = theme.Trim }, lobby)
	local signBoard = part({ Name = "TitleSign", Size = V(0.8, 8, 30), CFrame = CFrame.new(x0 + 25, 17, -30), Color = rgb(30, 22, 40) }, lobby)
	billboard(signBoard, "BRAINROT OBBY", "100 stages  -  6 worlds  -  collect every brainrot!", rgb(255, 215, 60), 0, UDim2.fromOffset(640, 150))
	signPost.CastShadow = false

	-- how-to sign near the path
	local howTo = part({ Name = "HowToSign", Size = V(0.5, 4, 10), CFrame = CFrame.new(x0 + 50, 4, -11), Color = rgb(150, 110, 70) }, lobby)
	billboard(howTo, "HOW TO PLAY", "Touch the glowing pads to save your spot.\nCollect coins. Buy brainrots that jump higher!", rgb(255, 240, 180), 2, UDim2.fromOffset(420, 120))
	for _, dz in ipairs({ -4, 4 }) do
		part({ Name = "Post", Size = V(0.6, 6, 0.6), CFrame = CFrame.new(x0 + 50, 3, -11 + dz), Color = rgb(120, 85, 55) }, lobby)
	end

	-- leaderboards at the back
	local boards = Instance.new("Folder")
	boards.Name = "Leaderboards"
	boards.Parent = lobby
	buildLeaderboard(boards, "BestStage", "TOP STAGES", CFrame.new(x0 + 6, 9, -22) * CFrame.Angles(0, math.rad(-90), 0))
	buildLeaderboard(boards, "Prestige", "TOP PRESTIGE", CFrame.new(x0 + 6, 9, 0) * CFrame.Angles(0, math.rad(-90), 0))
	buildLeaderboard(boards, "BestTime", "FASTEST RUNS", CFrame.new(x0 + 6, 9, 22) * CFrame.Angles(0, math.rad(-90), 0))

	-- brainrot statues to show off what you can unlock
	local statues = Instance.new("Folder")
	statues.Name = "Statues"
	statues.Parent = lobby
	buildStatue(statues, "Sneaker Shark", CFrame.new(x0 + 45, 0, 22), "Rare - 6,500 coins")
	buildStatue(statues, "Tralala Titan", CFrame.new(x0 + 62, 0, 30), "Legendary")
	buildStatue(statues, "Omega Brainrot", CFrame.new(x0 + 80, 0, 22), "Mythic - Prestige 1")
	buildStatue(statues, "Ballerina Latte", CFrame.new(x0 + 45, 0, -22), "Epic")
	buildStatue(statues, "Nuke Nonna", CFrame.new(x0 + 62, 0, -30), "Legendary")
	buildStatue(statues, "Galaxy Gnocchi", CFrame.new(x0 + 80, 0, -22), "Legendary")

	-- arrow on the floor pointing at stage 1
	for i = 0, 4 do
		part({ Name = "FloorArrow", Wedge = true, Size = V(4, 0.15, 3), CFrame = CFrame.new(x0 + 70 + i * 7, 0.25, 0) * CFrame.Angles(0, math.rad(-90), 0), Color = theme.Accent, Material = Enum.Material.Neon, CanCollide = false, CastShadow = false }, lobby)
	end

	lobby.Parent = parent
end

--------------------------------------------------------------------------------
-- Terrain, scenery and lighting
--------------------------------------------------------------------------------

local GROUND_DEPTH = 45

local function buildWorldScenery(parent: Instance, worldIndex: number)
	local world = Config.Worlds[worldIndex]
	local range = worldRange[worldIndex]
	local baseY = -GROUND_DEPTH + (Config.GetWorldStart(worldIndex) - 1) * Config.Course.RisePerStage
	local material = (Enum.Material :: any)[world.Theme.Ground] or Enum.Material.Grass
	local minX = if worldIndex == 1 then -Config.Course.LobbyLength - 150 else range.Min
	local maxX = if worldIndex == #Config.Worlds then range.Max + 150 else range.Max
	local center = V((minX + maxX) / 2, baseY - 10, 0)
	if world.Theme.Decor ~= "Void" and world.Theme.Decor ~= "Sky" then
		Terrain:FillBlock(CFrame.new(center), V(maxX - minX, 20, 520), material)
	end
	if world.Theme.Decor == "Beach" then
		Terrain:FillBlock(CFrame.new(center + V(0, 4, 0)), V(maxX - minX, 6, 520), Enum.Material.Water)
		Terrain:FillBlock(CFrame.new(center + V(0, 4, 0)), V(maxX - minX, 7, 120), material)
	end
	local rng = Random.new(Config.Course.Seed + worldIndex * 104729)
	CourseDecor.Fill(world.Theme.Decor, parent, minX, maxX, baseY, rng)
	CourseDecor.Backdrop(world.Theme.Decor, parent, minX, maxX, baseY, rng)
end

local function setupLighting()
	for _, child in ipairs(Lighting:GetChildren()) do
		if child:IsA("PostEffect") or child:IsA("Atmosphere") or child:IsA("Sky") then
			child:Destroy()
		end
	end
	local sky = Instance.new("Sky")
	sky.StarCount = 2500
	sky.CelestialBodiesShown = true
	sky.Parent = Lighting
	local atmosphere = Instance.new("Atmosphere")
	atmosphere.Density = 0.25
	atmosphere.Offset = 0.2
	atmosphere.Color = rgb(205, 222, 245)
	atmosphere.Decay = rgb(120, 140, 170)
	atmosphere.Glare = 0.2
	atmosphere.Haze = 0.8
	atmosphere.Parent = Lighting
	local bloom = Instance.new("BloomEffect")
	bloom.Intensity = 0.8
	bloom.Size = 24
	bloom.Threshold = 1.1
	bloom.Parent = Lighting
	local color = Instance.new("ColorCorrectionEffect")
	color.Name = "WorldColor"
	color.Saturation = 0.28
	color.Contrast = 0.1
	color.Brightness = 0.02
	color.Parent = Lighting
	local rays = Instance.new("SunRaysEffect")
	rays.Intensity = 0.08
	rays.Spread = 0.7
	rays.Parent = Lighting
	Lighting.ClockTime = 14
	Lighting.Brightness = 3
	Terrain:SetMaterialColor(Enum.Material.Grass, rgb(112, 202, 72))
	Terrain:SetMaterialColor(Enum.Material.LeafyGrass, rgb(70, 150, 60))
	Terrain:SetMaterialColor(Enum.Material.Sand, rgb(248, 225, 160))
	Terrain:SetMaterialColor(Enum.Material.Concrete, rgb(150, 130, 125))
	Terrain:SetMaterialColor(Enum.Material.Snow, rgb(240, 246, 255))
	Terrain:SetMaterialColor(Enum.Material.Basalt, rgb(45, 30, 70))
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

function CourseBuilder.Build()
	for _, name in ipairs({ "Course", "Baseplate", "SpawnLocation" }) do
		local existing = Workspace:FindFirstChild(name)
		if existing then
			existing:Destroy()
		end
	end
	Terrain:Clear()

	courseFolder = Instance.new("Folder")
	courseFolder.Name = "Course"
	local stages = Instance.new("Folder")
	stages.Name = "Stages"
	stages.Parent = courseFolder

	buildLobby(courseFolder, Config.Worlds[1].Theme)

	local cursor = V(0, 0, 0)
	local total = Config.TotalStages()
	for stage = 1, total do
		local worldIndex = Config.GetWorldForStage(stage)
		local range = worldRange[worldIndex] or { Min = cursor.X, Max = cursor.X }
		range.Min = math.min(range.Min, cursor.X)
		cursor = buildStage(stage, cursor, stages)
		range.Max = cursor.X
		worldRange[worldIndex] = range
	end
	-- finish after the last stage
	local lastWorld = Config.Worlds[#Config.Worlds]
	local finishModel = Instance.new("Model")
	finishModel.Name = "Finish"
	local fc: Ctx = { Model = finishModel, Theme = lastWorld.Theme, D = 1, Rng = Random.new(1), Stage = total + 1, Walkables = {}, MinY = cursor.Y }
	buildFinish(fc, cursor)
	finishModel.Parent = courseFolder
	checkpoints[total + 1] = CFrame.new(cursor.X + 10, cursor.Y + 3.5, cursor.Z)
	floorY[total + 1] = cursor.Y

	for worldIndex in ipairs(Config.Worlds) do
		courseFolder:SetAttribute("World" .. worldIndex .. "StartX", stageStartX[Config.GetWorldStart(worldIndex)])
	end
	courseFolder:SetAttribute("CourseEndX", cursor.X + 30)

	local scenery = Instance.new("Folder")
	scenery.Name = "Scenery"
	scenery.Parent = courseFolder
	for worldIndex in ipairs(Config.Worlds) do
		buildWorldScenery(scenery, worldIndex)
	end

	courseFolder.Parent = Workspace
	CourseBuilder.Folders.Course = courseFolder
	CourseBuilder.Folders.Stages = stages
	setupLighting()
end

-- Where a player respawns for a checkpoint (above the pad).
function CourseBuilder.GetCheckpoint(stage: number): CFrame?
	return checkpoints[stage]
end

-- Lowest platform top of a stage (fall detection).
function CourseBuilder.GetFloorY(stage: number): number
	return floorY[stage] or 0
end

function CourseBuilder.GetStageStartX(stage: number): number
	return stageStartX[stage] or 0
end

function CourseBuilder.GetLeaderboardBoards(): { [string]: Part }
	return leaderboardBoards
end

return CourseBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">CourseDecor</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- CourseDecor - themed scenery around each world, built from parts.
-- CourseDecor.Fill(theme, parent, minX, maxX, groundY, rng)
-- Props stand on the ground far below the course (so the obby feels high up)
-- and a few float near the path (clouds, planets).
--------------------------------------------------------------------------------

local CourseDecor = {}

local V = Vector3.new
local rgb = Color3.fromRGB

local function part(props: { [string]: any }, parent: Instance): BasePart
	local p: BasePart
	if props.Wedge then
		p = Instance.new("WedgePart")
	else
		p = Instance.new("Part")
	end
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Material = Enum.Material.SmoothPlastic
	for key, value in pairs(props) do
		if key ~= "Wedge" and key ~= "Sphere" then
			(p :: any)[key] = value
		end
	end
	if props.Sphere then
		local mesh = Instance.new("SpecialMesh")
		mesh.MeshType = Enum.MeshType.Sphere
		mesh.Parent = p
	end
	p.Parent = parent
	return p
end

local function pillar(parent: Instance, base: Vector3, height: number, radius: number, color: Color3)
	return part({ Shape = Enum.PartType.Cylinder, Size = V(height, radius * 2, radius * 2), CFrame = CFrame.new(base + V(0, height / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), Color = color }, parent)
end

local function ball(parent: Instance, center: Vector3, size: number, color: Color3, material: Enum.Material?)
	return part({ Shape = Enum.PartType.Ball, Size = V(size, size, size), Position = center, Color = color, Material = material or Enum.Material.SmoothPlastic }, parent)
end

local function pick<T>(list: { T }, rng: Random): T
	return list[rng:NextInteger(1, #list)]
end

--------------------------------------------------------------------------------
-- Props per theme (position = ground point)
--------------------------------------------------------------------------------

local GREENS = { rgb(80, 175, 60), rgb(110, 200, 75), rgb(60, 150, 55) }
local FLOWERS = { rgb(255, 120, 170), rgb(255, 225, 80), rgb(185, 130, 255), rgb(255, 255, 255) }

local function tree(parent, pos, rng)
	local h = rng:NextNumber(9, 14)
	pillar(parent, pos, h, rng:NextNumber(0.9, 1.3), rgb(125, 85, 55))
	local green = pick(GREENS, rng)
	local crown = rng:NextNumber(9, 13)
	ball(parent, pos + V(0, h + 1, 0), crown, green)
	ball(parent, pos + V(-1, h + 1 + crown * 0.28, -1), crown * 0.62, green:Lerp(rgb(235, 255, 160), 0.35))
end

local function flowers(parent, pos, rng)
	for _ = 1, rng:NextInteger(5, 9) do
		local p = pos + V(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4))
		pillar(parent, p, 1.4, 0.1, rgb(70, 150, 50))
		ball(parent, p + V(0, 1.6, 0), rng:NextNumber(0.7, 1), pick(FLOWERS, rng))
	end
end

local function palm(parent, pos, rng)
	local h = rng:NextNumber(12, 18)
	local lean = rng:NextNumber(-0.15, 0.15)
	for i = 0, 5 do
		local y = i * (h / 6)
		pillar(parent, pos + V(lean * y, y, 0), h / 6 + 0.1, 0.8 - i * 0.05, rgb(160, 120, 70))
	end
	local top = pos + V(lean * h, h, 0)
	for i = 1, 6 do
		local angle = i * (math.pi * 2 / 6)
		part({ Size = V(1.2, 0.3, 7), CFrame = CFrame.new(top + V(math.cos(angle) * 3.2, 0.5, math.sin(angle) * 3.2)) * CFrame.Angles(0, -angle + math.pi / 2, 0) * CFrame.Angles(math.rad(-25), 0, 0), Color = rgb(70, 170, 70) }, parent)
	end
	ball(parent, top + V(0.6, -0.8, 0.4), 1.1, rgb(140, 95, 50))
end

local function umbrella(parent, pos, rng)
	pillar(parent, pos, 7, 0.15, rgb(240, 240, 240))
	local color = pick({ rgb(255, 90, 90), rgb(90, 160, 255), rgb(255, 210, 60) }, rng)
	part({ Sphere = true, Size = V(8, 2.6, 8), Position = pos + V(0, 7, 0), Color = color }, parent)
	part({ Size = V(4, 0.5, 2.5), Position = pos + V(3, 0.3, 2), Color = rgb(255, 255, 255) }, parent)
end

local function jungleTree(parent, pos, rng)
	local h = rng:NextNumber(18, 28)
	pillar(parent, pos, h, rng:NextNumber(1.2, 1.8), rgb(95, 65, 45))
	for i = 1, 3 do
		local angle = i * 2.1
		ball(parent, pos + V(math.cos(angle) * 4, h - i * 2, math.sin(angle) * 4), rng:NextNumber(9, 13), rgb(40, 130, 60))
	end
	ball(parent, pos + V(0, h + 3, 0), 12, rgb(60, 160, 70))
	-- hanging vine
	part({ Size = V(0.3, h * 0.5, 0.3), Position = pos + V(5, h * 0.6, 2), Color = rgb(90, 170, 80) }, parent)
end

local function bamboo(parent, pos, rng)
	for _ = 1, rng:NextInteger(3, 6) do
		local p = pos + V(rng:NextNumber(-3, 3), 0, rng:NextNumber(-3, 3))
		local h = rng:NextNumber(10, 16)
		for i = 0, math.floor(h / 3) do
			pillar(parent, p + V(0, i * 3, 0), 2.8, 0.35, rgb(150, 200, 90))
		end
	end
end

local function building(parent, pos, rng)
	local w = rng:NextNumber(10, 18)
	local d = rng:NextNumber(10, 18)
	local h = rng:NextNumber(20, 55)
	local color = pick({ rgb(120, 90, 75), rgb(230, 210, 190), rgb(90, 80, 95), rgb(190, 150, 120) }, rng)
	part({ Size = V(w, h, d), Position = pos + V(0, h / 2, 0), Color = color, CastShadow = true }, parent)
	-- neon windows
	local neon = pick({ rgb(255, 230, 120), rgb(120, 220, 255), rgb(255, 120, 200) }, rng)
	for y = 4, h - 4, 5 do
		for x = -w / 2 + 2.5, w / 2 - 2.5, 4 do
			if rng:NextNumber() < 0.6 then
				part({ Size = V(1.8, 2.4, 0.2), Position = pos + V(x, y, -d / 2 - 0.1), Color = neon, Material = Enum.Material.Neon }, parent)
			end
		end
	end
	-- rooftop sign
	if rng:NextNumber() < 0.4 then
		part({ Size = V(w * 0.6, 3, 0.5), Position = pos + V(0, h + 2, 0), Color = neon, Material = Enum.Material.Neon }, parent)
	end
end

local function streetLamp(parent, pos, _rng)
	pillar(parent, pos, 10, 0.3, rgb(60, 60, 70))
	local lamp = ball(parent, pos + V(0, 10.6, 0), 1.6, rgb(255, 230, 160), Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = rgb(255, 220, 160)
	light.Range = 18
	light.Parent = lamp
end

local function cloud(parent, pos, rng)
	local width = rng:NextNumber(18, 36)
	for j = 1, rng:NextInteger(4, 6) do
		local t = (j - 1) / 5 - 0.5
		local size = rng:NextNumber(9, 15) * (1 - math.abs(t) * 0.7)
		ball(parent, pos + V(t * width, rng:NextNumber(-1, 2), rng:NextNumber(-4, 4)), size, rgb(255, 255, 255))
	end
end

local function skyIsland(parent, pos, rng)
	local size = rng:NextNumber(14, 26)
	part({ Sphere = true, Size = V(size, size * 0.6, size), Position = pos, Color = rgb(120, 90, 70) }, parent)
	part({ Sphere = true, Size = V(size * 1.05, size * 0.2, size * 1.05), Position = pos + V(0, size * 0.2, 0), Color = rgb(110, 200, 90) }, parent)
	if rng:NextNumber() < 0.6 then
		tree(parent, pos + V(0, size * 0.28, 0), rng)
	end
end

local function asteroid(parent, pos, rng)
	local size = rng:NextNumber(5, 14)
	part({ Size = V(size, size * rng:NextNumber(0.6, 1.1), size * rng:NextNumber(0.6, 1.1)), CFrame = CFrame.new(pos) * CFrame.Angles(rng:NextNumber(0, 3), rng:NextNumber(0, 3), rng:NextNumber(0, 3)), Color = rgb(85, 70, 120) }, parent)
	if rng:NextNumber() < 0.5 then
		part({ Size = V(1.2, 2.4, 1.2), CFrame = CFrame.new(pos + V(0, size * 0.5, 0)) * CFrame.Angles(0, rng:NextNumber(0, 3), 0), Color = rgb(150, 255, 230), Material = Enum.Material.Neon }, parent)
	end
end

local function planet(parent, pos, rng)
	local size = rng:NextNumber(30, 60)
	local color = pick({ rgb(255, 150, 90), rgb(120, 180, 255), rgb(200, 120, 255), rgb(120, 255, 180) }, rng)
	local body = ball(parent, pos, size, color)
	if rng:NextNumber() < 0.6 then
		part({ Shape = Enum.PartType.Cylinder, Size = V(0.8, size * 1.9, size * 1.9), CFrame = CFrame.new(pos) * CFrame.Angles(0, 0, math.rad(90)) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), 0, 0), Color = color:Lerp(Color3.new(1, 1, 1), 0.5), Transparency = 0.3 }, parent)
	end
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = size * 2
	light.Brightness = 0.6
	light.Parent = body
end

--------------------------------------------------------------------------------

local THEMES = {
	Meadow = { Ground = { tree, tree, flowers, flowers }, Density = 1 / 22 },
	Beach = { Ground = { palm, palm, umbrella }, Density = 1 / 26 },
	Jungle = { Ground = { jungleTree, jungleTree, bamboo }, Density = 1 / 20 },
	City = { Ground = { building, building, streetLamp }, Density = 1 / 24 },
	Sky = { Float = { cloud, cloud, skyIsland }, Density = 1 / 18 },
	Void = { Float = { asteroid, asteroid, asteroid, planet }, Density = 1 / 20 },
}

function CourseDecor.Fill(themeName: string, parent: Instance, minX: number, maxX: number, groundY: number, rng: Random)
	local theme = THEMES[themeName] or THEMES.Meadow
	local folder = Instance.new("Folder")
	folder.Name = themeName
	folder.Parent = parent
	local count = math.floor((maxX - minX) * theme.Density) * 2
	for _ = 1, count do
		local x = rng:NextNumber(minX, maxX)
		local side = if rng:NextNumber() < 0.5 then -1 else 1
		if theme.Ground then
			-- out past the course corridor, on the ground below
			local z = side * rng:NextNumber(70, 220)
			pick(theme.Ground, rng)(folder, V(x, groundY, z), rng)
		else
			-- floating around path height
			local z = side * rng:NextNumber(65, 200)
			local y = groundY + 45 + rng:NextNumber(-30, 40) + (x - minX) * 0.02
			pick(theme.Float, rng)(folder, V(x, y, z), rng)
		end
	end
	-- a few props close to the path on the ground (visible when looking down)
	if theme.Ground then
		for _ = 1, math.floor(count / 3) do
			local x = rng:NextNumber(minX, maxX)
			local z = rng:NextNumber(-60, 60)
			pick(theme.Ground, rng)(folder, V(x, groundY, z), rng)
		end
	end
end

--------------------------------------------------------------------------------
-- Backdrops: the big things on the horizon that give each world its skyline.
--------------------------------------------------------------------------------

local function mountains(folder, minX, maxX, groundY, rng, colors)
	for x = minX, maxX, 90 do
		for _, side in ipairs({ -1, 1 }) do
			local w = rng:NextNumber(90, 160)
			local h = rng:NextNumber(60, 130)
			part({ Sphere = true, Size = V(w, h, w * 0.8), Position = V(x + rng:NextNumber(-30, 30), groundY + h * 0.2, side * rng:NextNumber(260, 340)), Color = pick(colors, rng) }, folder)
		end
	end
end

local function skyline(folder, minX, maxX, groundY, rng)
	for x = minX, maxX, 22 do
		for _, side in ipairs({ -1, 1 }) do
			local w = rng:NextNumber(14, 22)
			local h = rng:NextNumber(50, 120)
			local z = side * rng:NextNumber(240, 300)
			part({ Size = V(w, h, 18), Position = V(x, groundY + h / 2, z), Color = pick({ rgb(60, 50, 70), rgb(80, 60, 75), rgb(50, 45, 65) }, rng) }, folder)
			for y = 6, h - 6, 7 do
				if rng:NextNumber() < 0.5 then
					part({ Size = V(w * 0.7, 2.2, 0.3), Position = V(x, groundY + y, z - side * 9.2), Color = pick({ rgb(255, 225, 120), rgb(120, 210, 255), rgb(255, 120, 200) }, rng), Material = Enum.Material.Neon }, folder)
				end
			end
		end
	end
end

local function sun(folder, x, y, z, color)
	local body = ball(folder, V(x, y, z), 70, color, Enum.Material.Neon)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 200
	light.Brightness = 0.4
	light.Parent = body
end

function CourseDecor.Backdrop(themeName: string, parent: Instance, minX: number, maxX: number, groundY: number, rng: Random)
	local folder = Instance.new("Folder")
	folder.Name = themeName .. "Backdrop"
	folder.Parent = parent
	if themeName == "Meadow" then
		mountains(folder, minX, maxX, groundY, rng, { rgb(90, 180, 80), rgb(70, 150, 75), rgb(110, 195, 90) })
	elseif themeName == "Beach" then
		mountains(folder, minX, maxX, groundY - 10, rng, { rgb(230, 200, 150), rgb(210, 180, 130) })
		sun(folder, (minX + maxX) / 2, groundY + 260, 480, rgb(255, 230, 150))
	elseif themeName == "Jungle" then
		mountains(folder, minX, maxX, groundY, rng, { rgb(40, 110, 60), rgb(55, 130, 70) })
		-- giant trees towering over the course
		for x = minX, maxX, 120 do
			for _, side in ipairs({ -1, 1 }) do
				local z = side * rng:NextNumber(150, 220)
				pillar(folder, V(x, groundY, z), 120, 6, rgb(90, 60, 45))
				ball(folder, V(x, groundY + 125, z), 70, rgb(45, 140, 65))
			end
		end
	elseif themeName == "City" then
		skyline(folder, minX, maxX, groundY, rng)
		sun(folder, (minX + maxX) / 2, groundY + 120, 520, rgb(255, 150, 90))
	elseif themeName == "Sky" then
		for x = minX, maxX, 70 do
			for _, side in ipairs({ -1, 1 }) do
				cloud(folder, V(x + rng:NextNumber(-20, 20), groundY + 60 + rng:NextNumber(-20, 50) + (x - minX) * 0.02, side * rng:NextNumber(230, 330)), rng)
			end
		end
		sun(folder, (minX + maxX) / 2, groundY + 330, -420, rgb(255, 245, 200))
	elseif themeName == "Void" then
		for _ = 1, 4 do
			planet(folder, V(rng:NextNumber(minX, maxX), groundY + rng:NextNumber(120, 260), (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(260, 420)), rng)
		end
		-- a nebula of big soft blobs
		for _ = 1, 10 do
			part({ Sphere = true, Size = V(1, 1, 1) * rng:NextNumber(60, 140), Position = V(rng:NextNumber(minX, maxX), groundY + rng:NextNumber(0, 300), (if rng:NextNumber() < 0.5 then -1 else 1) * rng:NextNumber(300, 480)), Color = pick({ rgb(120, 60, 200), rgb(60, 40, 160), rgb(200, 80, 220) }, rng), Transparency = 0.6 }, folder)
		end
	end
end

return CourseDecor
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">DataService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- DataService
-- Loads / saves player profiles with:
--   * session locking (prevents two servers writing the same player)
--   * retries with backoff
--   * autosave + save on leave + BindToClose
--   * automatic in-memory fallback when DataStores are unavailable (Studio)
--------------------------------------------------------------------------------

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)

local DataService = {}
DataService.Profiles = {} :: { [Player]: any }
DataService.ProfileLoaded = Signal.new() -- (player, profile)
DataService.ProfileReleasing = Signal.new() -- (player, profile)
DataService.UsingMock = false

local LOCK_TIMEOUT = 120 -- seconds before a stale lock can be stolen
local RETRY_ATTEMPTS = 4
local LOCK_WAIT_ATTEMPTS = 8 -- when another server still holds the lock (~45s)
local LOCK_WAIT_SECONDS = 6 -- DataStores allow one write per key every 6s
local store: any = nil
local activeSaves = 0 -- every in-flight save, so shutdown can wait for all of them
local releasing: { [number]: boolean } = {} -- userIds whose release save is running here

local function log(...)
	if Config.Debug.VerboseData then
		print("[DataService]", ...)
	end
end

--------------------------------------------------------------------------------
-- In-memory mock store (used when DataStore API access is unavailable)
--------------------------------------------------------------------------------

local MockStore = {}
MockStore.__index = MockStore

function MockStore.new()
	return setmetatable({ data = {} }, MockStore)
end

function MockStore:GetAsync(key)
	return Util.DeepCopy(self.data[key])
end

function MockStore:SetAsync(key, value)
	self.data[key] = Util.DeepCopy(value)
end

function MockStore:UpdateAsync(key, transform)
	local newValue = transform(Util.DeepCopy(self.data[key]))
	if newValue ~= nil then
		self.data[key] = Util.DeepCopy(newValue)
	end
	return Util.DeepCopy(newValue)
end

--------------------------------------------------------------------------------
-- Internals
--------------------------------------------------------------------------------

local function retry(fn)
	local lastError
	for attempt = 1, RETRY_ATTEMPTS do
		local ok, err = pcall(fn)
		if ok then
			return true, nil
		end
		lastError = err
		warn(string.format("[DataService] attempt %d failed: %s", attempt, tostring(err)))
		if attempt < RETRY_ATTEMPTS then
			task.wait(2 ^ (attempt - 1))
		end
	end
	return false, lastError
end

local function initStore()
	local ok, result = pcall(function()
		local realStore = DataStoreService:GetDataStore(Config.DataStoreName)
		realStore:GetAsync("__probe__")
		return realStore
	end)

	if ok then
		store = result
	elseif RunService:IsStudio() then
		-- Studio without "Enable Studio Access to API Services".
		DataService.UsingMock = true
		store = MockStore.new()
		warn("[DataService] DataStores unavailable in Studio (" .. tostring(result) .. "). Using an in-memory store; progress will NOT persist.")
	else
		-- Live server: never fall back to a fake store. A failed probe is usually
		-- transient; per-player loads retry and kick if DataStores stay down.
		warn("[DataService] DataStore probe failed (" .. tostring(result) .. "). Continuing with the real store.")
		store = DataStoreService:GetDataStore(Config.DataStoreName)
	end
end

local function newLock()
	return { JobId = game.JobId, Time = os.time() }
end

local function lockedByOther(lock)
	return lock ~= nil and lock.JobId ~= game.JobId and (os.time() - (lock.Time or 0)) < LOCK_TIMEOUT
end

local function migrate(data)
	-- Add migrations here when Config.Version changes, e.g.
	-- if data.Version < 2 then ... end
	data.Version = Config.Version
end

local function buildSnapshot(profile)
	local snapshot = Util.DeepCopy(profile.Data)
	snapshot.Purchases = nil -- client doesn't need receipt ids
	for key, value in pairs(profile.Runtime) do
		snapshot[key] = value
	end
	snapshot.ServerTime = os.time()
	return snapshot
end

--------------------------------------------------------------------------------
-- Load / Save
--------------------------------------------------------------------------------

local function loadProfile(player: Player)
	local key = "Player_" .. player.UserId
	local lockedElsewhere = false
	local saved = nil

	local ok, err
	-- A player who just left another server may still be saving there. Wait a
	-- little for that server to release the lock instead of kicking at once.
	for attempt = 1, LOCK_WAIT_ATTEMPTS do
		ok, err = retry(function()
			saved = store:UpdateAsync(key, function(current)
				lockedElsewhere = false
				if current == nil then
					current = { Data = Util.DeepCopy(Config.DataTemplate) }
				end
				if lockedByOther(current.Lock) then
					lockedElsewhere = true
					return nil
				end
				current.Lock = newLock()
				return current
			end)
		end)
		if not ok or not lockedElsewhere or not player:IsDescendantOf(Players) then
			break
		end
		if attempt < LOCK_WAIT_ATTEMPTS then
			task.wait(LOCK_WAIT_SECONDS)
		end
	end

	if not player:IsDescendantOf(Players) then
		-- Player left while we were loading: release the lock we just took.
		if ok and not lockedElsewhere then
			pcall(function()
				store:UpdateAsync(key, function(current)
					if current and current.Lock and current.Lock.JobId == game.JobId then
						current.Lock = nil
					end
					return current
				end)
			end)
		end
		return nil
	end

	if lockedElsewhere then
		player:Kick("Your data is still saving from another server. Please rejoin in a minute.")
		return nil
	end

	if not ok or saved == nil then
		player:Kick("We couldn't load your data (" .. tostring(err) .. "). Please rejoin.")
		return nil
	end

	local data = saved.Data or Util.DeepCopy(Config.DataTemplate)
	Util.Reconcile(data, Config.DataTemplate)
	migrate(data)

	if data.FirstJoin == 0 then
		data.FirstJoin = os.time()
	end
	data.Stats.Joins += 1

	local profile = {
		Player = player,
		Key = key,
		Data = data,
		Runtime = {
			SessionStart = os.time(),
			Gamepasses = {},
			PlaytimeClaimed = {},
			InGroup = false,
			Multiplier = nil,
			Skips = 0, -- stage skips bought but not yet used (used immediately)
		},
		Loaded = true,
		Saving = false,
		Released = false,
		UnsavedReceipts = {}, -- [PurchaseId] = true when granted but not yet saved
	}

	log("Loaded", player.Name)
	return profile
end

-- Returns true only if the data was actually written.
local function saveProfile(profile, release: boolean): boolean
	activeSaves += 1
	local success = false
	local ok, problem = pcall(function()
		while profile.Saving do
			-- One save at a time per profile, so a release never races an autosave.
			task.wait(0.1)
		end
		if profile.Released then
			-- The final save already ran; never re-lock after it. Report failure so
			-- a receipt is retried next session, where the dedupe list decides.
			return
		end
		profile.Saving = true
		if release then
			profile.Released = true
		end

		local data = profile.Data
		-- Receipts granted before this point are inside `data` and get written now.
		local includedReceipts = table.clone(profile.UnsavedReceipts)
		local cancelled = false
		local saved, err = retry(function()
			cancelled = false
			store:UpdateAsync(profile.Key, function(current)
				if current and lockedByOther(current.Lock) then
					cancelled = true
					return nil -- another live server owns this profile now
				end
				cancelled = false
				return {
					Data = data,
					Lock = if release then nil else newLock(),
					SavedAt = os.time(),
				}
			end)
		end)
		profile.Saving = false

		if saved and not cancelled then
			success = true
			for purchaseId in pairs(includedReceipts) do
				profile.UnsavedReceipts[purchaseId] = nil
			end
			log(release and "Released" or "Saved", profile.Player.Name)
		elseif cancelled then
			warn("[DataService] " .. profile.Player.Name .. "'s data is owned by another server; not saving here.")
			local player = profile.Player
			if not release and player and player:IsDescendantOf(Players) then
				player:Kick("Your data was opened in another server. Please rejoin.")
			end
		else
			warn("[DataService] Failed to save " .. profile.Player.Name .. ": " .. tostring(err))
		end
	end)
	activeSaves -= 1
	if not ok then
		profile.Saving = false
		warn("[DataService] Save error: " .. tostring(problem))
	end
	return success
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

function DataService:GetProfile(player: Player)
	return self.Profiles[player]
end

function DataService:WaitForProfile(player: Player, timeout: number?)
	local deadline = os.clock() + (timeout or 15)
	while os.clock() < deadline do
		local profile = self.Profiles[player]
		if profile then
			return profile
		end
		if not player:IsDescendantOf(Players) then
			return nil
		end
		task.wait(0.1)
	end
	return nil
end

-- Sends a partial state update to the owning client.
function DataService:Replicate(player: Player, patch: { [string]: any })
	Remotes.Get("DataChanged"):FireClient(player, patch)
end

-- Convenience: replicate specific keys straight from profile.Data.
function DataService:ReplicateKeys(player: Player, keys: { string })
	local profile = self.Profiles[player]
	if not profile then
		return
	end
	local patch = {}
	for _, key in ipairs(keys) do
		patch[key] = profile.Data[key]
	end
	self:Replicate(player, patch)
end

function DataService:SendSnapshot(player: Player)
	local profile = self.Profiles[player]
	if profile then
		Remotes.Get("DataLoaded"):FireClient(player, buildSnapshot(profile))
	end
end

-- Forces an immediate save (used after Robux purchases). Returns success.
function DataService:Save(player: Player): boolean
	local profile = self.Profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

--------------------------------------------------------------------------------
-- Lifecycle
--------------------------------------------------------------------------------

local function onPlayerAdded(player: Player)
	-- Rejoined the same server before their release save finished: wait for it.
	local deadline = os.clock() + 30
	while releasing[player.UserId] and os.clock() < deadline and player:IsDescendantOf(Players) do
		task.wait(0.2)
	end
	local profile = loadProfile(player)
	if not profile then
		return
	end
	if not player:IsDescendantOf(Players) then
		saveProfile(profile, true)
		return
	end

	DataService.Profiles[player] = profile
	DataService.ProfileLoaded:Fire(player, profile)
	-- Give listeners a moment to fill Runtime (gamepasses, group) before the snapshot.
	task.delay(0.1, function()
		if DataService.Profiles[player] == profile then
			DataService:SendSnapshot(player)
		end
	end)
end

local function releaseProfile(player: Player, profile)
	DataService.ProfileReleasing:Fire(player, profile)
	DataService.Profiles[player] = nil
	releasing[player.UserId] = true
	saveProfile(profile, true)
	releasing[player.UserId] = nil
end

local function onPlayerRemoving(player: Player)
	local profile = DataService.Profiles[player]
	if profile then
		releaseProfile(player, profile)
	end
end

function DataService.Init()
	initStore()

	Players.PlayerAdded:Connect(function(player)
		task.spawn(onPlayerAdded, player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end
	Players.PlayerRemoving:Connect(onPlayerRemoving)

	local lastRequest: { [Player]: number } = {}
	Remotes.Get("RequestData").OnServerEvent:Connect(function(player)
		local now = os.clock()
		if (lastRequest[player] or 0) + 1 > now then
			return
		end
		lastRequest[player] = now
		DataService:SendSnapshot(player)
	end)
	Players.PlayerRemoving:Connect(function(player)
		lastRequest[player] = nil
	end)

	-- Autosave loop (staggered so we don't burst requests). The profile list is
	-- copied first because the loop yields and players may join meanwhile.
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveInterval)
			local queue = {}
			for player, profile in pairs(DataService.Profiles) do
				table.insert(queue, { Player = player, Profile = profile })
			end
			for _, entry in ipairs(queue) do
				if DataService.Profiles[entry.Player] == entry.Profile then
					task.spawn(saveProfile, entry.Profile, false)
					task.wait(0.5)
				end
			end
		end
	end)

	game:BindToClose(function()
		if RunService:IsStudio() and DataService.UsingMock then
			return
		end
		local remaining = {}
		for player, profile in pairs(DataService.Profiles) do
			table.insert(remaining, { Player = player, Profile = profile })
		end
		for _, entry in ipairs(remaining) do
			task.spawn(releaseProfile, entry.Player, entry.Profile)
		end
		-- Wait for EVERY in-flight save (including ones started by PlayerRemoving
		-- or purchases), within Roblox's 30 second shutdown window.
		task.wait()
		local deadline = os.clock() + 27
		while activeSaves > 0 and os.clock() < deadline do
			task.wait(0.1)
		end
	end)
end

return DataService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">EconomyService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- EconomyService - coins and the coin multiplier.
-- Multiplier = prestige x gamepasses x group x equipped brainrot's Coin Boost.
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local DataService = require(script.Parent.DataService)
local GamepassService = require(script.Parent.GamepassService)

local EconomyService = {}

local MAX_SAFE = 2 ^ 53

local function clampCurrency(value: number): number
	return math.clamp(math.floor(value), 0, MAX_SAFE)
end

local function updateLeaderstats(player: Player, data)
	local leaderstats = player:FindFirstChild("leaderstats")
	if not leaderstats then
		return
	end
	local stage = leaderstats:FindFirstChild("Stage")
	if stage then
		stage.Value = data.Stage
	end
	local coins = leaderstats:FindFirstChild("Coins")
	if coins then
		coins.Value = Util.FormatNumber(data.Coins)
	end
	local prestige = leaderstats:FindFirstChild("Prestige")
	if prestige then
		prestige.Value = data.Prestige
	end
end
EconomyService.UpdateLeaderstats = updateLeaderstats

-- Injected by EventService (it requires this module, so requiring it here
-- would create a cycle).
local eventMultiplier: () -> number = function()
	return 1
end

function EconomyService.SetEventMultiplierSource(source: () -> number)
	eventMultiplier = source
end

function EconomyService.GetMultiplierInfo(player: Player)
	local info = { Prestige = 1, Gamepass = 1, Group = 1, Brainrot = 1, Event = 1, Total = 1 }
	local profile = DataService:GetProfile(player)
	if not profile then
		return info
	end
	local data = profile.Data
	info.Prestige = 1 + data.Prestige * Config.Prestige.CoinMultiplierPerPrestige
	local passMult = 1
	if GamepassService.Owns(player, "DoubleCoins") then
		passMult *= 2
	end
	if GamepassService.Owns(player, "VIP") then
		passMult *= Config.Gamepasses.VIP.CoinMultiplier
	end
	info.Gamepass = passMult
	info.Group = profile.Runtime.InGroup and Config.GroupReward.Multiplier or 1
	local brainrot = Config.Brainrots[data.Equipped]
	if brainrot and brainrot.Perk == "CoinBoost" then
		info.Brainrot = 1 + brainrot.Value
	end
	info.Event = eventMultiplier()
	info.Total = info.Prestige * info.Gamepass * info.Group * info.Brainrot * info.Event
	return info
end

function EconomyService.GetMultiplier(player: Player): number
	return EconomyService.GetMultiplierInfo(player).Total
end

function EconomyService.RefreshMultiplier(player: Player)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end
	local info = EconomyService.GetMultiplierInfo(player)
	profile.Runtime.Multiplier = info
	DataService:Replicate(player, { Multiplier = info })
end

-- Adds coins; with applyMultiplier the amount is scaled by the player's multiplier.
function EconomyService.AddCoins(player: Player, amount: number, applyMultiplier: boolean?): number
	local profile = DataService:GetProfile(player)
	if not profile or amount <= 0 then
		return 0
	end
	if applyMultiplier then
		amount *= EconomyService.GetMultiplier(player)
	end
	amount = math.max(1, math.floor(amount))
	local data = profile.Data
	data.Coins = clampCurrency(data.Coins + amount)
	data.Stats.TotalCoins = clampCurrency(data.Stats.TotalCoins + amount)
	DataService:Replicate(player, { Coins = data.Coins, Stats = data.Stats })
	updateLeaderstats(player, data)
	return amount
end

function EconomyService.SpendCoins(player: Player, amount: number): boolean
	local profile = DataService:GetProfile(player)
	if not profile or amount < 0 then
		return false
	end
	local data = profile.Data
	if data.Coins < amount then
		return false
	end
	data.Coins = clampCurrency(data.Coins - amount)
	DataService:Replicate(player, { Coins = data.Coins })
	updateLeaderstats(player, data)
	return true
end

function EconomyService.Init()
	DataService.ProfileLoaded:Connect(function(player)
		EconomyService.RefreshMultiplier(player)
	end)
	GamepassService.Changed:Connect(function(player)
		EconomyService.RefreshMultiplier(player)
	end)
end

return EconomyService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">EventService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- EventService - server-wide events (Coin Rush, Lucky Stages) on a timer.
-- State is published as attributes on ReplicatedStorage so every client can
-- show a banner and countdown:
--   EventName (string, "" when none), EventEndsAt, NextEventAt (unix seconds)
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local EconomyService = require(script.Parent.EconomyService)

local EventService = {}

local active: string? = nil

function EventService.GetActive()
	if not active then
		return nil, nil
	end
	return active, Config.Events.List[active]
end

function EventService.GetCoinMultiplier(): number
	local _, event = EventService.GetActive()
	return if event and event.CoinMult then event.CoinMult else 1
end

function EventService.GetStageMultiplier(): number
	local _, event = EventService.GetActive()
	return if event and event.StageMult then event.StageMult else 1
end

local function refreshAll()
	for _, player in ipairs(Players:GetPlayers()) do
		EconomyService.RefreshMultiplier(player)
	end
end

function EventService.Init()
	EconomyService.SetEventMultiplierSource(EventService.GetCoinMultiplier)
	ReplicatedStorage:SetAttribute("EventName", "")
	local names = {}
	for name in pairs(Config.Events.List) do
		table.insert(names, name)
	end
	table.sort(names)
	task.spawn(function()
		local rng = Random.new()
		while true do
			local wait = Config.Events.Interval - Config.Events.Duration
			ReplicatedStorage:SetAttribute("NextEventAt", os.time() + wait)
			task.wait(wait)
			active = names[rng:NextInteger(1, #names)]
			ReplicatedStorage:SetAttribute("EventName", active)
			ReplicatedStorage:SetAttribute("EventEndsAt", os.time() + Config.Events.Duration)
			refreshAll()
			task.wait(Config.Events.Duration)
			active = nil
			ReplicatedStorage:SetAttribute("EventName", "")
			refreshAll()
		end
	end)
end

return EventService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">FragmentService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- FragmentService - the hidden Brainrot Fragments. Each is collected once per
-- player forever; finding all of them unlocks the secret brainrot.
--------------------------------------------------------------------------------

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local BrainrotService = require(script.Parent.BrainrotService)
local RateLimiter = require(script.Parent.RateLimiter)

local FragmentService = {}

local fragments: { [string]: BasePart } = {}

local function notify(player: Player, message: string, kind: string?)
	Remotes.Get("Notify"):FireClient(player, message, kind or "info")
end

local function count(data): number
	local found = 0
	for _ in pairs(data.Fragments) do
		found += 1
	end
	return found
end

local function onCollect(player: Player, id: any)
	if type(id) ~= "string" then
		return
	end
	local shard = fragments[id]
	local profile = DataService:GetProfile(player)
	if not shard or not profile or profile.Data.Fragments[id] then
		return
	end
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (root.Position - shard.Position).Magnitude > Config.Coins.MaxPickupDistance then
		return
	end
	if not RateLimiter.Allow(player, "Fragment", 3, 1) then
		return
	end
	local data = profile.Data
	data.Fragments[id] = true
	data.Stats.FragmentsFound += 1
	local reward = EconomyService.AddCoins(player, Config.Fragments.Reward, true)
	DataService:Replicate(player, { Fragments = data.Fragments, Stats = data.Stats })
	Remotes.Get("FragmentTaken"):FireClient(player, id, reward)
	local found = count(data)
	if found >= Config.Fragments.Count then
		for name, def in pairs(Config.Brainrots) do
			if def.Unlock and def.Unlock.Fragments then
				BrainrotService.Give(player, name)
			end
		end
		notify(player, "You found EVERY fragment! The secret brainrot is yours.", "reward")
	else
		notify(player, string.format("Brainrot Fragment found! (%d/%d) +%d coins", found, Config.Fragments.Count, reward), "reward")
	end
end

function FragmentService.Init()
	for _, shard in ipairs(CollectionService:GetTagged("Fragment")) do
		local id = shard:GetAttribute("FragmentId")
		if type(id) == "string" and shard:IsA("BasePart") then
			fragments[id] = shard
		end
	end
	Remotes.Get("CollectFragment").OnServerEvent:Connect(onCollect)
end

return FragmentService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">GamepassService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- GamepassService - caches gamepass ownership and reacts to new purchases.
--------------------------------------------------------------------------------

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Signal = require(Shared.Signal)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)

local GamepassService = {}
GamepassService.Changed = Signal.new() -- (player, passKey)
GamepassService.Refreshed = Signal.new() -- (player, failedKeys) after the join-time ownership check

local CHECK_ATTEMPTS = 3
local RECHECK_DELAY = 45

local function freeInStudio()
	return RunService:IsStudio() and Config.Debug.FreeGamepassesInStudio
end

function GamepassService.Owns(player: Player, passKey: string): boolean
	local profile = DataService:GetProfile(player)
	if not profile then
		return false
	end
	return profile.Runtime.Gamepasses[passKey] == true
end

local function replicate(player)
	local profile = DataService:GetProfile(player)
	if profile then
		DataService:Replicate(player, { Gamepasses = profile.Runtime.Gamepasses })
	end
end

-- Returns true if the pass was newly granted.
function GamepassService.Grant(player: Player, passKey: string): boolean
	local profile = DataService:GetProfile(player)
	if not profile or profile.Runtime.Gamepasses[passKey] then
		return false
	end
	profile.Runtime.Gamepasses[passKey] = true
	if passKey == "VIP" then
		player:SetAttribute("VIP", true)
	end
	replicate(player)
	GamepassService.Changed:Fire(player, passKey)
	return true
end

-- nil = the lookup failed (try again later), otherwise true/false.
local function checkOwnership(player: Player, passId: number): boolean?
	for attempt = 1, CHECK_ATTEMPTS do
		local ok, result = pcall(MarketplaceService.UserOwnsGamePassAsync, MarketplaceService, player.UserId, passId)
		if ok then
			return result == true
		end
		if attempt < CHECK_ATTEMPTS then
			task.wait(attempt)
		end
	end
	return nil
end

function GamepassService.Refresh(player: Player)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end

	local failed = {}
	for key, pass in pairs(Config.Gamepasses) do
		if freeInStudio() then
			GamepassService.Grant(player, key)
		elseif pass.Id and pass.Id > 0 then
			local owns = checkOwnership(player, pass.Id)
			if DataService:GetProfile(player) ~= profile then
				return -- left while we were checking
			end
			if owns then
				-- Merge (never replace) so a pass bought during this check is kept.
				GamepassService.Grant(player, key)
			elseif owns == nil then
				table.insert(failed, key)
			end
		end
	end
	replicate(player)
	GamepassService.Refreshed:Fire(player, failed)

	-- Roblox web lookups fail now and then: re-check failures later instead of
	-- leaving a paying player without their perks for the whole session.
	if #failed > 0 then
		task.delay(RECHECK_DELAY, function()
			if DataService:GetProfile(player) ~= profile then
				return
			end
			for _, key in ipairs(failed) do
				if checkOwnership(player, Config.Gamepasses[key].Id) then
					GamepassService.Grant(player, key)
				end
			end
		end)
	end
end

function GamepassService.Init()
	DataService.ProfileLoaded:Connect(function(player)
		GamepassService.Refresh(player)
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player, passId, wasPurchased)
		if not wasPurchased then
			return
		end
		local key, pass = Config.GetGamepassByProductId(passId)
		if not key or not pass then
			return
		end
		-- Exploiters can fake this event, so confirm the purchase with Roblox.
		-- Ownership lookups can lag a real purchase briefly, so poll with backoff.
		-- (Studio test purchases don't create real ownership, so trust them there.)
		if not RunService:IsStudio() then
			local confirmed = false
			for _, waitSeconds in ipairs({ 0, 1, 2, 4, 8 }) do
				if waitSeconds > 0 then
					task.wait(waitSeconds)
				end
				if not player:IsDescendantOf(Players) then
					return
				end
				if checkOwnership(player, passId) == true then
					confirmed = true
					break
				end
			end
			if not confirmed then
				Remotes.Get("Notify"):FireClient(player, "Purchase received! If your " .. pass.Name .. " perk doesn't appear soon, rejoin the game.", "info")
				task.delay(RECHECK_DELAY, function()
					if player:IsDescendantOf(Players) and checkOwnership(player, passId) == true then
						GamepassService.Grant(player, key)
					end
				end)
				return
			end
		end
		if GamepassService.Grant(player, key) then
			local profile = DataService:GetProfile(player)
			if profile then
				profile.Data.Stats.RobuxSpent += pass.Price or 0
			end
			Remotes.Get("Notify"):FireClient(player, "Thanks for buying " .. pass.Name .. "!", "success")
		end
	end)

	Players.PlayerRemoving:Connect(function(player)
		player:SetAttribute("VIP", nil)
	end)
end

return GamepassService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">LeaderboardService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- LeaderboardService - global OrderedDataStore leaderboards on physical boards.
--------------------------------------------------------------------------------

local DataStoreService = game:GetService("DataStoreService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local DataService = require(script.Parent.DataService)
local CourseBuilder = require(script.Parent.CourseBuilder)

local LeaderboardService = {}

local PUSH_INTERVAL = 60
local REFRESH_INTERVAL = 90
local TOP_COUNT = 10 -- rows that fit on a board
local MAX_ORDERED_VALUE = 9007199254740991

-- Ascending boards (fastest time) store the value as-is and sort low to high.
local BOARDS = {
	{ Key = "BestStage", Get = function(data) return data.Stats.BestStage end, Format = function(value) return "Stage " .. tostring(value) end },
	{ Key = "Prestige", Get = function(data) return data.Prestige end, Format = function(value) return "Prestige " .. tostring(value) end },
	{ Key = "BestTime", Get = function(data) return data.Stats.BestTime end, Ascending = true, Format = function(value) return Util.FormatTime(value) end },
}

local stores = {}
local nameCache: { [number]: string } = {}

--------------------------------------------------------------------------------
-- Mock ordered store for Studio
--------------------------------------------------------------------------------

local MockOrdered = {}
MockOrdered.__index = MockOrdered

function MockOrdered.new()
	return setmetatable({ data = {} }, MockOrdered)
end

function MockOrdered:SetAsync(key, value)
	self.data[key] = value
end

function MockOrdered:GetSortedAsync(ascending, pageSize)
	local list = {}
	for key, value in pairs(self.data) do
		table.insert(list, { key = key, value = value })
	end
	table.sort(list, function(a, b)
		if ascending then
			return a.value < b.value
		end
		return a.value > b.value
	end)
	while #list > pageSize do
		table.remove(list)
	end
	return {
		GetCurrentPage = function()
			return list
		end,
	}
end

--------------------------------------------------------------------------------

local function getName(userId: number): string
	if nameCache[userId] then
		return nameCache[userId]
	end
	local ok, name = pcall(Players.GetNameFromUserIdAsync, Players, userId)
	local result = ok and name or ("User " .. userId)
	nameCache[userId] = result
	return result
end

local function pushScores()
	-- Copy first: SetAsync yields, and players may join while we iterate.
	local entries = {}
	for player, profile in pairs(DataService.Profiles) do
		table.insert(entries, { Player = player, Profile = profile })
	end
	for _, entry in ipairs(entries) do
		local player, profile = entry.Player, entry.Profile
		for _, board in ipairs(BOARDS) do
			local value = math.clamp(math.floor(board.Get(profile.Data)), 0, MAX_ORDERED_VALUE)
			if value > 0 then
				pcall(function()
					stores[board.Key]:SetAsync(tostring(player.UserId), value)
				end)
			end
		end
	end
end

local function renderBoard(boardPart: Part, entries, format)
	local gui = boardPart:FindFirstChild("Board")
	local rows = gui and gui:FindFirstChild("Rows")
	if not rows then
		return
	end
	for _, child in ipairs(rows:GetChildren()) do
		if child:IsA("GuiObject") then
			child:Destroy()
		end
	end

	if #entries == 0 then
		local status = Instance.new("TextLabel")
		status.BackgroundTransparency = 1
		status.Size = UDim2.new(1, 0, 0, 40)
		status.Font = Enum.Font.Gotham
		status.Text = "Be the first on the board!"
		status.TextColor3 = Color3.fromRGB(200, 200, 210)
		status.TextScaled = true
		status.Parent = rows
		return
	end

	for rank, entry in ipairs(entries) do
		local row = Instance.new("Frame")
		row.Name = "Row" .. rank
		row.LayoutOrder = rank
		row.Size = UDim2.new(1, 0, 0, 43)
		row.BackgroundColor3 = rank % 2 == 0 and Color3.fromRGB(40, 42, 58) or Color3.fromRGB(48, 50, 68)
		row.BorderSizePixel = 0
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0, 6)
		corner.Parent = row

		local rankColor = Color3.fromRGB(230, 230, 240)
		if rank == 1 then
			rankColor = Color3.fromRGB(255, 215, 0)
		elseif rank == 2 then
			rankColor = Color3.fromRGB(200, 200, 210)
		elseif rank == 3 then
			rankColor = Color3.fromRGB(205, 127, 50)
		end

		local rankLabel = Instance.new("TextLabel")
		rankLabel.BackgroundTransparency = 1
		rankLabel.Size = UDim2.new(0, 60, 1, 0)
		rankLabel.Font = Enum.Font.LuckiestGuy
		rankLabel.Text = "#" .. rank
		rankLabel.TextColor3 = rankColor
		rankLabel.TextScaled = true
		rankLabel.Parent = row

		local nameLabel = Instance.new("TextLabel")
		nameLabel.BackgroundTransparency = 1
		nameLabel.Position = UDim2.new(0, 66, 0, 0)
		nameLabel.Size = UDim2.new(1, -300, 1, 0)
		nameLabel.Font = Enum.Font.FredokaOne
		nameLabel.Text = entry.Name
		nameLabel.TextColor3 = Color3.fromRGB(240, 240, 250)
		nameLabel.TextScaled = true
		nameLabel.TextXAlignment = Enum.TextXAlignment.Left
		nameLabel.Parent = row

		local valueLabel = Instance.new("TextLabel")
		valueLabel.BackgroundTransparency = 1
		valueLabel.Position = UDim2.new(1, -230, 0, 0)
		valueLabel.Size = UDim2.new(0, 220, 1, 0)
		valueLabel.Font = Enum.Font.FredokaOne
		valueLabel.Text = format(entry.Value)
		valueLabel.TextColor3 = Color3.fromRGB(255, 220, 90)
		valueLabel.TextScaled = true
		valueLabel.TextXAlignment = Enum.TextXAlignment.Right
		valueLabel.Parent = row

		row.Parent = rows
	end
end

local function refreshBoards()
	local boards = CourseBuilder.GetLeaderboardBoards()
	for _, board in ipairs(BOARDS) do
		local boardPart = boards[board.Key]
		if boardPart then
			local ok, page = pcall(function()
				return stores[board.Key]:GetSortedAsync(board.Ascending == true, TOP_COUNT):GetCurrentPage()
			end)
			if ok and page then
				local entries = {}
				for _, item in ipairs(page) do
					local userId = tonumber(item.key)
					if userId then
						table.insert(entries, { Name = getName(userId), Value = item.value })
					end
				end
				renderBoard(boardPart, entries, board.Format)
			end
		end
	end
end

function LeaderboardService.Init()
	for _, board in ipairs(BOARDS) do
		if DataService.UsingMock then
			stores[board.Key] = MockOrdered.new()
		else
			local ok, store = pcall(DataStoreService.GetOrderedDataStore, DataStoreService, Config.LeaderboardStorePrefix .. board.Key)
			stores[board.Key] = ok and store or MockOrdered.new()
		end
	end

	task.spawn(function()
		task.wait(5)
		pushScores()
		refreshBoards()
		local lastPush = os.clock()
		local lastRefresh = os.clock()
		while true do
			task.wait(5)
			local now = os.clock()
			if now - lastPush >= PUSH_INTERVAL then
				lastPush = now
				pushScores()
			end
			if now - lastRefresh >= REFRESH_INTERVAL then
				lastRefresh = now
				refreshBoards()
			end
		end
	end)

	-- Push a player's final score when they leave.
	DataService.ProfileReleasing:Connect(function(player, profile)
		for _, board in ipairs(BOARDS) do
			local value = math.clamp(math.floor(board.Get(profile.Data)), 0, MAX_ORDERED_VALUE)
			if value > 0 then
				task.spawn(pcall, function()
					stores[board.Key]:SetAsync(tostring(player.UserId), value)
				end)
			end
		end
	end)
end

return LeaderboardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">MoverService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- MoverService - animates the course's moving parts on the server so every
-- player sees the same thing.
--
-- Walkable movers ("Carry" = true) are driven with physics constraints so
-- players standing on them are carried along. Hazards are moved by CFrame.
--   MoveKind = "Slide":     MoveAxis, MoveDistance, MovePeriod, MovePhase (Roll = spin while sliding)
--   MoveKind = "Spin":      SpinSpeed (deg/s) around the part's centre (SpinAxis = "X" for fans,
--                           SpinRadius to orbit around the original centre)
--   MoveKind = "Turntable": SpinSpeed, a walkable disc that turns (physics)
--   MoveKind = "Pendulum":  PendulumPivot, PendulumAmp, PendulumPeriod, PendulumPhase, PendulumAxis
--   MoveKind = "Vanish":    VanishPeriod, VanishPhase (platform fades out/in)
--   MoveKind = "Blink":     BlinkPeriod, BlinkPhase (hazard turns off/on)
--------------------------------------------------------------------------------

local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local MoverService = {}

type Slide = { Part: BasePart, Base: CFrame, Axis: Vector3, Distance: number, Period: number, Phase: number, Roll: boolean, Align: AlignPosition? }
type Spin = { Part: BasePart, Base: CFrame, Speed: number, Axis: string, Radius: number, Orient: AlignOrientation?, Followers: { { Part: BasePart, Offset: CFrame } } }
type Pendulum = { Part: BasePart, Pivot: CFrame, Offset: CFrame, Amp: number, Period: number, Phase: number }
type Toggle = { Part: BasePart, Period: number, Phase: number, On: boolean, Hazard: boolean }

local slides: { Slide } = {}
local spins: { Spin } = {}
local pendulums: { Pendulum } = {}
local toggles: { Toggle } = {}
local turntableFollowers: { BasePart } = {}

-- Turns an anchored part into a physics-driven one that follows a target.
local function makeCarried(part: BasePart): (AlignPosition, AlignOrientation)
	local attachment = Instance.new("Attachment")
	attachment.Name = "MoverAttachment"
	attachment.Parent = part
	local alignPosition = Instance.new("AlignPosition")
	alignPosition.Mode = Enum.PositionAlignmentMode.OneAttachment
	alignPosition.Attachment0 = attachment
	alignPosition.RigidityEnabled = true
	alignPosition.MaxForce = math.huge
	alignPosition.Responsiveness = 200
	alignPosition.Position = part.Position
	alignPosition.Parent = part
	local alignOrientation = Instance.new("AlignOrientation")
	alignOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
	alignOrientation.Attachment0 = attachment
	alignOrientation.RigidityEnabled = true
	alignOrientation.MaxTorque = math.huge
	alignOrientation.Responsiveness = 200
	alignOrientation.CFrame = part.CFrame.Rotation
	alignOrientation.Parent = part
	-- the platform's look (child parts) rides along
	for _, child in ipairs(part:GetChildren()) do
		if child:IsA("BasePart") then
			local weld = Instance.new("WeldConstraint")
			weld.Part0 = part
			weld.Part1 = child
			weld.Parent = child
			child.Anchored = false
			child.Massless = true
			child.CanCollide = false
		end
	end
	part.Anchored = false
	part.Massless = false
	part.CustomPhysicalProperties = part.CustomPhysicalProperties or PhysicalProperties.new(1, 0.5, 0)
	part:SetNetworkOwner(nil)
	return alignPosition, alignOrientation
end

local function register(part: Instance)
	if not part:IsA("BasePart") then
		return
	end
	if part:GetAttribute("FollowTurntable") then
		table.insert(turntableFollowers, part)
		return
	end
	local kind = part:GetAttribute("MoveKind")
	if kind == "Slide" then
		local slide: Slide = {
			Part = part,
			Base = part.CFrame,
			Axis = (part:GetAttribute("MoveAxis") or Vector3.new(1, 0, 0)) :: Vector3,
			Distance = (part:GetAttribute("MoveDistance") or 8) :: number,
			Period = (part:GetAttribute("MovePeriod") or 3) :: number,
			Phase = (part:GetAttribute("MovePhase") or 0) :: number,
			Roll = part:GetAttribute("Roll") == true,
			Align = nil,
		}
		if part:GetAttribute("Carry") then
			slide.Align = makeCarried(part)
		end
		table.insert(slides, slide)
	elseif kind == "Spin" or kind == "Turntable" then
		local spin: Spin = {
			Part = part,
			Base = part.CFrame,
			Speed = (part:GetAttribute("SpinSpeed") or 90) :: number,
			Axis = (part:GetAttribute("SpinAxis") or "Y") :: string,
			Radius = (part:GetAttribute("SpinRadius") or 0) :: number,
			Orient = nil,
			Followers = {},
		}
		if part:GetAttribute("Carry") then
			local _, orient = makeCarried(part)
			spin.Orient = orient
		end
		table.insert(spins, spin)
	elseif kind == "Pendulum" then
		local pivot = part:GetAttribute("PendulumPivot")
		if typeof(pivot) == "Vector3" then
			local pivotCF = CFrame.new(pivot)
			table.insert(pendulums, {
				Part = part,
				Pivot = pivotCF,
				Offset = pivotCF:ToObjectSpace(part.CFrame),
				Amp = (part:GetAttribute("PendulumAmp") or 1) :: number,
				Period = (part:GetAttribute("PendulumPeriod") or 3) :: number,
				Phase = (part:GetAttribute("PendulumPhase") or 0) :: number,
			})
			if part:GetAttribute("PendulumAxis") == "X" then
				part:SetAttribute("PendulumAxisX", true)
			end
		end
	elseif kind == "Vanish" then
		table.insert(toggles, { Part = part, Period = (part:GetAttribute("VanishPeriod") or 3) :: number, Phase = (part:GetAttribute("VanishPhase") or 0) :: number, On = true, Hazard = false })
	elseif kind == "Blink" then
		table.insert(toggles, { Part = part, Period = (part:GetAttribute("BlinkPeriod") or 2) :: number, Phase = (part:GetAttribute("BlinkPhase") or 0) :: number, On = true, Hazard = true })
	end
end

-- Attach the turntable stripes to the nearest turntable disc.
local function linkFollowers()
	for _, follower in ipairs(turntableFollowers) do
		local best, bestDistance = nil, math.huge
		for _, spin in ipairs(spins) do
			if spin.Orient then
				local distance = (spin.Base.Position - follower.Position).Magnitude
				if distance < bestDistance then
					best, bestDistance = spin, distance
				end
			end
		end
		if best then
			table.insert(best.Followers, { Part = follower, Offset = best.Base:ToObjectSpace(follower.CFrame) })
		end
	end
end

local function step()
	local t = os.clock()
	local parts, cframes = {}, {}
	for _, slide in ipairs(slides) do
		local phase = (t / slide.Period + slide.Phase) % 1
		local k = 0.5 - 0.5 * math.cos(phase * math.pi * 2)
		local target = slide.Base * CFrame.new(slide.Axis * (slide.Distance * k))
		if slide.Align then
			slide.Align.Position = target.Position
		else
			if slide.Roll then
				target = target * CFrame.Angles(slide.Distance * k * 0.6, 0, 0)
			end
			table.insert(parts, slide.Part)
			table.insert(cframes, target)
		end
	end
	for _, spin in ipairs(spins) do
		local angle = math.rad(spin.Speed * t)
		local rotation = if spin.Axis == "X" then CFrame.Angles(angle, 0, 0) else CFrame.Angles(0, angle, 0)
		if spin.Orient then
			-- discs lie on their side (cylinder axis up), so spin about world Y
			local target = CFrame.Angles(0, angle, 0) * spin.Base.Rotation
			spin.Orient.CFrame = target
			for _, follower in ipairs(spin.Followers) do
				table.insert(parts, follower.Part)
				table.insert(cframes, CFrame.new(spin.Base.Position) * CFrame.Angles(0, angle, 0) * CFrame.new(-spin.Base.Position) * spin.Base * follower.Offset)
			end
		elseif spin.Radius > 0 then
			local orbit = CFrame.new(spin.Base.Position) * CFrame.Angles(0, angle, 0) * CFrame.new(spin.Radius, 0, 0)
			table.insert(parts, spin.Part)
			table.insert(cframes, orbit)
		else
			table.insert(parts, spin.Part)
			table.insert(cframes, spin.Base * rotation)
		end
	end
	for _, pendulum in ipairs(pendulums) do
		local swing = math.sin((t / pendulum.Period + pendulum.Phase) * math.pi * 2) * pendulum.Amp
		local rotation = if pendulum.Part:GetAttribute("PendulumAxisX") then CFrame.Angles(0, 0, swing) else CFrame.Angles(swing, 0, 0)
		table.insert(parts, pendulum.Part)
		table.insert(cframes, pendulum.Pivot * rotation * pendulum.Offset)
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
	for _, toggle in ipairs(toggles) do
		local phase = (t / toggle.Period + toggle.Phase) % 1
		local on = phase < 0.55
		if on ~= toggle.On then
			toggle.On = on
			if toggle.Hazard then
				toggle.Part.CanTouch = on
				toggle.Part.CanCollide = false
				toggle.Part.Transparency = if on then 0 else 0.9
			else
				toggle.Part.CanCollide = on
				for _, child in ipairs(toggle.Part:GetChildren()) do
					if child:IsA("BasePart") then
						child.Transparency = if on then (if child.Name == "Glow" then 0.2 else 0) else 0.85
					end
				end
			end
		end
		-- warning flicker just before a platform vanishes
		if not toggle.Hazard and on and phase > 0.42 then
			local plate = toggle.Part:FindFirstChild("Plate")
			if plate and plate:IsA("BasePart") then
				plate.Transparency = if math.floor(phase * 30) % 2 == 0 then 0.4 else 0
			end
		end
	end
end

function MoverService.Init()
	local course = Workspace:WaitForChild("Course")
	for _, descendant in ipairs(course:GetDescendants()) do
		register(descendant)
	end
	linkFollowers()
	RunService.Heartbeat:Connect(step)
end

return MoverService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="26">
        <Properties>
          <string name="Name">PlayerService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- PlayerService - leaderstats, playtime tracking, settings, welcome messages.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)

local PlayerService = {}

local ALLOWED_SETTINGS = { Music = true, Effects = true, ShowOthers = true }

local function setupLeaderstats(player: Player, data)
	if player:FindFirstChild("leaderstats") then
		return
	end
	local leaderstats = Instance.new("Folder")
	leaderstats.Name = "leaderstats"

	local stage = Instance.new("IntValue")
	stage.Name = "Stage"
	stage.Parent = leaderstats

	local coins = Instance.new("StringValue")
	coins.Name = "Coins"
	coins.Parent = leaderstats

	local prestige = Instance.new("IntValue")
	prestige.Name = "Prestige"
	prestige.Parent = leaderstats

	leaderstats.Parent = player
	EconomyService.UpdateLeaderstats(player, data)
end

function PlayerService.Init()
	DataService.ProfileLoaded:Connect(function(player, profile)
		setupLeaderstats(player, profile.Data)
		task.delay(2, function()
			if not player:IsDescendantOf(Players) then
				return
			end
			if profile.Data.Stats.Joins <= 1 then
				Remotes.Get("Notify"):FireClient(player, "Welcome to " .. Config.GameName .. "! Follow the arrows and touch the glowing pads.", "info")
			else
				Remotes.Get("Notify"):FireClient(player, "Welcome back, " .. player.DisplayName .. "! You're on stage " .. profile.Data.Stage .. ".", "info")
			end
		end)
	end)

	Remotes.Get("UpdateSetting").OnServerEvent:Connect(function(player, key, value)
		if type(key) ~= "string" or not ALLOWED_SETTINGS[key] or type(value) ~= "boolean" then
			return
		end
		local profile = DataService:GetProfile(player)
		if profile then
			profile.Data.Settings[key] = value
		end
	end)

	task.spawn(function()
		while true do
			task.wait(10)
			for player, profile in pairs(DataService.Profiles) do
				profile.Data.Stats.Playtime += 10
				DataService:Replicate(player, { Stats = profile.Data.Stats })
			end
		end
	end)
end

return PlayerService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">QuestService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- QuestService - three daily quests per player plus a bonus for all three.
-- Progress is measured from Stats, so no gameplay code needs quest hooks.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.RateLimiter)
local RewardService = require(script.Parent.RewardService)

local QuestService = {}

local function notify(player: Player, message: string, kind: string?)
	Remotes.Get("Notify"):FireClient(player, message, kind or "info")
end

local function ensureToday(player: Player, profile)
	local data = profile.Data
	local quests = data.Quests
	local today = Util.DayNumber(os.time())
	if quests.Day == today and #quests.Ids > 0 then
		return
	end
	quests.Day = today
	quests.Ids = Config.PickQuests(today, player.UserId)
	quests.Baseline = {}
	for _, id in ipairs(quests.Ids) do
		local quest = Config.GetQuest(id)
		if quest then
			quests.Baseline[quest.Stat] = data.Stats[quest.Stat] or 0
		end
	end
	quests.Claimed = {}
	quests.BonusClaimed = false
	DataService:Replicate(player, { Quests = quests })
end

function QuestService.GetProgress(profile, quest): number
	local data = profile.Data
	local raw = (data.Stats[quest.Stat] or 0) - (data.Quests.Baseline[quest.Stat] or 0)
	return math.floor(raw / (quest.Scale or 1))
end

function QuestService.Claim(player: Player, slot: number)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end
	ensureToday(player, profile)
	local quests = profile.Data.Quests
	local id = quests.Ids[slot]
	local quest = id and Config.GetQuest(id)
	if not quest or quests.Claimed[id] then
		return
	end
	if QuestService.GetProgress(profile, quest) < quest.Goal then
		notify(player, "That quest isn't finished yet!", "error")
		return
	end
	quests.Claimed[id] = true
	local summary = RewardService.Grant(player, quest.Reward, 1)
	notify(player, "Quest complete! " .. summary, "reward")
	local all = true
	for _, questId in ipairs(quests.Ids) do
		if not quests.Claimed[questId] then
			all = false
		end
	end
	if all and not quests.BonusClaimed then
		quests.BonusClaimed = true
		local bonus = RewardService.Grant(player, Config.Quests.BonusReward, 1)
		notify(player, "All daily quests done! Bonus: " .. bonus, "reward")
	end
	DataService:Replicate(player, { Quests = quests })
end

function QuestService.Init()
	DataService.ProfileLoaded:Connect(function(player, profile)
		ensureToday(player, profile)
	end)
	Remotes.Get("ClaimQuest").OnServerEvent:Connect(function(player, slot)
		if type(slot) == "number" and slot == math.floor(slot) and RateLimiter.Allow(player, "ClaimQuest", 4, 1) then
			QuestService.Claim(player, slot)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(60)
			for _, player in ipairs(Players:GetPlayers()) do
				local profile = DataService:GetProfile(player)
				if profile then
					ensureToday(player, profile)
				end
			end
		end
	end)
end

return QuestService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">RateLimiter</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- RateLimiter - per-player token buckets for remote handlers.
--   if not RateLimiter.Allow(player, "EquipPet", 10, 10) then return end
-- capacity = burst size, refillPerSecond = sustained rate.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")

local RateLimiter = {}

type Bucket = { Tokens: number, Updated: number }
local buckets: { [Player]: { [string]: Bucket } } = {}

function RateLimiter.Allow(player: Player, key: string, capacity: number, refillPerSecond: number): boolean
	local now = os.clock()
	local playerBuckets = buckets[player]
	if not playerBuckets then
		playerBuckets = {}
		buckets[player] = playerBuckets
	end
	local bucket = playerBuckets[key]
	if not bucket then
		bucket = { Tokens = capacity, Updated = now }
		playerBuckets[key] = bucket
	end
	bucket.Tokens = math.min(capacity, bucket.Tokens + (now - bucket.Updated) * refillPerSecond)
	bucket.Updated = now
	if bucket.Tokens >= 1 then
		bucket.Tokens -= 1
		return true
	end
	return false
end

Players.PlayerRemoving:Connect(function(player)
	buckets[player] = nil
end)

return RateLimiter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">RewardService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- RewardService - daily streak, playtime chests, group reward.
-- These are the retention hooks that bring players back tomorrow.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local Codes = require(script.Parent.Parent:WaitForChild("Codes"))
local DataService = require(script.Parent.DataService)
local RateLimiter = require(script.Parent.RateLimiter)
local GamepassService = require(script.Parent.GamepassService)
local EconomyService = require(script.Parent.EconomyService)
local BrainrotService = require(script.Parent.BrainrotService)

local RewardService = {}

local function notify(player: Player, message: string, kind: string?)
	Remotes.Get("Notify"):FireClient(player, message, kind or "info")
end

-- Grants a reward table { Coins?, Brainrot?, BrainrotCoins? } and returns a description.
local function grant(player: Player, reward, multiplier: number): string
	local parts = {}
	if reward.Coins then
		local amount = EconomyService.AddCoins(player, reward.Coins * multiplier, false)
		table.insert(parts, Util.FormatNumber(amount) .. " Coins")
	end
	if reward.Brainrot then
		if BrainrotService.Owns(player, reward.Brainrot) then
			local amount = EconomyService.AddCoins(player, (reward.BrainrotCoins or 500) * multiplier, false)
			table.insert(parts, Util.FormatNumber(amount) .. " bonus Coins")
		else
			BrainrotService.Give(player, reward.Brainrot, true)
			table.insert(parts, reward.Brainrot .. " brainrot")
		end
	end
	return table.concat(parts, " + ")
end

-- Shared with other services (quests).
RewardService.Grant = grant

--------------------------------------------------------------------------------
-- Daily
--------------------------------------------------------------------------------

function RewardService.ClaimDaily(player: Player)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end
	local data = profile.Data
	local state = Util.ComputeDaily(data.Daily, os.time(), #Config.DailyRewards)
	if not state.Available then
		notify(player, "Come back tomorrow for your next daily reward!", "error")
		return
	end

	data.Daily.Streak = state.NextStreak
	data.Daily.LastClaim = os.time()

	local reward = Config.DailyRewards[state.NextDay]
	local multiplier = GamepassService.Owns(player, "VIP") and Config.Gamepasses.VIP.DailyRewardMultiplier or 1
	local summary = grant(player, reward, multiplier)

	DataService:Replicate(player, { Daily = data.Daily })
	notify(player, string.format("Day %d reward claimed: %s", state.NextDay, summary), "reward")
end

--------------------------------------------------------------------------------
-- Playtime
--------------------------------------------------------------------------------

function RewardService.ClaimPlaytime(player: Player, index: number)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end
	local reward = Config.PlaytimeRewards[index]
	if not reward then
		return
	end
	local runtime = profile.Runtime
	if runtime.PlaytimeClaimed[tostring(index)] then
		return
	end
	local elapsed = os.time() - runtime.SessionStart
	if elapsed < reward.Minutes * 60 then
		notify(player, "Keep playing! " .. Util.FormatTime(reward.Minutes * 60 - elapsed) .. " left", "error")
		return
	end

	runtime.PlaytimeClaimed[tostring(index)] = true
	local summary = grant(player, reward, 1)
	DataService:Replicate(player, { PlaytimeClaimed = runtime.PlaytimeClaimed })
	notify(player, "Playtime reward: " .. summary, "reward")
end

--------------------------------------------------------------------------------
-- Group
--------------------------------------------------------------------------------

local function refreshGroup(player: Player)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end
	local inGroup = false
	if Config.GroupId and Config.GroupId > 0 then
		local ok, result = pcall(function()
			return (player :: any):IsInGroupAsync(Config.GroupId)
		end)
		if not ok then
			-- Older engine builds: fall back to the legacy API.
			ok, result = pcall(function()
				return (player :: any):IsInGroup(Config.GroupId)
			end)
		end
		inGroup = ok and result == true
	end
	profile.Runtime.InGroup = inGroup
	DataService:Replicate(player, { InGroup = inGroup })
	EconomyService.RefreshMultiplier(player)
end

local claimingGroup: { [Player]: boolean } = {}

function RewardService.ClaimGroup(player: Player)
	local profile = DataService:GetProfile(player)
	if not profile or profile.Data.GroupClaimed or claimingGroup[player] then
		return
	end
	if not RateLimiter.Allow(player, "ClaimGroup", 1, 0.2) then
		return
	end
	-- refreshGroup yields on a web call; the flag stops parallel claims meanwhile.
	claimingGroup[player] = true
	refreshGroup(player)
	claimingGroup[player] = nil
	if DataService:GetProfile(player) ~= profile or profile.Data.GroupClaimed then
		return
	end
	if not profile.Runtime.InGroup then
		notify(player, "Join our Roblox group, then rejoin the game to claim!", "error")
		return
	end
	profile.Data.GroupClaimed = true
	EconomyService.AddCoins(player, Config.GroupReward.Coins, false)
	DataService:Replicate(player, { GroupClaimed = true })
	notify(player, "Thanks for joining the group! +" .. Config.GroupReward.Coins .. " Coins and +10% coins forever", "reward")
end

--------------------------------------------------------------------------------
-- Promo codes
--------------------------------------------------------------------------------

function RewardService.RedeemCode(player: Player, rawCode: string)
	local profile = DataService:GetProfile(player)
	if not profile then
		return { ok = false, message = "Data not loaded yet" }
	end
	if not RateLimiter.Allow(player, "RedeemCode", 3, 0.5) then
		return { ok = false, message = "Slow down!" }
	end

	local code = string.upper((rawCode:gsub("%s+", "")))
	if #code == 0 or #code > 32 then
		return { ok = false, message = "Invalid code" }
	end
	local reward = Codes[code]
	if not reward then
		return { ok = false, message = "Invalid code" }
	end
	if reward.Expires and os.time() > reward.Expires then
		return { ok = false, message = "This code has expired" }
	end
	local redeemed = profile.Data.RedeemedCodes
	if redeemed[code] then
		return { ok = false, message = "You already redeemed this code" }
	end

	redeemed[code] = true
	local summary = grant(player, reward, 1)
	return { ok = true, message = "Code redeemed: " .. summary }
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------

function RewardService.Init()
	DataService.ProfileLoaded:Connect(function(player)
		refreshGroup(player)
		-- Remind returning players about their daily reward.
		local profile = DataService:GetProfile(player)
		if profile then
			local state = Util.ComputeDaily(profile.Data.Daily, os.time(), #Config.DailyRewards)
			if state.Available then
				task.delay(6, function()
					if player:IsDescendantOf(Players) then
						notify(player, "Your daily reward is ready! Open REWARDS to claim it.", "reward")
					end
				end)
			end
		end
	end)

	Remotes.Get("ClaimDaily").OnServerEvent:Connect(function(player)
		if RateLimiter.Allow(player, "ClaimDaily", 2, 0.5) then
			RewardService.ClaimDaily(player)
		end
	end)
	Remotes.Get("ClaimPlaytime").OnServerEvent:Connect(function(player, index)
		if type(index) == "number" and RateLimiter.Allow(player, "ClaimPlaytime", 6, 2) then
			RewardService.ClaimPlaytime(player, index)
		end
	end)
	Remotes.Get("ClaimGroup").OnServerEvent:Connect(RewardService.ClaimGroup)

	Remotes.Get("RedeemCode").OnServerInvoke = function(player, code)
		if type(code) ~= "string" then
			return { ok = false, message = "Invalid code" }
		end
		return RewardService.RedeemCode(player, code)
	end

	Players.PlayerRemoving:Connect(function(player)
		claimingGroup[player] = nil
	end)
end

return RewardService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">ShopService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- ShopService - Developer Product purchases (ProcessReceipt).
-- Idempotent: each PurchaseId is granted at most once, even across retries.
--------------------------------------------------------------------------------

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local StageService = require(script.Parent.StageService)

local ShopService = {}

local MAX_RECEIPT_HISTORY = 60

local function notify(player: Player, message: string, kind: string?)
	Remotes.Get("Notify"):FireClient(player, message, kind or "info")
end

local function grantProduct(player: Player, product)
	local grantInfo = product.Grant
	if grantInfo.Coins then
		local amount = EconomyService.AddCoins(player, grantInfo.Coins, false)
		notify(player, "Purchased " .. product.Name .. ": +" .. Util.FormatNumber(amount) .. " Coins", "success")
	end
	if grantInfo.Skips then
		StageService.Skip(player, grantInfo.Skips)
	end
end

local function processReceipt(receiptInfo)
	local player = Players:GetPlayerByUserId(receiptInfo.PlayerId)
	if not player then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	if DataService.UsingMock and not RunService:IsStudio() then
		return Enum.ProductPurchaseDecision.NotProcessedYet -- never confirm into a fake store
	end
	local profile = DataService:WaitForProfile(player, 60)
	if not profile or not profile.Loaded then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local purchases = profile.Data.Purchases
	for _, id in ipairs(purchases) do
		if id == receiptInfo.PurchaseId then
			if profile.UnsavedReceipts[receiptInfo.PurchaseId] then
				if DataService:Save(player) then
					return Enum.ProductPurchaseDecision.PurchaseGranted
				end
				return Enum.ProductPurchaseDecision.NotProcessedYet
			end
			return Enum.ProductPurchaseDecision.PurchaseGranted
		end
	end

	local productKey, product = Config.GetProductById(receiptInfo.ProductId)
	if not productKey or not product then
		warn("[ShopService] Receipt for unknown ProductId " .. tostring(receiptInfo.ProductId) .. " - add it to Config.Products")
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	local ok, err = pcall(grantProduct, player, product)
	if not ok then
		warn("[ShopService] Failed to grant " .. productKey .. ": " .. tostring(err))
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end

	table.insert(purchases, receiptInfo.PurchaseId)
	while #purchases > MAX_RECEIPT_HISTORY do
		table.remove(purchases, 1)
	end
	profile.Data.Stats.RobuxSpent += receiptInfo.CurrencySpent or 0

	profile.UnsavedReceipts[receiptInfo.PurchaseId] = true
	local saved = DataService:Save(player)
	if not saved then
		return Enum.ProductPurchaseDecision.NotProcessedYet
	end
	return Enum.ProductPurchaseDecision.PurchaseGranted
end

function ShopService.Init()
	MarketplaceService.ProcessReceipt = processReceipt
end

return ShopService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">StageService</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- StageService - checkpoints, respawning, falling, kill parts, stage skips,
-- the finish portal and prestige. All progress is validated here.
--------------------------------------------------------------------------------

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local Signal = require(Shared.Signal)

local DataService = require(script.Parent.DataService)
local EconomyService = require(script.Parent.EconomyService)
local GamepassService = require(script.Parent.GamepassService)
local CourseBuilder = require(script.Parent.CourseBuilder)
local RateLimiter = require(script.Parent.RateLimiter)
local EventService = require(script.Parent.EventService)

local StageService = {}
StageService.StageChanged = Signal.new() -- (player, stage)
StageService.Prestiged = Signal.new() -- (player, newPrestige)

local lastStageTime: { [Player]: number } = {} -- when the player last gained a stage
local lastDeath: { [Player]: number } = {}
local prestiging: { [Player]: boolean } = {}

local function notify(player: Player, message: string, kind: string?)
	Remotes.Get("Notify"):FireClient(player, message, kind or "info")
end

local function playerFromHit(hit: BasePart): (Player?, Model?)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil, nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	return player, character
end

--------------------------------------------------------------------------------
-- Spawning
--------------------------------------------------------------------------------

-- Teleports the character to their checkpoint (a frame later so physics settle).
function StageService.SendToCheckpoint(player: Player, stage: number?)
	local profile = DataService:GetProfile(player)
	local character = player.Character
	if not profile or not character then
		return
	end
	local target = stage or profile.Data.Stage
	local cf = CourseBuilder.GetCheckpoint(target)
	if cf then
		character:PivotTo(cf)
	end
end

local function onCharacterAdded(player: Player, character: Model)
	local profile = DataService:WaitForProfile(player, 30)
	if not profile or player.Character ~= character then
		return
	end
	-- Wait for the root so PivotTo moves the whole rig.
	character:WaitForChild("HumanoidRootPart", 10)
	task.wait()
	-- Stage 1 players spawn in the lobby (the SpawnLocation), everyone else at
	-- their checkpoint.
	if profile.Data.Stage > 1 then
		StageService.SendToCheckpoint(player)
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.Died:Connect(function()
			lastDeath[player] = os.clock()
			profile.Data.Stats.Deaths += 1
		end)
	end
end

--------------------------------------------------------------------------------
-- Checkpoints
--------------------------------------------------------------------------------

local function maxSpeedFor(player: Player): number
	local profile = DataService:GetProfile(player)
	local def = profile and Config.Brainrots[profile.Data.Equipped]
	local speed = if def then def.Speed else 16
	if GamepassService.Owns(player, "SpeedBoost") then
		speed *= Config.Gamepasses.SpeedBoost.SpeedMultiplier
	end
	if def and def.Perk == "Dash" then
		speed += def.Value * 0.3
	end
	return speed
end

-- Grants stage `stage` to the player if it is the next one and reachable.
function StageService.ReachStage(player: Player, stage: number, viaSkip: boolean?)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end
	local data = profile.Data
	if stage ~= data.Stage + 1 then
		return
	end
	if not viaSkip then
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local cf = CourseBuilder.GetCheckpoint(stage)
		if not root or not cf then
			return
		end
		if (root.Position - cf.Position).Magnitude > Config.AntiCheat.CheckpointRadius then
			return
		end
		-- Too fast for this stage's length? Ignore it (speed exploits).
		local length = CourseBuilder.GetStageStartX(stage) - CourseBuilder.GetStageStartX(data.Stage)
		local minTime = length / (maxSpeedFor(player) * Config.AntiCheat.MaxSpeedFactor)
		local since = os.clock() - (lastStageTime[player] or 0)
		if since < minTime then
			return
		end
	end
	lastStageTime[player] = os.clock()
	data.Stage = stage
	local isNew = false
	local total = Config.TotalStages()
	local absolute = data.Prestige * total + stage
	if absolute > (data.Stats.BestStage or 1) then
		data.Stats.BestStage = absolute
		isNew = true
	end
	local reward = 0
	data.Stats.CheckpointsTouched += 1
	if isNew and not viaSkip then
		data.Stats.StagesCleared += 1
		-- the stage you just finished (stage - 1) pays; boss stages pay 4x
		local finished = stage - 1
		local world, _ = Config.GetWorld(finished)
		local _, inWorld = Config.GetWorldForStage(finished)
		local amount = Config.GetStageReward(finished) * EventService.GetStageMultiplier()
		if inWorld == world.Stages then
			amount *= 4
		end
		reward = EconomyService.AddCoins(player, amount, true)
	end
	DataService:Replicate(player, { Stage = stage, Stats = data.Stats })
	EconomyService.UpdateLeaderstats(player, data)
	Remotes.Get("StageReached"):FireClient(player, stage, isNew, reward)
	StageService.StageChanged:Fire(player, stage)
end

-- Developer product: skip ahead (never past the finish).
function StageService.Skip(player: Player, count: number)
	local profile = DataService:GetProfile(player)
	if not profile then
		return
	end
	local total = Config.TotalStages()
	local skipped = 0
	for _ = 1, count do
		if profile.Data.Stage >= total then
			break
		end
		StageService.ReachStage(player, profile.Data.Stage + 1, true)
		skipped += 1
	end
	profile.Data.Stats.StagesSkipped += skipped
	StageService.SendToCheckpoint(player)
	notify(player, string.format("Skipped %d stage%s! You're on stage %d.", skipped, if skipped == 1 then "" else "s", profile.Data.Stage), "success")
end

--------------------------------------------------------------------------------
-- Prestige
--------------------------------------------------------------------------------

function StageService.Prestige(player: Player)
	local profile = DataService:GetProfile(player)
	if not profile or prestiging[player] then
		return
	end
	local data = profile.Data
	if data.Stage < Config.Prestige.FinalStage then
		notify(player, "Beat all " .. Config.Prestige.FinalStage .. " stages to prestige!", "error")
		return
	end
	prestiging[player] = true
	-- Record the run time (fastest run leaderboard).
	local runTime = os.time() - (data.Stats.RunStart or os.time())
	if runTime > 30 and (data.Stats.BestTime == 0 or runTime < data.Stats.BestTime) then
		data.Stats.BestTime = runTime
	end
	data.Prestige += 1
	data.Stage = 1
	data.Stats.RunStart = os.time()
	local reward = EconomyService.AddCoins(player, Config.Prestige.Reward, false)
	DataService:Replicate(player, { Prestige = data.Prestige, Stage = 1, Stats = data.Stats })
	EconomyService.RefreshMultiplier(player)
	EconomyService.UpdateLeaderstats(player, data)
	StageService.SendToCheckpoint(player, 1)
	notify(player, string.format("PRESTIGE %d! +%s coins and +%d%% coins forever. Run time: %s", data.Prestige, Util.FormatNumber(reward), math.floor(Config.Prestige.CoinMultiplierPerPrestige * 100), Util.FormatTime(runTime)), "reward")
	StageService.Prestiged:Fire(player, data.Prestige)
	StageService.StageChanged:Fire(player, 1)
	prestiging[player] = nil
end

--------------------------------------------------------------------------------
-- Falling / kill parts
--------------------------------------------------------------------------------

local function killCharacter(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.Health > 0 then
		humanoid.Health = 0
	end
end

local function fallCheck()
	for _, player in ipairs(Players:GetPlayers()) do
		local profile = DataService:GetProfile(player)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if profile and root then
			local stage = profile.Data.Stage
			local floor = math.min(CourseBuilder.GetFloorY(stage), CourseBuilder.GetFloorY(stage + 1))
			-- the lobby floor is at 0; stage floors rise from there
			if root.Position.Y < math.min(floor, 0) - Config.Course.FallDepth then
				killCharacter(player)
			end
		end
	end
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------

function StageService.Init()
	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character)
			onCharacterAdded(player, character)
		end)
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
	end
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(player)
		lastStageTime[player] = nil
		lastDeath[player] = nil
		prestiging[player] = nil
	end)

	DataService.ProfileLoaded:Connect(function(player, profile)
		if (profile.Data.Stats.RunStart or 0) == 0 then
			profile.Data.Stats.RunStart = os.time()
		end
		lastStageTime[player] = os.clock() - 60
		if player.Character then
			task.spawn(onCharacterAdded, player, player.Character)
		end
	end)

	for _, trigger in ipairs(CollectionService:GetTagged("Checkpoint")) do
		local stage = trigger:GetAttribute("Stage")
		if type(stage) == "number" and trigger:IsA("BasePart") then
			trigger.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				if player then
					StageService.ReachStage(player, stage)
				end
			end)
		end
	end
	for _, killPart in ipairs(CollectionService:GetTagged("Kill")) do
		if killPart:IsA("BasePart") then
			killPart.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				if player then
					killCharacter(player)
				end
			end)
		end
	end
	for _, finish in ipairs(CollectionService:GetTagged("Finish")) do
		if finish:IsA("BasePart") then
			finish.Touched:Connect(function(hit)
				local player = playerFromHit(hit)
				if player and RateLimiter.Allow(player, "Finish", 1, 0.2) then
					StageService.Prestige(player)
				end
			end)
		end
	end

	-- fall detection a few times a second
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.25 then
			accumulator = 0
			fallCheck()
		end
	end)

	Remotes.Get("TeleportStage").OnServerEvent:Connect(function(player, stage)
		if type(stage) ~= "number" or stage ~= math.floor(stage) or not RateLimiter.Allow(player, "TeleportStage", 3, 1) then
			return
		end
		local profile = DataService:GetProfile(player)
		if not profile or stage < 1 or stage > profile.Data.Stage then
			return
		end
		-- Going back is free; the saved checkpoint stays where it was.
		StageService.SendToCheckpoint(player, stage)
	end)

	Remotes.Get("ResetCharacter").OnServerEvent:Connect(function(player)
		if RateLimiter.Allow(player, "Reset", 3, 1) then
			killCharacter(player)
		end
	end)

	Remotes.Get("Prestige").OnServerEvent:Connect(function(player)
		if RateLimiter.Allow(player, "Prestige", 1, 0.2) then
			StageService.Prestige(player)
		end
	end)
end

return StageService
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
