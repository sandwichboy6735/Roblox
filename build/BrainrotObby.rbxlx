	c.TailPart = c.BodyPart
	c.BodyCenter, c.BodySize = V(0, 1.75, 0), V(1.4, 2.9, 1.5)
	c.HeadCenter, c.HeadSize, c.HeadTop = V(0, 2.6, -0.3), 1.2, V(0, 3.25, -0.2)
