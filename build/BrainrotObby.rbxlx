  </Item>
  <Item class="StarterPlayer" referent="34">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <float name="CharacterJumpPower">50</float>
      <bool name="CharacterUseJumpPower">true</bool>
      <float name="CharacterWalkSpeed">16</float>
      <bool name="EnableMouseLockOption">true</bool>
    </Properties>
    <Item class="StarterPlayerScripts" referent="35">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="36">
        <Properties>
          <string name="Name">Client</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- Brainrot Obby - client bootstrap
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Remotes = require(Shared.Remotes)

local Modules = script.Parent:WaitForChild("Modules")
local Controllers = script.Parent:WaitForChild("Controllers")
local State = require(Modules.ClientState)

-- 1) Listen for data BEFORE asking for it.
Remotes.Get("DataLoaded").OnClientEvent:Connect(function(snapshot)
	if type(snapshot) == "table" then
		State.Load(snapshot)
	end
end)
Remotes.Get("DataChanged").OnClientEvent:Connect(function(patch)
	if type(patch) == "table" then
		State.Apply(patch)
	end
end)

-- 2) Start controllers (UIController first: everything else builds on it).
local START_ORDER = {
	"UIController",
	"BrainrotsUI",
	"ShopUI",
	"StagesUI",
	"QuestsUI",
	"RewardsUI",
	"StatsUI",
	"SettingsUI",
	"MovementController",
	"CoinController",
	"ObbyFxController",
	"EventUI",
	"AmbienceController",
	"PlayerVisualsController",
	"TrailController",
	"ChatController",
	"IntroController",
}

for _, name in ipairs(START_ORDER) do
	local module = Controllers:FindFirstChild(name)
	if not module then
		warn("[Client] Missing controller: " .. name)
		continue
	end
	local ok, err = pcall(function()
		local controller = require(module)
		if type(controller.Init) == "function" then
			controller.Init()
		end
	end)
	if not ok then
		warn("[Client] " .. name .. ".Init failed: " .. tostring(err))
	end
end

-- 3) Ask the server for our data (covers the case where the initial push
--    arrived before our listeners were connected). Retry until loaded.
task.spawn(function()
	local attempts = 0
	while not State.Loaded and attempts < 20 do
		Remotes.Get("RequestData"):FireServer()
		attempts += 1
		task.wait(1.5)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="37">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="38">
          <Properties>
            <string name="Name">AmbienceController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- AmbienceController - sky, lighting and weather per world, blended smoothly
-- as the player moves along the course.
--------------------------------------------------------------------------------

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local player = Players.LocalPlayer

local AmbienceController = {}

local rgb = Color3.fromRGB
local BLEND = TweenInfo.new(2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)

-- Keyed by Config.Worlds[i].Theme.Decor
local PRESETS = {
	Meadow = {
		Lighting = { ClockTime = 14, Brightness = 3, Ambient = rgb(120, 120, 132), OutdoorAmbient = rgb(168, 168, 180), ExposureCompensation = 0.1 },
		Atmosphere = { Density = 0.22, Color = rgb(205, 222, 245), Decay = rgb(120, 140, 170), Haze = 0.6, Glare = 0.15 },
		Color = { TintColor = rgb(255, 255, 252), Saturation = 0.3, Contrast = 0.12 },
		Weather = "Pollen",
	},
	Beach = {
		Lighting = { ClockTime = 13, Brightness = 3.2, Ambient = rgb(130, 130, 140), OutdoorAmbient = rgb(180, 180, 190), ExposureCompensation = 0.15 },
		Atmosphere = { Density = 0.2, Color = rgb(215, 235, 255), Decay = rgb(130, 170, 210), Haze = 0.5, Glare = 0.3 },
		Color = { TintColor = rgb(255, 252, 240), Saturation = 0.35, Contrast = 0.1 },
		Weather = "Sparkles",
	},
	Jungle = {
		Lighting = { ClockTime = 15, Brightness = 2.6, Ambient = rgb(95, 125, 100), OutdoorAmbient = rgb(140, 170, 140), ExposureCompensation = 0.05 },
		Atmosphere = { Density = 0.38, Color = rgb(170, 215, 190), Decay = rgb(70, 120, 90), Haze = 1.8, Glare = 0.1 },
		Color = { TintColor = rgb(240, 255, 240), Saturation = 0.3, Contrast = 0.14 },
		Weather = "Leaves",
	},
	City = {
		Lighting = { ClockTime = 18, Brightness = 2.4, Ambient = rgb(150, 110, 100), OutdoorAmbient = rgb(190, 140, 120), ExposureCompensation = 0.05 },
		Atmosphere = { Density = 0.35, Color = rgb(255, 180, 130), Decay = rgb(150, 70, 60), Haze = 1.6, Glare = 0.4 },
		Color = { TintColor = rgb(255, 236, 220), Saturation = 0.28, Contrast = 0.16 },
		Weather = "Steam",
	},
	Sky = {
		Lighting = { ClockTime = 12, Brightness = 3.4, Ambient = rgb(150, 160, 185), OutdoorAmbient = rgb(195, 205, 230), ExposureCompensation = 0.2 },
		Atmosphere = { Density = 0.3, Color = rgb(225, 238, 255), Decay = rgb(160, 190, 235), Haze = 1.2, Glare = 0.2 },
		Color = { TintColor = rgb(245, 250, 255), Saturation = 0.2, Contrast = 0.12 },
		Weather = "Wind",
	},
	Void = {
		Lighting = { ClockTime = 0, Brightness = 1.8, Ambient = rgb(118, 106, 168), OutdoorAmbient = rgb(140, 126, 192), ExposureCompensation = 0.3 },
		Atmosphere = { Density = 0.2, Color = rgb(80, 58, 140), Decay = rgb(30, 15, 72), Haze = 0.6, Glare = 0 },
		Color = { TintColor = rgb(236, 226, 255), Saturation = 0.32, Contrast = 0.14 },
		Weather = "Stars",
	},
}

local WEATHER = {
	Pollen = { Color = ColorSequence.new(rgb(255, 250, 200)), Size = 0.18, Rate = 25, Speed = NumberRange.new(0.3, 1), Accel = Vector3.new(0.6, -0.4, 0.3), Life = NumberRange.new(5, 8), Light = 0.6, Height = 12 },
	Sparkles = { Color = ColorSequence.new(rgb(255, 255, 255), rgb(170, 230, 255)), Size = 0.25, Rate = 25, Speed = NumberRange.new(0.2, 0.8), Accel = Vector3.new(0, 0.3, 0), Life = NumberRange.new(4, 7), Light = 1, Height = 6 },
	Leaves = { Color = ColorSequence.new(rgb(120, 200, 80), rgb(230, 170, 60)), Size = 0.4, Rate = 30, Speed = NumberRange.new(1, 3), Accel = Vector3.new(1.2, -2, 0.4), Life = NumberRange.new(5, 8), Light = 0.1, Height = 22 },
	Steam = { Color = ColorSequence.new(rgb(255, 240, 230)), Size = 1.2, Rate = 12, Speed = NumberRange.new(1, 2), Accel = Vector3.new(0.3, 1.5, 0), Life = NumberRange.new(3, 5), Light = 0.2, Height = -6 },
	Wind = { Color = ColorSequence.new(rgb(255, 255, 255)), Size = 0.3, Rate = 40, Speed = NumberRange.new(10, 16), Accel = Vector3.new(6, 0, 0), Life = NumberRange.new(2, 3), Light = 0.5, Height = 4 },
	Stars = { Color = ColorSequence.new(rgb(200, 220, 255), rgb(220, 160, 255)), Size = 0.22, Rate = 40, Speed = NumberRange.new(0, 0.4), Accel = Vector3.new(0, 0, 0), Life = NumberRange.new(2, 4), Light = 1, Height = 8 },
}

local currentTheme: string? = nil
local clock = Instance.new("NumberValue")
clock.Changed:Connect(function(value)
	Lighting.ClockTime = value % 24
end)
local weatherPart: Part
local emitter: ParticleEmitter
local activeTweens: { Tween } = {}
local worldStarts: { number } = {}
local drifters: { { Part: BasePart, Base: CFrame, Phase: number, Kind: string } } = {}

local function worldAt(x: number): number
	local index = 1
	for i, startX in ipairs(worldStarts) do
		if x >= startX then
			index = i
		end
	end
	return index
end

local function tween(instance: Instance?, props: { [string]: any })
	if not instance then
		return
	end
	local t = TweenService:Create(instance, BLEND, props)
	table.insert(activeTweens, t)
	t:Play()
end

local function applyWeather(name: string?)
	local spec = name and WEATHER[name]
	if not spec then
		emitter.Enabled = false
		return
	end
	emitter.Enabled = true
	emitter.Color = spec.Color
	emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, spec.Size), NumberSequenceKeypoint.new(0.8, spec.Size), NumberSequenceKeypoint.new(1, 0) })
	emitter.Rate = spec.Rate
	emitter.Speed = spec.Speed
	emitter.Acceleration = spec.Accel
	emitter.Lifetime = spec.Life
	emitter.LightEmission = spec.Light
	emitter.EmissionDirection = if spec.Height < 0 then Enum.NormalId.Top else Enum.NormalId.Bottom
	weatherPart:SetAttribute("Height", spec.Height)
end

local function applyTheme(theme: string)
	if theme == currentTheme then
		return
	end
	currentTheme = theme
	local preset = PRESETS[theme] or PRESETS.Meadow
	for _, t in ipairs(activeTweens) do
		t:Cancel()
	end
	table.clear(activeTweens)
	local lightingProps = table.clone(preset.Lighting)
	local targetClock = lightingProps.ClockTime
	lightingProps.ClockTime = nil
	local current = Lighting.ClockTime
	clock.Value = current
	local delta = ((targetClock - current + 12) % 24) - 12
	tween(clock, { Value = current + delta })
	tween(Lighting, lightingProps)
	tween(Lighting:FindFirstChildOfClass("Atmosphere"), preset.Atmosphere)
	tween(Lighting:FindFirstChild("WorldColor"), preset.Color)
	applyWeather(preset.Weather)
end

function AmbienceController.Init()
	weatherPart = Instance.new("Part")
	weatherPart.Name = "WeatherEmitter"
	weatherPart.Anchored = true
	weatherPart.CanCollide = false
	weatherPart.CanQuery = false
	weatherPart.CanTouch = false
	weatherPart.Transparency = 1
	weatherPart.Size = Vector3.new(90, 1, 90)
	weatherPart.Parent = Workspace

	emitter = Instance.new("ParticleEmitter")
	emitter.Name = "Weather"
	emitter.SpreadAngle = Vector2.new(25, 25)
	emitter.RotSpeed = NumberRange.new(-40, 40)
	emitter.Enabled = false
	emitter.Parent = weatherPart

	task.spawn(function()
		local course = Workspace:WaitForChild("Course")
		-- clouds drift and planets turn (client-side, so no network cost)
		local scenery = course:WaitForChild("Scenery", 30)
		if scenery then
			local rng = Random.new(7)
			for _, folder in ipairs(scenery:GetChildren()) do
				local name = folder.Name
				if name:find("Sky") or name:find("Void") then
					for _, part in ipairs(folder:GetChildren()) do
						if part:IsA("BasePart") and part.Size.X > 25 and #drifters < 160 then
							table.insert(drifters, { Part = part, Base = part.CFrame, Phase = rng:NextNumber(0, 6), Kind = if name:find("Void") then "Spin" else "Drift" })
						end
					end
				end
			end
		end
		for index in ipairs(Config.Worlds) do
			local startX = course:GetAttribute("World" .. index .. "StartX")
			worldStarts[index] = if type(startX) == "number" then startX else (index - 1) * 1000
		end
	end)

	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		local character = player.Character
		local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
		local camera = Workspace.CurrentCamera
		local focus = if root then root.Position elseif camera then camera.CFrame.Position else nil
		if not focus then
			return
		end
		local height = weatherPart:GetAttribute("Height")
		weatherPart.CFrame = CFrame.new(focus + Vector3.new(0, if type(height) == "number" then height else 20, 0))
		if #drifters > 0 then
			local t = os.clock()
			local parts, cframes = {}, {}
			for _, drifter in ipairs(drifters) do
				if (drifter.Base.Position - focus).Magnitude < 900 then
					table.insert(parts, drifter.Part)
					if drifter.Kind == "Spin" then
						table.insert(cframes, drifter.Base * CFrame.Angles(0, t * 0.05 + drifter.Phase, 0))
					else
						table.insert(cframes, drifter.Base * CFrame.new(math.sin(t * 0.08 + drifter.Phase) * 18, math.sin(t * 0.15 + drifter.Phase) * 3, 0))
					end
				end
			end
			if #parts > 0 then
				Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
			end
		end
		accumulator += dt
		if accumulator >= 0.5 and #worldStarts > 0 then
			accumulator = 0
			local world = Config.Worlds[worldAt(focus.X)]
			applyTheme(world.Theme.Decor)
		end
	end)
end

return AmbienceController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="39">
          <Properties>
            <string name="Name">BrainrotsUI</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- BrainrotsUI - the brainrot collection: 3D cards for every character, a
-- detail panel with speed / jump bars and the perk, and EQUIP / BUY buttons.
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)
local BrainrotBuilder = require(Shared.BrainrotBuilder)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local UIController = require(script.Parent.UIController)

local BrainrotsUI = {}

local MAX_SPEED, MAX_JUMP = 28, 70

type Card = { Button: TextButton, Stroke: UIStroke, View: ViewportFrame, Tag: Frame, TagLabel: TextLabel, Owned: boolean?, Equipped: boolean? }

local window
local grid: ScrollingFrame
local detail: Frame
local detailViewport: ViewportFrame?
local detailModel: Model?
local detailName: TextLabel
local detailRarity: TextLabel
local detailTagline: TextLabel
local speedFill: Frame
local jumpFill: Frame
local speedText: TextLabel
local jumpText: TextLabel
local perkLabel: TextLabel
local actionButton: TextButton
local hintLabel: TextLabel
local countLabel: TextLabel
local cards: { [string]: Card } = {}
local selected: string? = nil

local function isOwned(name: string): boolean
	local owned = State.Get("Owned", {})
	return owned[name] == true
end

local function unlockText(name: string): (boolean, string)
	local def = Config.Brainrots[name]
	local data = { Stats = State.Get("Stats", {}), Prestige = State.Get("Prestige", 0), Coins = State.Get("Coins", 0) }
	local ok, reason = Config.CanUnlock(name, data)
	if ok then
		return true, if def.Price > 0 then "BUY  " .. Util.FormatNumber(def.Price) else "UNLOCK FREE"
	end
	return false, reason or "Locked"
end

local function refreshDetail()
	if not selected then
		detail.Visible = false
		return
	end
	local name = selected
	local def = Config.Brainrots[name]
	if not def then
		detail.Visible = false
		return
	end
	detail.Visible = true
	local rarityColor = Config.Rarities[def.Rarity].Color
	if not detailViewport or detailViewport:GetAttribute("Key") ~= name then
		if detailViewport then
			detailViewport:Destroy()
		end
		local viewport, model = BrainrotBuilder.CreateViewport(name, { Size = UDim2.new(1, 0, 0, 170), Zoom = 0.95, Parent = detail })
		viewport:SetAttribute("Key", name)
		detailViewport = viewport
		detailModel = model
	end
	detailName.Text = name
	local oldShine = detailName:FindFirstChildOfClass("UIGradient")
	if oldShine then
		oldShine:Destroy()
	end
	local shine = UIKit.ShineFor(def.Rarity, 0)
	detailName.TextColor3 = if shine then Color3.new(1, 1, 1) else rarityColor
	if shine then
		UIKit.Shine(detailName, shine)
	end
	detailRarity.Text = string.upper(def.Rarity)
	detailRarity.TextColor3 = rarityColor
	detailTagline.Text = def.Tagline or ""
	speedFill.Size = UDim2.fromScale(math.clamp(def.Speed / MAX_SPEED, 0.05, 1), 1)
	jumpFill.Size = UDim2.fromScale(math.clamp(def.Jump / MAX_JUMP, 0.05, 1), 1)
	speedText.Text = tostring(def.Speed)
	jumpText.Text = tostring(def.Jump)
	if def.Perk then
		local perk = Config.Perks[def.Perk]
		perkLabel.Text = string.format("<font color='#FFC400'>%s</font>: %s", perk.Name, perk.Describe(def.Value))
	else
		perkLabel.Text = "<font color='#A5AAC8'>No perk. Reliable. Humble.</font>"
	end

	local owned = isOwned(name)
	local equipped = State.Get("Equipped") == name
	if owned then
		actionButton.Text = if equipped then "EQUIPPED" else "EQUIP"
		UIKit.SetButtonColor(actionButton, if equipped then UIKit.Colors.Info else UIKit.Colors.Success)
		UIKit.SetButtonEnabled(actionButton, not equipped, "EQUIPPED")
		hintLabel.Text = ""
	else
		local can, text = unlockText(name)
		actionButton.Text = if can then text else "LOCKED"
		UIKit.SetButtonColor(actionButton, if can then UIKit.Colors.Accent else UIKit.Colors.PanelLight)
		UIKit.SetButtonEnabled(actionButton, can, "LOCKED")
		hintLabel.Text = if can then "" else text
	end
end

local function select(name: string)
	selected = name
	for cardName, card in pairs(cards) do
		card.Stroke.Thickness = if cardName == name then 4 else 1.5
	end
	refreshDetail()
end

local function createCard(name: string, order: number): Card
	local def = Config.Brainrots[name]
	local rarityColor = Config.Rarities[def.Rarity].Color
	local button = UIKit.Create("TextButton", {
		Name = name,
		BackgroundColor3 = UIKit.Colors.Panel,
		BorderSizePixel = 0,
		AutoButtonColor = false,
		Text = "",
		LayoutOrder = order,
		Parent = grid,
	}) :: TextButton
	UIKit.Corner(button, 12)
	local stroke = UIKit.Stroke(button, rarityColor, 1.5)
	local backdrop = UIKit.Frame({ Position = UDim2.fromOffset(6, 6), Size = UDim2.new(1, -12, 0, 86), BackgroundColor3 = rarityColor, Parent = button })
	UIKit.Corner(backdrop, 10)
	UIKit.Gradient(backdrop, rarityColor:Lerp(Color3.new(0, 0, 0), 0.4), rarityColor:Lerp(Color3.new(0, 0, 0), 0.8), 90)
	local view = BrainrotBuilder.CreateViewport(name, { Size = UDim2.fromScale(1, 1), Parent = backdrop })
	UIKit.Label({ Position = UDim2.fromOffset(4, 96), Size = UDim2.new(1, -8, 0, 18), Text = name, TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, TextXAlignment = Enum.TextXAlignment.Center, Parent = button })
	UIKit.Label({ Position = UDim2.fromOffset(4, 114), Size = UDim2.new(1, -8, 0, 16), Text = def.Rarity, TextSize = 12, TextColor3 = rarityColor, TextXAlignment = Enum.TextXAlignment.Center, Parent = button })
	local tag = UIKit.Frame({ AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, -8), Size = UDim2.fromOffset(84, 18), BackgroundColor3 = UIKit.Colors.Success, ZIndex = 3, Visible = false, Parent = button })
	UIKit.Corner(tag, 9)
	local tagLabel = UIKit.Label({ Size = UDim2.fromScale(1, 1), Text = "EQUIPPED", TextSize = 11, Font = UIKit.Fonts.Black, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 4, Parent = tag })
	button.Activated:Connect(function()
		UIController.PlaySound("Click")
		select(name)
	end)
	return { Button = button, Stroke = stroke, View = view, Tag = tag, TagLabel = tagLabel }
end

local function refreshCards()
	local equipped = State.Get("Equipped")
	local ownedCount, total = 0, 0
	for _, entry in ipairs(Config.SortedBrainrots()) do
		local name = entry.Name
		total += 1
		local card = cards[name]
		if not card then
			card = createCard(name, total)
			cards[name] = card
		end
		local owned = isOwned(name)
		if owned then
			ownedCount += 1
		end
		local isEquipped = equipped == name
		if card.Owned ~= owned or card.Equipped ~= isEquipped then
			card.Owned = owned
			card.Equipped = isEquipped
			BrainrotBuilder.SetSilhouette(card.View, not owned)
			card.Button.BackgroundColor3 = if owned then UIKit.Colors.Panel else UIKit.Colors.PanelDark
			card.Tag.Visible = isEquipped or not owned
			if isEquipped then
				card.TagLabel.Text = "EQUIPPED"
				card.Tag.BackgroundColor3 = UIKit.Colors.Success
			elseif not owned then
				local def = Config.Brainrots[name]
				card.TagLabel.Text = if def.Unlock then "LOCKED" elseif def.Price > 0 then Util.FormatNumber(def.Price) else "FREE"
				card.Tag.BackgroundColor3 = if def.Unlock then UIKit.Colors.Danger else UIKit.Colors.Accent
			end
		end
	end
	countLabel.Text = string.format("Collected <font color='#FFC400'>%d / %d</font> brainrots", ownedCount, total)
	if not selected then
		select(equipped or Config.StarterBrainrot)
	else
		refreshDetail()
	end
end

local function buildDetail(parent: Instance)
	detail = UIKit.Frame({
		Name = "Detail",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 0, 0, 0),
		Size = UDim2.new(0, 250, 1, 0),
		BackgroundColor3 = UIKit.Colors.PanelDark,
		Visible = false,
		Parent = parent,
	})
	UIKit.Corner(detail, 12)
	UIKit.Padding(detail, 10)
	detailName = UIKit.Label({ Position = UDim2.fromOffset(0, 172), Size = UDim2.new(1, 0, 0, 28), Font = UIKit.Fonts.Display, TextSize = 22, TextStrokeColor3 = UIKit.Ink, TextStrokeTransparency = 0, TextXAlignment = Enum.TextXAlignment.Center, Parent = detail })
	detailRarity = UIKit.Label({ Position = UDim2.fromOffset(0, 200), Size = UDim2.new(1, 0, 0, 18), Font = UIKit.Fonts.Black, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Center, Parent = detail })
	detailTagline = UIKit.Label({ Position = UDim2.fromOffset(0, 218), Size = UDim2.new(1, 0, 0, 20), Font = UIKit.Fonts.Body, TextSize = 13, TextColor3 = UIKit.Colors.Muted, TextXAlignment = Enum.TextXAlignment.Center, Parent = detail })

	local function statRow(y: number, label: string, color: Color3): (Frame, TextLabel)
		UIKit.Label({ Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(60, 18), Text = label, TextSize = 13, Font = UIKit.Fonts.Black, Parent = detail })
		local bar = UIKit.Frame({ Position = UDim2.fromOffset(62, y + 3), Size = UDim2.new(1, -100, 0, 12), BackgroundColor3 = UIKit.Colors.Panel, Parent = detail })
		UIKit.Corner(bar, 6)
		local fill = UIKit.Frame({ Size = UDim2.fromScale(0.5, 1), BackgroundColor3 = color, Parent = bar })
		UIKit.Corner(fill, 6)
		local value = UIKit.Label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, y), Size = UDim2.fromOffset(34, 18), TextSize = 13, Font = UIKit.Fonts.Black, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Right, Parent = detail })
		return fill, value
	end
	speedFill, speedText = statRow(246, "SPEED", UIKit.Colors.Info)
	jumpFill, jumpText = statRow(270, "JUMP", UIKit.Colors.Success)
	perkLabel = UIKit.Label({ Position = UDim2.fromOffset(0, 296), Size = UDim2.new(1, 0, 0, 54), TextSize = 13, TextWrapped = true, TextYAlignment = Enum.TextYAlignment.Top, Parent = detail })

	actionButton = UIKit.Button({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -26), Size = UDim2.new(1, 0, 0, 44), Color = UIKit.Colors.Success, TextSize = 18, Font = UIKit.Fonts.Display }, function()
		if not selected then
			return
		end
		if isOwned(selected) then
			Remotes.Get("EquipBrainrot"):FireServer(selected)
		else
			Remotes.Get("BuyBrainrot"):FireServer(selected)
		end
		UIController.PlaySound("Click")
	end)
	actionButton.Parent = detail
	hintLabel = UIKit.Label({ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 0), Size = UDim2.new(1, 0, 0, 22), TextSize = 13, TextColor3 = UIKit.Colors.Danger, TextXAlignment = Enum.TextXAlignment.Center, Parent = detail })
end

function BrainrotsUI.Init()
	window = UIController.CreateWindow("Brainrots", "BRAINROTS", UDim2.fromOffset(820, 520), UIKit.Colors.Success)
	local content = window.Content

	countLabel = UIKit.Label({ Size = UDim2.new(1, -260, 0, 24), TextSize = 17, Parent = content })
	local gridHolder = UIKit.Frame({ Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, -262, 1, -30), BackgroundColor3 = UIKit.Colors.PanelDark, Parent = content })
	UIKit.Corner(gridHolder, 12)
	UIKit.Padding(gridHolder, 10)
	grid = UIKit.ScrollGrid(gridHolder, UDim2.fromOffset(116, 136), 10)
	buildDetail(content)

	window.OnOpen = refreshCards
	State.Changed:Connect(function(patch)
		if patch.Owned ~= nil or patch.Equipped ~= nil or patch.Coins ~= nil or patch.Stats ~= nil or patch.Prestige ~= nil then
			if window.IsOpen() then
				refreshCards()
			end
		end
	end)

	RunService.RenderStepped:Connect(function()
		if detailModel and window.IsOpen() and detail.Visible then
			detailModel:PivotTo(CFrame.Angles(0, os.clock() * 0.8, 0))
		end
	end)

	UIController.AddSideButton("Brainrots", "BRAINROTS", UIKit.Colors.Success, 1, function()
		UIController.Toggle("Brainrots")
	end)
end

return BrainrotsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="40">
          <Properties>
            <string name="Name">ChatController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- ChatController - adds a [VIP] tag in chat for VIP gamepass owners.
-- (Social proof: other players see VIP tags and want one too.)
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local TextChatService = game:GetService("TextChatService")

local ChatController = {}

function ChatController.Init()
	if TextChatService.ChatVersion ~= Enum.ChatVersion.TextChatService then
		return
	end
	TextChatService.OnIncomingMessage = function(message: TextChatMessage)
		local properties = Instance.new("TextChatMessageProperties")
		local source = message.TextSource
		if source then
			local sender = Players:GetPlayerByUserId(source.UserId)
			if sender and sender:GetAttribute("VIP") then
				properties.PrefixText = "<font color='#FFAA00'>[VIP]</font> " .. message.PrefixText
			end
		end
		return properties
	end
end

return ChatController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="41">
          <Properties>
            <string name="Name">CoinController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- CoinController - spinning coins, walk-over (or magnet) pickup, local hiding
-- with the same respawn timer as the server, and "+coins" popups.
--------------------------------------------------------------------------------

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local FloatingText = require(Modules.FloatingText)
local UIController = require(script.Parent.UIController)

local player = Players.LocalPlayer

local CoinController = {}

local ANIMATE_DISTANCE = 120
local GOLD = Color3.fromRGB(255, 215, 60)

type Info = { Base: CFrame, Phase: number, HiddenUntil: number, Id: string }
local coins: { [BasePart]: Info } = {}
local byId: { [string]: BasePart } = {}
local burstPart: Part
local burst: ParticleEmitter

local function track(coin: Instance)
	if not coin:IsA("BasePart") then
		return
	end
	local id = coin:GetAttribute("CoinId")
	if type(id) ~= "string" then
		return
	end
	coins[coin] = { Base = coin.CFrame, Phase = math.random() * math.pi * 2, HiddenUntil = 0, Id = id }
	byId[id] = coin
end

local function setHidden(coin: BasePart, hidden: boolean)
	coin.Transparency = if hidden then 1 else 0
end

local fragments: { [BasePart]: { Id: string, Base: CFrame, Phase: number } } = {}

local function trackFragment(shard: Instance)
	if shard:IsA("BasePart") then
		local id = shard:GetAttribute("FragmentId")
		if type(id) == "string" then
			fragments[shard] = { Id = id, Base = shard.CFrame, Phase = math.random() * 6 }
		end
	end
end

local function stepFragments(root: BasePart)
	local found = State.Get("Fragments", {})
	for shard, info in pairs(fragments) do
		local taken = found[info.Id] == true
		shard.Transparency = if taken then 1 else 0
		if not taken and (shard.Position - root.Position).Magnitude <= Config.Coins.PickupRadius + 1 then
			Remotes.Get("CollectFragment"):FireServer(info.Id)
		end
	end
end

local function step()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or not State.Loaded then
		return
	end
	local radius = Config.Coins.PickupRadius + (State.GetPerk("Magnet") or 0)
	local now = os.clock()
	stepFragments(root)
	for coin, info in pairs(coins) do
		if info.HiddenUntil > 0 and now >= info.HiddenUntil then
			info.HiddenUntil = 0
			setHidden(coin, false)
		elseif info.HiddenUntil == 0 and (coin.Position - root.Position).Magnitude <= radius then
			info.HiddenUntil = now + Config.Coins.RespawnSeconds
			setHidden(coin, true)
			Remotes.Get("CollectCoin"):FireServer(info.Id)
		end
	end
end

local function animate()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local cameraPosition = camera.CFrame.Position
	local t = os.clock()
	local parts, cframes = {}, {}
	for coin, info in pairs(coins) do
		if info.HiddenUntil == 0 and (info.Base.Position - cameraPosition).Magnitude < ANIMATE_DISTANCE then
			table.insert(parts, coin)
			table.insert(cframes, info.Base * CFrame.new(0, math.sin(t * 2.5 + info.Phase) * 0.35, 0) * CFrame.Angles(t * 2 + info.Phase, 0, 0))
		end
	end
	for shard, info in pairs(fragments) do
		if shard.Transparency < 1 and (info.Base.Position - cameraPosition).Magnitude < ANIMATE_DISTANCE then
			table.insert(parts, shard)
			table.insert(cframes, info.Base * CFrame.new(0, math.sin(t * 2 + info.Phase) * 0.5, 0) * CFrame.Angles(0, t * 1.5, 0))
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

local function onFragmentTaken(id: string, reward: number)
	for shard, info in pairs(fragments) do
		if info.Id == id then
			burstPart.CFrame = CFrame.new(shard.Position)
			burst.Color = ColorSequence.new(Color3.fromRGB(200, 120, 255), Color3.new(1, 1, 1))
			burst:Emit(40)
			burst.Color = ColorSequence.new(GOLD, Color3.new(1, 1, 1))
			FloatingText.Show(shard.Position, "FRAGMENT! +" .. Util.FormatNumber(reward), Color3.fromRGB(220, 150, 255), Vector2.new(220, 56))
			UIController.PlaySound("Checkpoint", 0.6)
		end
	end
end

local function onTaken(coinId: string, amount: number)
	local coin = byId[coinId]
	if not coin then
		return
	end
	burstPart.CFrame = CFrame.new(coin.Position)
	local lucky = coin:GetAttribute("Lucky") == true
	burst:Emit(if lucky then 40 else 10)
	FloatingText.Show(coin.Position, (if lucky then "LUCKY! +" else "+") .. Util.FormatNumber(amount), GOLD, if lucky then Vector2.new(220, 56) else nil)
	UIController.PlaySound("Coin", 0.4)
end

function CoinController.Init()
	burstPart = Instance.new("Part")
	burstPart.Name = "CoinBurst"
	burstPart.Anchored = true
	burstPart.CanCollide = false
	burstPart.CanQuery = false
	burstPart.CanTouch = false
	burstPart.Transparency = 1
	burstPart.Size = Vector3.new(1, 1, 1)
	burstPart.Parent = Workspace
	burst = Instance.new("ParticleEmitter")
	burst.Rate = 0
	burst.Color = ColorSequence.new(GOLD, Color3.new(1, 1, 1))
	burst.LightEmission = 1
	burst.Lifetime = NumberRange.new(0.3, 0.6)
	burst.Speed = NumberRange.new(8, 14)
	burst.Drag = 6
	burst.SpreadAngle = Vector2.new(180, 180)
	burst.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 0) })
	burst.Parent = burstPart

	for _, coin in ipairs(CollectionService:GetTagged("Coin")) do
		track(coin)
	end
	CollectionService:GetInstanceAddedSignal("Coin"):Connect(track)

	for _, shard in ipairs(CollectionService:GetTagged("Fragment")) do
		trackFragment(shard)
	end
	Remotes.Get("CoinTaken").OnClientEvent:Connect(onTaken)
	Remotes.Get("FragmentTaken").OnClientEvent:Connect(onFragmentTaken)
	RunService.Heartbeat:Connect(step)
	RunService.RenderStepped:Connect(animate)
end

return CoinController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="42">
          <Properties>
            <string name="Name">EventUI</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- EventUI - shows the running server event (or the countdown to the next one)
-- and celebrates when an event starts.
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local UIController = require(script.Parent.UIController)
local ObbyFxController = require(script.Parent.ObbyFxController)

local EventUI = {}

local chip: Frame
local label: TextLabel
local stroke: UIStroke

local function refresh()
	local name = ReplicatedStorage:GetAttribute("EventName")
	local now = State.Now()
	local event = type(name) == "string" and Config.Events.List[name] or nil
	if event then
		local endsAt = ReplicatedStorage:GetAttribute("EventEndsAt")
		local left = if type(endsAt) == "number" then math.max(0, endsAt - now) else 0
		label.Text = string.format("%s  %s", event.Name, Util.FormatTime(left))
		label.TextColor3 = event.Color
		stroke.Color = event.Color
		chip.Visible = true
	else
		local nextAt = ReplicatedStorage:GetAttribute("NextEventAt")
		if type(nextAt) == "number" then
			label.Text = "Next event in " .. Util.FormatTime(math.max(0, nextAt - now))
			label.TextColor3 = UIKit.Colors.Muted
			stroke.Color = UIKit.Colors.Stroke
			chip.Visible = true
		else
			chip.Visible = false
		end
	end
end

function EventUI.Init()
	chip = UIKit.Frame({
		Name = "EventChip",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 66),
		Size = UDim2.fromOffset(250, 30),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.2,
		Visible = false,
		Parent = UIController.Root,
	})
	UIKit.Corner(chip, 15)
	stroke = UIKit.Stroke(chip, UIKit.Colors.Stroke, 2)
	label = UIKit.Label({ Size = UDim2.fromScale(1, 1), TextSize = 15, Font = UIKit.Fonts.Black, TextXAlignment = Enum.TextXAlignment.Center, Parent = chip })

	ReplicatedStorage:GetAttributeChangedSignal("EventName"):Connect(function()
		local name = ReplicatedStorage:GetAttribute("EventName")
		local event = type(name) == "string" and Config.Events.List[name] or nil
		if event then
			UIController.Banner(event.Name .. "!", event.Description, event.Color)
			ObbyFxController.Confetti(80)
		end
		refresh()
	end)
	task.spawn(function()
		while true do
			refresh()
			task.wait(1)
		end
	end)
end

return EventUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="43">
          <Properties>
            <string name="Name">IntroController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- IntroController - a short camera sweep over the lobby with the game's title
-- when you join, so the first thing new players see is the whole course.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local UIKit = require(Modules.UIKit)
local UIController = require(script.Parent.UIController)

local player = Players.LocalPlayer

local IntroController = {}

local DURATION = 4.5

local function play()
	local camera = Workspace.CurrentCamera
	local course = Workspace:WaitForChild("Course", 20)
	if not camera or not course then
		return
	end
	local character = player.Character or player.CharacterAdded:Wait()
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root then
		return
	end
	-- sweep from high above the lobby down toward the player
	local lobbyX = -Config.Course.LobbyLength / 2
	local startCF = CFrame.lookAt(Vector3.new(lobbyX - 120, 110, -160), Vector3.new(200, 20, 0))
	local endCF = CFrame.lookAt(root.Position + Vector3.new(-14, 8, -14), root.Position + Vector3.new(6, 2, 0))
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = startCF
	local tween = TweenService:Create(camera, TweenInfo.new(DURATION, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), { CFrame = endCF })
	tween:Play()

	-- title splash
	local holder = UIKit.Frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.32), Size = UDim2.fromOffset(900, 220), BackgroundTransparency = 1, ZIndex = 160, Parent = UIController.Root })
	local title = UIKit.Label({ Size = UDim2.new(1, 0, 0, 130), Text = string.upper(Config.GameName), Font = UIKit.Fonts.Display, TextSize = 110, TextColor3 = Color3.fromRGB(255, 215, 60), TextStrokeColor3 = UIKit.Ink, TextStrokeTransparency = 0, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 161, Parent = holder })
	UIKit.Shine(title, "Gold")
	local sub = UIKit.Label({ Position = UDim2.fromOffset(0, 135), Size = UDim2.new(1, 0, 0, 50), Text = string.format("%d stages  -  %d worlds  -  collect every brainrot", Config.TotalStages(), #Config.Worlds), Font = UIKit.Fonts.Title, TextSize = 30, TextStrokeColor3 = UIKit.Ink, TextStrokeTransparency = 0, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 161, Parent = holder })
	local scale = UIKit.Create("UIScale", { Scale = 0.3, Parent = holder })
	TweenService:Create(scale, TweenInfo.new(0.7, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()

	local skip = UIKit.Button({ AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -20, 1, -20), Size = UDim2.fromOffset(120, 40), Color = UIKit.Colors.PanelLight, Text = "SKIP", TextSize = 16, ZIndex = 161 }, function()
		tween:Cancel()
	end)
	skip.Parent = UIController.Root

	tween.Completed:Wait()
	camera.CameraType = Enum.CameraType.Custom
	skip:Destroy()
	UIKit.Tween(title, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.5)
	UIKit.Tween(sub, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.5)
	task.delay(0.55, function()
		holder:Destroy()
	end)
end

function IntroController.Init()
	task.spawn(function()
		local ok, err = pcall(play)
		if not ok then
			warn("[Intro] " .. tostring(err))
			local camera = Workspace.CurrentCamera
			if camera then
				camera.CameraType = Enum.CameraType.Custom
			end
		end
	end)
end

return IntroController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="44">
          <Properties>
            <string name="Name">MovementController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- MovementController - brainrot perks that run on the client (the player owns
-- their own physics): double jump, dash, glide, plus jump pads. The server
-- still validates checkpoint timing against the brainrot's speed.
--------------------------------------------------------------------------------

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local UIController = require(script.Parent.UIController)

local player = Players.LocalPlayer

local MovementController = {}

local humanoid: Humanoid? = nil
local root: BasePart? = nil
local canDoubleJump = false
local jumpHeld = false
local lastDash = -math.huge
local lastPad: { [BasePart]: number } = {}
local windZones: { BasePart } = {}
local dashButton: TextButton
local dashCooldownFill: Frame

local function setCharacter(character: Model)
	humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	root = character:WaitForChild("HumanoidRootPart", 10) :: BasePart?
	canDoubleJump = false
	if humanoid then
		humanoid.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Landed or new == Enum.HumanoidStateType.Running then
				canDoubleJump = true
			elseif new == Enum.HumanoidStateType.Jumping then
				-- the first jump is the normal one; a second press in the air double jumps
				task.delay(0.15, function()
					canDoubleJump = true
				end)
			end
		end)
		-- jump pads: launch when touching a pad
		for _, part in ipairs(character:GetDescendants()) do
			if part:IsA("BasePart") then
				part.Touched:Connect(function(hit)
					local launch = hit:GetAttribute("Launch")
					if typeof(launch) == "Vector3" and root and os.clock() - (lastPad[hit] or 0) > 0.8 then
						lastPad[hit] = os.clock()
						-- forward is +X along the course; pads always point that way
						root.AssemblyLinearVelocity = Vector3.new(launch.X, launch.Y, launch.Z)
						UIController.PlaySound("Jump", 0.6)
					end
				end)
			end
		end
	end
end

local function tryDoubleJump()
	local power = State.GetPerk("DoubleJump")
	if not power or not humanoid or not root or not canDoubleJump then
		return
	end
	local state = humanoid:GetState()
	if state ~= Enum.HumanoidStateType.Freefall and state ~= Enum.HumanoidStateType.Jumping then
		return
	end
	canDoubleJump = false
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(velocity.X, humanoid.JumpPower * power, velocity.Z)
	humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
	UIController.PlaySound("Jump", 0.5)
end

local function tryDash()
	local speed = State.GetPerk("Dash")
	if not speed or not humanoid or not root then
		return
	end
	if os.clock() - lastDash < Config.DashCooldown then
		return
	end
	lastDash = os.clock()
	local direction = humanoid.MoveDirection
	if direction.Magnitude < 0.1 then
		direction = root.CFrame.LookVector * Vector3.new(1, 0, 1)
	end
	direction = direction.Unit
	local velocity = root.AssemblyLinearVelocity
	root.AssemblyLinearVelocity = Vector3.new(direction.X * speed, math.max(velocity.Y, 8), direction.Z * speed)
	UIController.PlaySound("Jump", 0.5)
end

local function onJumpAction(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		jumpHeld = true
		tryDoubleJump()
	elseif inputState == Enum.UserInputState.End then
		jumpHeld = false
	end
	return Enum.ContextActionResult.Pass
end

local function onDashAction(_, inputState)
	if inputState == Enum.UserInputState.Begin then
		tryDash()
	end
	return Enum.ContextActionResult.Pass
end

local function insideZone(zone: BasePart, position: Vector3): boolean
	local rel = zone.CFrame:PointToObjectSpace(position)
	local half = zone.Size / 2
	return math.abs(rel.X) <= half.X and math.abs(rel.Y) <= half.Y and math.abs(rel.Z) <= half.Z
end

-- Glide: while holding jump in the air, fall slower. Wind zones push sideways.
local function step(dt: number)
	if root then
		for _, zone in ipairs(windZones) do
			if insideZone(zone, root.Position) then
				local wind = zone:GetAttribute("Wind")
				if typeof(wind) == "Vector3" then
					root.AssemblyLinearVelocity += wind * dt * 2.2
				end
			end
		end
	end
	local glide = State.GetPerk("Glide")
	if glide and jumpHeld and humanoid and root and humanoid:GetState() == Enum.HumanoidStateType.Freefall then
		local velocity = root.AssemblyLinearVelocity
		local maxFall = -Workspace.Gravity * 0.12 * (1 - glide) * 2.5 - 6
		if velocity.Y < maxFall then
			root.AssemblyLinearVelocity = Vector3.new(velocity.X, maxFall, velocity.Z)
		end
	end
	-- dash button cooldown fill
	if dashButton.Visible then
		local k = math.clamp((os.clock() - lastDash) / Config.DashCooldown, 0, 1)
		dashCooldownFill.Size = UDim2.fromScale(k, 1)
	end
end

local function refreshDashButton()
	local hasDash = State.GetPerk("Dash") ~= nil
	dashButton.Visible = hasDash
end

function MovementController.Init()
	dashButton = UIKit.Button({
		Name = "Dash",
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, -24, 1, -110),
		Size = UDim2.fromOffset(96, 96),
		Color = UIKit.Colors.Pink,
		Text = "DASH\n(Q)",
		Font = UIKit.Fonts.Display,
		TextSize = 22,
		Radius = 48,
		Visible = false,
	}, tryDash)
	dashButton.Parent = UIController.Root
	local cooldownBar = UIKit.Frame({ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(0.7, 0, 0, 8), BackgroundColor3 = UIKit.Colors.Background, Parent = dashButton })
	UIKit.Corner(cooldownBar, 4)
	dashCooldownFill = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), Parent = cooldownBar })
	UIKit.Corner(dashCooldownFill, 4)
	if not UserInputService.TouchEnabled then
		dashButton.Text = "DASH\n(Q)"
	else
		dashButton.Text = "DASH"
	end

	ContextActionService:BindAction("BrainrotJump", onJumpAction, false, Enum.KeyCode.Space, Enum.KeyCode.ButtonA)
	ContextActionService:BindAction("BrainrotDash", onDashAction, false, Enum.KeyCode.Q, Enum.KeyCode.ButtonX)
	-- mobile jump button goes through the Humanoid.Jump property
	task.spawn(function()
		local course = Workspace:WaitForChild("Course", 30)
		if course then
			for _, part in ipairs(course:GetDescendants()) do
				if part:IsA("BasePart") and part:GetAttribute("Wind") then
					table.insert(windZones, part)
				end
			end
		end
	end)

	RunService.RenderStepped:Connect(function(dt)
		if humanoid then
			local jumping = humanoid.Jump
			if jumping and not jumpHeld then
				jumpHeld = true
				tryDoubleJump()
			elseif not jumping and jumpHeld and not UserInputService:IsKeyDown(Enum.KeyCode.Space) then
				jumpHeld = false
			end
		end
		step(dt)
	end)

	if player.Character then
		task.spawn(setCharacter, player.Character)
	end
	player.CharacterAdded:Connect(setCharacter)

	State.OnLoaded(refreshDashButton)
	State.Changed:Connect(function(patch)
		if patch.Equipped ~= nil or patch.Gamepasses ~= nil then
			refreshDashButton()
		end
	end)
end

return MovementController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="45">
          <Properties>
            <string name="Name">ObbyFxController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- ObbyFxController - the juice: checkpoint celebrations, world banners,
-- death flash, prestige confetti and pulsing checkpoint rings.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local FloatingText = require(Modules.FloatingText)
local UIController = require(script.Parent.UIController)

local player = Players.LocalPlayer

local ObbyFxController = {}

local fxPart: Part
local confetti: ParticleEmitter
local CONFETTI_COLORS = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 90, 140)),
	ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 220, 70)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(90, 220, 255)),
	ColorSequenceKeypoint.new(0.75, Color3.fromRGB(140, 240, 120)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(200, 120, 255)),
})

local function effectsOn(): boolean
	local settings = State.Get("Settings", {})
	return settings.Effects ~= false
end

local function rootPosition(): Vector3?
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart") :: BasePart?
	return root and root.Position
end

function ObbyFxController.Confetti(amount: number?)
	local position = rootPosition()
	if not position or not effectsOn() then
		return
	end
	fxPart.CFrame = CFrame.new(position + Vector3.new(0, 4, 0))
	confetti:Emit(amount or 80)
end

local function screenFlash(color: Color3, transparency: number)
	if not effectsOn() then
		return
	end
	local flash = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = color, BackgroundTransparency = transparency, ZIndex = 140, Parent = UIController.Root })
	UIKit.Tween(flash, { BackgroundTransparency = 1 }, 0.6)
	task.delay(0.65, function()
		flash:Destroy()
	end)
end

local function onStageReached(stage: number, isNew: boolean, reward: number)
	local world, worldIndex = Config.GetWorld(stage)
	local _, inWorld = Config.GetWorldForStage(stage)
	UIController.PlaySound("Checkpoint", 0.6)
	local position = rootPosition()
	if position and isNew and reward > 0 then
		FloatingText.Show(position + Vector3.new(0, 3, 0), "+" .. Util.FormatNumber(reward), Color3.fromRGB(255, 215, 60), Vector2.new(170, 48))
	end
	if inWorld == 1 and stage > 1 then
		UIController.Banner("WORLD " .. worldIndex, world.Name, world.Theme.Accent)
		ObbyFxController.Confetti(120)
		screenFlash(world.Theme.Accent, 0.6)
	elseif isNew then
		ObbyFxController.Confetti(25)
		if stage % 10 == 0 then
			UIController.Banner("STAGE " .. stage .. "!", "Keep going!", Color3.fromRGB(255, 220, 80))
		end
	end
end

local function watchCharacter(character: Model)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if humanoid then
		humanoid.Died:Connect(function()
			screenFlash(Color3.fromRGB(255, 60, 60), 0.55)
			UIController.PlaySound("Death", 0.5)
		end)
	end
end

local rings: { BasePart } = {}
local ringBase: { [BasePart]: CFrame } = {}
local beacon: Part
local checkpointPads: { [number]: Vector3 } = {}

local function pulseRings()
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	local t = os.clock()
	local cameraPosition = camera.CFrame.Position
	local current = State.Get("Stage", 1)
	local parts, cframes = {}, {}
	for _, ring in ipairs(rings) do
		local base = ringBase[ring]
		if base and (base.Position - cameraPosition).Magnitude < 150 then
			local stage = ring.Parent and ring.Parent:GetAttribute("Stage")
			local isNext = stage == current + 1
			ring.Transparency = if isNext then 0.1 + math.sin(t * 5) * 0.1 else 0.45
			ring.Color = if isNext then Color3.fromRGB(255, 240, 120) elseif stage and stage <= current then Color3.fromRGB(110, 235, 120) else ring.Color
			table.insert(parts, ring)
			table.insert(cframes, base * CFrame.new(math.sin(t * 2) * 0.15, 0, 0) * CFrame.Angles(t * 0.8, 0, 0))
		end
	end
	if #parts > 0 then
		Workspace:BulkMoveTo(parts, cframes, Enum.BulkMoveMode.FireCFrameChanged)
	end
	-- a tall light column over the next checkpoint
	local target = checkpointPads[current + 1]
	if target then
		beacon.CFrame = CFrame.new(target + Vector3.new(0, 40, 0))
		beacon.Transparency = 0.6 + math.sin(t * 3) * 0.1
		beacon.Parent = Workspace
	else
		beacon.Parent = nil
	end
end

function ObbyFxController.Init()
	fxPart = Instance.new("Part")
	fxPart.Name = "CelebrationFx"
	fxPart.Anchored = true
	fxPart.CanCollide = false
	fxPart.CanQuery = false
	fxPart.CanTouch = false
	fxPart.Transparency = 1
	fxPart.Size = Vector3.new(2, 2, 2)
	fxPart.Parent = Workspace

	confetti = Instance.new("ParticleEmitter")
	confetti.Rate = 0
	confetti.Color = CONFETTI_COLORS
	confetti.Lifetime = NumberRange.new(1.4, 2.4)
	confetti.Speed = NumberRange.new(16, 28)
	confetti.SpreadAngle = Vector2.new(55, 55)
	confetti.Acceleration = Vector3.new(0, -26, 0)
	confetti.Drag = 1.5
	confetti.RotSpeed = NumberRange.new(-300, 300)
	confetti.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 0.35) })
	confetti.LightEmission = 0.4
	confetti.EmissionDirection = Enum.NormalId.Top
	confetti.Parent = fxPart

	Remotes.Get("StageReached").OnClientEvent:Connect(onStageReached)

	if player.Character then
		task.spawn(watchCharacter, player.Character)
	end
	player.CharacterAdded:Connect(watchCharacter)

	local lastPrestige: number? = nil
	State.OnLoaded(function()
		lastPrestige = State.Get("Prestige", 0)
	end)
	State.Changed:Connect(function(patch)
		if patch.Prestige ~= nil and lastPrestige ~= nil and patch.Prestige > lastPrestige then
			lastPrestige = patch.Prestige
			UIController.Banner("PRESTIGE " .. patch.Prestige .. "!", "+" .. math.floor(Config.Prestige.CoinMultiplierPerPrestige * 100) .. "% coins forever", Color3.fromRGB(255, 110, 190))
			ObbyFxController.Confetti(200)
			screenFlash(Color3.fromRGB(255, 120, 220), 0.5)
		end
	end)

	beacon = Instance.new("Part")
	beacon.Name = "NextCheckpointBeacon"
	beacon.Anchored = true
	beacon.CanCollide = false
	beacon.CanQuery = false
	beacon.CanTouch = false
	beacon.CastShadow = false
	beacon.Material = Enum.Material.Neon
	beacon.Color = Color3.fromRGB(255, 240, 120)
	beacon.Size = Vector3.new(2.5, 80, 2.5)
	beacon.Transparency = 0.65
	local mesh = Instance.new("SpecialMesh")
	mesh.MeshType = Enum.MeshType.Cylinder
	mesh.Parent = beacon

	task.spawn(function()
		local course = Workspace:WaitForChild("Course")
		for _, descendant in ipairs(course:GetDescendants()) do
			if descendant:IsA("BasePart") and descendant.Name == "CheckpointRing" then
				table.insert(rings, descendant)
				ringBase[descendant] = descendant.CFrame
			elseif descendant:IsA("BasePart") and descendant.Name == "Checkpoint" then
				local stage = descendant:GetAttribute("Stage")
				if type(stage) == "number" then
					checkpointPads[stage] = descendant.Position
				end
			end
		end
	end)
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.1 then
			accumulator = 0
			pulseRings()
		end
	end)
end

return ObbyFxController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="46">
          <Properties>
            <string name="Name">PlayerVisualsController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- PlayerVisualsController - what makes characters feel alive:
--   name tags over every player (brainrot, rarity colour, stage),
--   a cartoon outline on your own costume,
--   landing dust, and a death explosion that flings costume pieces around.
--------------------------------------------------------------------------------

local Debris = game:GetService("Debris")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)

local player = Players.LocalPlayer

local PlayerVisualsController = {}

local INK = Color3.fromRGB(28, 22, 40)
local tags: { [Player]: { Name: TextLabel, Stage: TextLabel } } = {}
local dustPart: Part
local dust: ParticleEmitter

local function effectsOn(): boolean
	local settings = State.Get("Settings", {})
	return settings.Effects ~= false
end

--------------------------------------------------------------------------------
-- Name tags
--------------------------------------------------------------------------------

local function refreshTag(target: Player)
	local tag = tags[target]
	if not tag then
		return
	end
	local brainrot = target:GetAttribute("Brainrot")
	local def = type(brainrot) == "string" and Config.Brainrots[brainrot] or nil
	local color = if def then Config.Rarities[def.Rarity].Color:Lerp(Color3.new(1, 1, 1), 0.3) else Color3.new(1, 1, 1)
	tag.Name.Text = target.DisplayName .. (if def then "  -  " .. brainrot else "")
	tag.Name.TextColor3 = color
	local oldShine = tag.Name:FindFirstChildOfClass("UIGradient")
	if oldShine then
		oldShine:Destroy()
	end
	local shine = def and UIKit.ShineFor(def.Rarity, 0) or nil
	if shine then
		tag.Name.TextColor3 = Color3.new(1, 1, 1)
		UIKit.Shine(tag.Name, shine)
	end
	local leaderstats = target:FindFirstChild("leaderstats")
	local stage = leaderstats and leaderstats:FindFirstChild("Stage")
	local prestige = leaderstats and leaderstats:FindFirstChild("Prestige")
	local stageText = if stage and stage:IsA("IntValue") then "Stage " .. stage.Value else ""
	if prestige and prestige:IsA("IntValue") and prestige.Value > 0 then
		stageText ..= "  -  Prestige " .. prestige.Value
	end
	tag.Stage.Text = stageText
end

local function addTag(target: Player, character: Model)
	local head = character:WaitForChild("Head", 10)
	if not head then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "NameTag"
	gui.Size = UDim2.new(6, 0, 1.6, 0)
	gui.StudsOffset = Vector3.new(0, 4.2, 0)
	gui.MaxDistance = if target == player then 0 else 70
	gui.LightInfluence = 0
	gui.Adornee = head
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1
	name.Size = UDim2.fromScale(1, 0.6)
	name.Font = Enum.Font.FredokaOne
	name.TextScaled = true
	name.TextStrokeTransparency = 0
	name.TextStrokeColor3 = INK
	name.Parent = gui
	local stage = Instance.new("TextLabel")
	stage.BackgroundTransparency = 1
	stage.Position = UDim2.fromScale(0, 0.6)
	stage.Size = UDim2.fromScale(1, 0.4)
	stage.Font = Enum.Font.LuckiestGuy
	stage.TextScaled = true
	stage.TextColor3 = Color3.fromRGB(255, 225, 90)
	stage.TextStrokeTransparency = 0
	stage.TextStrokeColor3 = INK
	stage.Parent = gui
	gui.Parent = head
	tags[target] = { Name = name, Stage = stage }
	refreshTag(target)
	-- hide the default Roblox name (we draw our own)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid then
		humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	end
end

--------------------------------------------------------------------------------
-- Outline on my own costume
--------------------------------------------------------------------------------

local outline: Highlight

local function attachOutline(character: Model)
	local costume = character:WaitForChild("Costume", 10)
	if costume then
		outline.Adornee = costume
		outline.Enabled = true
	end
	character.ChildAdded:Connect(function(child)
		if child.Name == "Costume" then
			outline.Adornee = child
			outline.Enabled = true
		end
	end)
end

--------------------------------------------------------------------------------
-- Dust and death explosion
--------------------------------------------------------------------------------

local function puff(position: Vector3, amount: number)
	if not effectsOn() then
		return
	end
	dustPart.CFrame = CFrame.new(position)
	dust:Emit(amount)
end

local function explode(character: Model)
	if not effectsOn() then
		return
	end
	local costume = character:FindFirstChild("Costume")
	local root = character:FindFirstChild("HumanoidRootPart")
	if not costume or not root or not root:IsA("BasePart") then
		return
	end
	local rng = Random.new()
	local count = 0
	for _, part in ipairs(costume:GetDescendants()) do
		if part:IsA("BasePart") and part.Transparency < 1 and count < 24 then
			count += 1
			local chunk = part:Clone()
			for _, child in ipairs(chunk:GetChildren()) do
				if not child:IsA("SpecialMesh") then
					child:Destroy()
				end
			end
			chunk.Anchored = false
			chunk.CanCollide = true
			chunk.CanQuery = false
			chunk.CanTouch = false
			chunk.Massless = false
			chunk.Parent = Workspace
			chunk.AssemblyLinearVelocity = Vector3.new(rng:NextNumber(-25, 25), rng:NextNumber(20, 45), rng:NextNumber(-25, 25))
			chunk.AssemblyAngularVelocity = Vector3.new(rng:NextNumber(-10, 10), rng:NextNumber(-10, 10), rng:NextNumber(-10, 10))
			Debris:AddItem(chunk, 2.5)
		end
	end
	puff(root.Position, 20)
end

local function watchCharacter(target: Player, character: Model)
	addTag(target, character)
	local humanoid = character:WaitForChild("Humanoid", 10) :: Humanoid?
	if not humanoid then
		return
	end
	humanoid.Died:Connect(function()
		explode(character)
	end)
	if target == player then
		attachOutline(character)
		humanoid.StateChanged:Connect(function(_, new)
			if new == Enum.HumanoidStateType.Landed then
				local root = character:FindFirstChild("HumanoidRootPart")
				if root and root:IsA("BasePart") then
					puff(root.Position - Vector3.new(0, 2.6, 0), 8)
				end
			end
		end)
	end
end

local function watch(target: Player)
	target.CharacterAdded:Connect(function(character)
		watchCharacter(target, character)
	end)
	if target.Character then
		task.spawn(watchCharacter, target, target.Character)
	end
	target:GetAttributeChangedSignal("Brainrot"):Connect(function()
		refreshTag(target)
	end)
end

function PlayerVisualsController.Init()
	dustPart = Instance.new("Part")
	dustPart.Name = "DustFx"
	dustPart.Anchored = true
	dustPart.CanCollide = false
	dustPart.CanQuery = false
	dustPart.CanTouch = false
	dustPart.Transparency = 1
	dustPart.Size = Vector3.new(1, 1, 1)
	dustPart.Parent = Workspace
	dust = Instance.new("ParticleEmitter")
	dust.Rate = 0
	dust.Color = ColorSequence.new(Color3.fromRGB(240, 235, 225))
	dust.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
	dust.Lifetime = NumberRange.new(0.4, 0.7)
	dust.Speed = NumberRange.new(4, 9)
	dust.SpreadAngle = Vector2.new(70, 70)
	dust.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.8), NumberSequenceKeypoint.new(1, 1.6) })
	dust.EmissionDirection = Enum.NormalId.Top
	dust.Parent = dustPart

	outline = Instance.new("Highlight")
	outline.Name = "CostumeOutline"
	outline.FillTransparency = 1
	outline.OutlineColor = INK
	outline.OutlineTransparency = 0.1
	outline.DepthMode = Enum.HighlightDepthMode.Occluded
	outline.Enabled = false
	outline.Parent = dustPart

	for _, target in ipairs(Players:GetPlayers()) do
		watch(target)
	end
	Players.PlayerAdded:Connect(watch)
	Players.PlayerRemoving:Connect(function(target)
		tags[target] = nil
	end)

	-- stage numbers on tags change often; refresh them a few times a second
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 0.5 then
			accumulator = 0
			for target in pairs(tags) do
				refreshTag(target)
			end
		end
	end)
end

return PlayerVisualsController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="47">
          <Properties>
            <string name="Name">QuestsUI</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- QuestsUI - daily quests window plus a compact on-screen tracker.
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local RewardText = require(Modules.RewardText)
local UIController = require(script.Parent.UIController)

local QuestsUI = {}

type Row = { Frame: Frame, Title: TextLabel, Fill: Frame, Count: TextLabel, Reward: TextLabel, Button: TextButton }

local window
local rows: { Row } = {}
local bonusLabel: TextLabel
local resetLabel: TextLabel
local tracker: Frame
local trackerRows: { { Label: TextLabel, Fill: Frame } } = {}

local function questState()
	local quests = State.Get("Quests")
	local stats = State.Get("Stats", {})
	local list = {}
	if not quests or not quests.Ids then
		return list, quests
	end
	for slot, id in ipairs(quests.Ids) do
		local quest = Config.GetQuest(id)
		if quest then
			local raw = (stats[quest.Stat] or 0) - ((quests.Baseline or {})[quest.Stat] or 0)
			local progress = math.clamp(math.floor(raw / (quest.Scale or 1)), 0, quest.Goal)
			table.insert(list, {
				Slot = slot,
				Quest = quest,
				Progress = progress,
				Done = progress >= quest.Goal,
				Claimed = (quests.Claimed or {})[id] == true,
			})
		end
	end
	return list, quests
end

local function refresh()
	local list, quests = questState()
	local claimable = false
	for index, row in ipairs(rows) do
		local entry = list[index]
		row.Frame.Visible = entry ~= nil
		if entry then
			local quest = entry.Quest
			row.Title.Text = string.format(quest.Text, quest.Goal)
			row.Fill.Size = UDim2.fromScale(entry.Progress / quest.Goal, 1)
			row.Count.Text = string.format("%d / %d", entry.Progress, quest.Goal)
			row.Reward.Text = RewardText.Describe(quest.Reward, 1, "  ")
			if entry.Claimed then
				UIKit.SetButtonEnabled(row.Button, false, "DONE")
			elseif entry.Done then
				UIKit.SetButtonEnabled(row.Button, true)
				row.Button.Text = "CLAIM"
				claimable = true
			else
				UIKit.SetButtonEnabled(row.Button, false, "IN PROGRESS")
			end
		end
		local trackerRow = trackerRows[index]
		if trackerRow then
			trackerRow.Label.Parent.Visible = entry ~= nil and not entry.Claimed
			if entry then
				trackerRow.Label.Text = string.format("%s  %d/%d", string.format(entry.Quest.Text, entry.Quest.Goal), entry.Progress, entry.Quest.Goal)
				trackerRow.Fill.Size = UDim2.fromScale(entry.Progress / entry.Quest.Goal, 1)
				trackerRow.Fill.BackgroundColor3 = if entry.Done then UIKit.Colors.Success else UIKit.Colors.Accent
			end
		end
	end
	local bonusText = RewardText.Describe(Config.Quests.BonusReward, 1, "  ")
	if quests and quests.BonusClaimed then
		bonusLabel.Text = "All quests done today!  Bonus claimed: " .. bonusText
	else
		bonusLabel.Text = "Finish all " .. Config.Quests.PerDay .. " quests for a bonus: " .. bonusText
	end
	local now = State.Now()
	local nextReset = (Util.DayNumber(now) + 1) * 86400
	resetLabel.Text = "New quests in " .. Util.FormatTime(nextReset - now)
	UIController.SetBadge("Quests", claimable)
	tracker.Visible = State.Loaded and #list > 0
end

local function buildRow(parent: Instance, order: number): Row
	local frame = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 84), BackgroundColor3 = UIKit.Colors.Panel, LayoutOrder = order, Parent = parent })
	UIKit.Corner(frame, 12)
	UIKit.Padding(frame, 12, 8)
	local title = UIKit.Label({ Size = UDim2.new(1, -150, 0, 24), TextSize = 18, Parent = frame })
	local bar = UIKit.Frame({ Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, -150, 0, 16), BackgroundColor3 = UIKit.Colors.PanelDark, Parent = frame })
	UIKit.Corner(bar, 8)
	local fill = UIKit.Frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = UIKit.Colors.Accent, Parent = bar })
	UIKit.Corner(fill, 8)
	local count = UIKit.Label({ Size = UDim2.fromScale(1, 1), TextSize = 12, Font = UIKit.Fonts.Black, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 2, TextStrokeTransparency = 0.5, Parent = bar })
	local reward = UIKit.Label({ Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, -150, 0, 20), TextSize = 14, Parent = frame })
	local button = UIKit.Button({ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(136, 44), Color = UIKit.Colors.Success, TextSize = 15 }, function()
		Remotes.Get("ClaimQuest"):FireServer(order)
	end)
	button.Parent = frame
	return { Frame = frame, Title = title, Fill = fill, Count = count, Reward = reward, Button = button }
end

local function buildTracker()
	tracker = UIKit.Frame({
		Name = "QuestTracker",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -16, 0, 120),
		Size = UDim2.fromOffset(250, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.25,
		Visible = false,
		Parent = UIController.Root,
	})
	UIKit.Corner(tracker, 10)
	UIKit.Padding(tracker, 8, 6)
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 4), SortOrder = Enum.SortOrder.LayoutOrder, Parent = tracker })
	local header = UIKit.Create("TextButton", {
		Size = UDim2.new(1, 0, 0, 20),
		BackgroundTransparency = 1,
		Font = UIKit.Fonts.Title,
		TextSize = 16,
		TextColor3 = UIKit.Colors.Accent,
		TextXAlignment = Enum.TextXAlignment.Left,
		Text = "DAILY QUESTS  >",
		LayoutOrder = 0,
		Parent = tracker,
	})
	header.Activated:Connect(function()
		UIController.Toggle("Quests")
	end)
	for index = 1, Config.Quests.PerDay do
		local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = index, Parent = tracker })
		local label = UIKit.Label({ Size = UDim2.new(1, 0, 0, 16), TextSize = 13, TextTruncate = Enum.TextTruncate.AtEnd, Parent = row })
		local bar = UIKit.Frame({ Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 6), BackgroundColor3 = UIKit.Colors.PanelDark, Parent = row })
		UIKit.Corner(bar, 3)
		local fill = UIKit.Frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = UIKit.Colors.Accent, Parent = bar })
		UIKit.Corner(fill, 3)
		trackerRows[index] = { Label = label, Fill = fill }
	end
end

function QuestsUI.Init()
	window = UIController.CreateWindow("Quests", "DAILY QUESTS", UDim2.fromOffset(620, 430), UIKit.Colors.Accent)
	local list = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = window.Content })
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })
	for index = 1, Config.Quests.PerDay do
		rows[index] = buildRow(list, index)
	end
	bonusLabel = UIKit.Label({ Size = UDim2.new(1, 0, 0, 26), TextSize = 15, TextWrapped = true, LayoutOrder = 10, Parent = list })
	resetLabel = UIKit.Label({ Size = UDim2.new(1, 0, 0, 20), TextSize = 13, TextColor3 = UIKit.Colors.Muted, LayoutOrder = 11, Parent = list })

	buildTracker()
	window.OnOpen = refresh
	State.Changed:Connect(function(patch)
		if patch.Quests ~= nil or patch.Stats ~= nil or patch.Multiplier ~= nil then
			refresh()
		end
	end)
	UIController.AddSideButton("Quests", "QUESTS", UIKit.Colors.Success:Lerp(UIKit.Colors.Accent, 0.5), 3, function()
		UIController.Toggle("Quests")
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			if window.IsOpen() then
				refresh()
			end
		end
	end)
end

return QuestsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="48">
          <Properties>
            <string name="Name">RewardsUI</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- RewardsUI - daily streak, playtime gifts, group reward and promo codes.
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local RewardText = require(Modules.RewardText)
local UIController = require(script.Parent.UIController)

local RewardsUI = {}

local window
local dailyCells: { Frame } = {}
local dailyButton: TextButton
local dailyStatus: TextLabel
local playtimeCells: { { Frame: Frame, Button: TextButton, Status: TextLabel, Reward: TextLabel } } = {}
local groupButton: TextButton?
local codeBox: TextBox
local redeeming = false

local describe = RewardText.Describe

local function sessionElapsed(): number
	local start = State.Get("SessionStart")
	if not start then
		return 0
	end
	return State.Now() - start
end

--------------------------------------------------------------------------------
-- Badge logic (runs even while the window is closed)
--------------------------------------------------------------------------------

local function anythingClaimable(): boolean
	if not State.Loaded then
		return false
	end
	local daily = Util.ComputeDaily(State.Get("Daily", { LastClaim = 0, Streak = 0 }), State.Now(), #Config.DailyRewards)
	if daily.Available then
		return true
	end
	local claimed = State.Get("PlaytimeClaimed", {})
	local elapsed = sessionElapsed()
	for index, reward in ipairs(Config.PlaytimeRewards) do
		if not claimed[tostring(index)] and elapsed >= reward.Minutes * 60 then
			return true
		end
	end
	return false
end

--------------------------------------------------------------------------------
-- Refresh
--------------------------------------------------------------------------------

local function refreshDaily()
	local daily = Util.ComputeDaily(State.Get("Daily", { LastClaim = 0, Streak = 0 }), State.Now(), #Config.DailyRewards)
	local vipMult = State.Owns("VIP") and Config.Gamepasses.VIP.DailyRewardMultiplier or 1
	-- When today's reward is claimed, NextDay is the day just claimed.
	local claimedThrough = if daily.Available then daily.NextDay - 1 else daily.NextDay

	for day, cell in ipairs(dailyCells) do
		local stroke = cell:FindFirstChildOfClass("UIStroke")
		local reward = cell:FindFirstChild("Reward") :: TextLabel
		reward.Text = describe(Config.DailyRewards[day], vipMult)
		local isNext = daily.Available and day == daily.NextDay
		if day <= claimedThrough then
			cell.BackgroundColor3 = UIKit.Colors.Success:Lerp(UIKit.Colors.Panel, 0.6)
			if stroke then
				stroke.Color = UIKit.Colors.Success
			end
		elseif isNext then
			cell.BackgroundColor3 = UIKit.Colors.Accent:Lerp(UIKit.Colors.Panel, 0.55)
			if stroke then
				stroke.Color = UIKit.Colors.Accent
			end
		else
			cell.BackgroundColor3 = UIKit.Colors.Panel
			if stroke then
				stroke.Color = UIKit.Colors.Stroke
			end
		end
	end

	if daily.Available then
		UIKit.SetButtonEnabled(dailyButton, true)
		dailyButton.Text = "CLAIM DAY " .. daily.NextDay
		dailyStatus.Text = vipMult > 1 and "<font color='#FF7828'>VIP: rewards doubled!</font>" or "Log in every day to grow your streak!"
	else
		UIKit.SetButtonEnabled(dailyButton, false, "CLAIMED")
		dailyStatus.Text = "Next reward in " .. Util.FormatTime(daily.SecondsUntilReset)
	end
end

local function refreshPlaytime()
	local claimed = State.Get("PlaytimeClaimed", {})
	local elapsed = sessionElapsed()
	for index, entry in ipairs(playtimeCells) do
		local reward = Config.PlaytimeRewards[index]
		entry.Reward.Text = describe(reward) -- coin amounts scale with progress
		local needed = reward.Minutes * 60
		if claimed[tostring(index)] then
			UIKit.SetButtonEnabled(entry.Button, false, "CLAIMED")
			entry.Status.Text = "Done!"
		elseif elapsed >= needed then
			UIKit.SetButtonEnabled(entry.Button, true)
			entry.Button.Text = "CLAIM"
			entry.Status.Text = "Ready!"
		else
			UIKit.SetButtonEnabled(entry.Button, false, Util.FormatTime(needed - elapsed))
			entry.Status.Text = reward.Minutes .. " min"
		end
	end
end

local function refreshGroup()
	if not groupButton then
		return
	end
	if State.Get("GroupClaimed", false) then
		UIKit.SetButtonEnabled(groupButton, false, "CLAIMED")
	else
		UIKit.SetButtonEnabled(groupButton, true)
		groupButton.Text = "CLAIM " .. Config.GroupReward.Coins .. " COINS"
	end
end

local function refreshAll()
	if not window or not window.IsOpen() then
		return
	end
	refreshDaily()
	refreshPlaytime()
	refreshGroup()
end

--------------------------------------------------------------------------------
-- Build
--------------------------------------------------------------------------------

local function sectionTitle(parent: Instance, text: string, order: number, color: Color3)
	UIKit.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = text,
		Font = UIKit.Fonts.Title,
		TextSize = 22,
		TextColor3 = color,
		LayoutOrder = order,
		Parent = parent,
	})
end

local function buildDaily(list: ScrollingFrame)
	sectionTitle(list, "DAILY REWARDS", 1, UIKit.Colors.Accent)
	local row = UIKit.Frame({
		Size = UDim2.new(1, 0, 0, 104),
		BackgroundTransparency = 1,
		LayoutOrder = 2,
		Parent = list,
	})
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	for day = 1, #Config.DailyRewards do
		local cell = UIKit.Frame({
			Size = UDim2.fromOffset(80, 100),
			BackgroundColor3 = UIKit.Colors.Panel,
			LayoutOrder = day,
			Parent = row,
		})
		UIKit.Corner(cell, 10)
		UIKit.Stroke(cell, UIKit.Colors.Stroke, 2)
		UIKit.Label({
			Size = UDim2.new(1, 0, 0, 26),
			Text = "DAY " .. day,
			Font = UIKit.Fonts.Black,
			TextSize = 15,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = cell,
		})
		UIKit.Label({
			Name = "Reward",
			Position = UDim2.fromOffset(4, 28),
			Size = UDim2.new(1, -8, 1, -32),
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Center,
			Parent = cell,
		})
		dailyCells[day] = cell
	end

	local footer = UIKit.Frame({
		Size = UDim2.new(1, 0, 0, 46),
		BackgroundTransparency = 1,
		LayoutOrder = 3,
		Parent = list,
	})
	dailyStatus = UIKit.Label({
		Size = UDim2.new(1, -200, 1, 0),
		TextSize = 15,
		TextColor3 = UIKit.Colors.Muted,
		Parent = footer,
	})
	dailyButton = UIKit.Button({
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.new(1, 0, 0.5, 0),
		Size = UDim2.fromOffset(180, 42),
		Color = UIKit.Colors.Accent,
		Text = "CLAIM",
	}, function()
		Remotes.Get("ClaimDaily"):FireServer()
	end)
	dailyButton.Parent = footer
end

local function buildPlaytime(list: ScrollingFrame)
	sectionTitle(list, "PLAYTIME GIFTS", 4, UIKit.Colors.Success)
	local row = UIKit.Frame({
		Size = UDim2.new(1, 0, 0, 150),
		BackgroundTransparency = 1,
		LayoutOrder = 5,
		Parent = list,
	})
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Padding = UDim.new(0, 8),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})
	for index, reward in ipairs(Config.PlaytimeRewards) do
		local cell = UIKit.Frame({
			Size = UDim2.fromOffset(92, 146),
			BackgroundColor3 = UIKit.Colors.Panel,
			LayoutOrder = index,
			Parent = row,
		})
		UIKit.Corner(cell, 10)
		UIKit.Stroke(cell, UIKit.Colors.Success, 1.5, 0.4)
		local status = UIKit.Label({
			Size = UDim2.new(1, 0, 0, 24),
			Font = UIKit.Fonts.Black,
			TextSize = 14,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = cell,
		})
		local rewardLabel = UIKit.Label({
			Name = "Reward",
			Position = UDim2.fromOffset(4, 26),
			Size = UDim2.new(1, -8, 0, 68),
			Text = describe(reward),
			TextSize = 13,
			TextWrapped = true,
			TextXAlignment = Enum.TextXAlignment.Center,
			Parent = cell,
		})
		local button = UIKit.Button({
			AnchorPoint = Vector2.new(0.5, 1),
			Position = UDim2.new(0.5, 0, 1, -6),
			Size = UDim2.new(1, -12, 0, 34),
			Color = UIKit.Colors.Success,
			TextSize = 14,
			Text = "CLAIM",
		}, function()
			Remotes.Get("ClaimPlaytime"):FireServer(index)
		end)
		button.Parent = cell
		playtimeCells[index] = { Frame = cell, Button = button, Status = status, Reward = rewardLabel }
	end
end

local function buildGroupAndCodes(list: ScrollingFrame)
	sectionTitle(list, "BONUSES", 6, UIKit.Colors.Info)
	local row = UIKit.Frame({
		Size = UDim2.new(1, 0, 0, 96),
		BackgroundTransparency = 1,
		LayoutOrder = 7,
		Parent = list,
	})
	UIKit.Create("UIListLayout", {
		FillDirection = Enum.FillDirection.Horizontal,
		Padding = UDim.new(0, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = row,
	})

	local hasGroup = Config.GroupId and Config.GroupId > 0
	local codesWidth = hasGroup and 0.5 or 1

	if hasGroup then
		local groupCard = UIKit.Frame({
			Size = UDim2.new(0.5, -5, 1, 0),
			BackgroundColor3 = UIKit.Colors.Panel,
			LayoutOrder = 1,
			Parent = row,
		})
		UIKit.Corner(groupCard, 10)
		UIKit.Padding(groupCard, 10, 8)
		UIKit.Label({
			Size = UDim2.new(1, 0, 0, 36),
			Text = "Join our group for <font color='#FFC400'>" .. Config.GroupReward.Coins .. " Coins</font> and <font color='#AF69FF'>+10% coins</font> forever!",
			TextSize = 14,
			TextWrapped = true,
			Parent = groupCard,
		})
		local button = UIKit.Button({
			AnchorPoint = Vector2.new(0, 1),
			Position = UDim2.new(0, 0, 1, 0),
			Size = UDim2.new(1, 0, 0, 36),
			Color = UIKit.Colors.Info,
			TextSize = 15,
		}, function()
			Remotes.Get("ClaimGroup"):FireServer()
		end)
		button.Parent = groupCard
		groupButton = button
	end

	local codesCard = UIKit.Frame({
		Size = UDim2.new(codesWidth, hasGroup and -5 or 0, 1, 0),
		BackgroundColor3 = UIKit.Colors.Panel,
		LayoutOrder = 2,
		Parent = row,
	})
	UIKit.Corner(codesCard, 10)
	UIKit.Padding(codesCard, 10, 8)
	UIKit.Label({
		Size = UDim2.new(1, 0, 0, 30),
		Text = "Redeem a <font color='#FFC400'>CODE</font> (find them on our socials!)",
		TextSize = 14,
		TextWrapped = true,
		Parent = codesCard,
	})
	codeBox = UIKit.Create("TextBox", {
		AnchorPoint = Vector2.new(0, 1),
		Position = UDim2.new(0, 0, 1, 0),
		Size = UDim2.new(1, -112, 0, 36),
		BackgroundColor3 = UIKit.Colors.PanelDark,
		BorderSizePixel = 0,
		ClearTextOnFocus = false,
		PlaceholderText = "Enter code...",
		PlaceholderColor3 = UIKit.Colors.Muted,
		Text = "",
		TextColor3 = UIKit.Colors.Text,
		Font = UIKit.Fonts.Bold,
		TextSize = 16,
		Parent = codesCard,
	})
	UIKit.Corner(codeBox, 8)
	local redeem = UIKit.Button({
		AnchorPoint = Vector2.new(1, 1),
		Position = UDim2.new(1, 0, 1, 0),
		Size = UDim2.fromOffset(102, 36),
		Color = UIKit.Colors.Accent,
		Text = "REDEEM",
		TextSize = 15,
	}, function()
		if redeeming then
			return
		end
		local code = codeBox.Text
		if #code == 0 then
			return
		end
		redeeming = true
		local ok, response = pcall(function()
			return Remotes.Get("RedeemCode"):InvokeServer(code)
		end)
		redeeming = false
		if ok and type(response) == "table" then
			UIController.Notify(tostring(response.message), response.ok and "reward" or "error")
			if response.ok then
				codeBox.Text = ""
			end
		else
			UIController.Notify("Couldn't redeem right now, try again.", "error")
		end
	end)
	redeem.Parent = codesCard
end

function RewardsUI.Init()
	window = UIController.CreateWindow("Rewards", "REWARDS", UDim2.fromOffset(680, 500), UIKit.Colors.Accent)
	local holder = UIKit.Frame({
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UIKit.Colors.PanelDark,
		Parent = window.Content,
	})
	UIKit.Corner(holder, 12)
	UIKit.Padding(holder, 12)
	local list = UIKit.ScrollList(holder, nil, 6)
	local layout = list:FindFirstChildOfClass("UIListLayout")
	if layout then
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	end

	buildDaily(list)
	buildPlaytime(list)
	buildGroupAndCodes(list)

	window.OnOpen = refreshAll
	State.Changed:Connect(function(patch)
		if patch.Daily ~= nil or patch.PlaytimeClaimed ~= nil or patch.GroupClaimed ~= nil or patch.Gamepasses ~= nil or patch.Owned ~= nil then
			refreshAll()
		end
	end)

	UIController.AddSideButton("Rewards", "REWARDS", UIKit.Colors.Pink, 5, function()
		UIController.Toggle("Rewards")
	end)

	-- 1-second tick: countdowns + side-button badge
	task.spawn(function()
		while true do
			task.wait(1)
			UIController.SetBadge("Rewards", anythingClaimable())
			if window.IsOpen() then
				refreshDaily()
				refreshPlaytime()
			end
		end
	end)
end

return RewardsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="49">
          <Properties>
            <string name="Name">SettingsUI</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- SettingsUI - music and effects toggles (saved on the server).
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local UIController = require(script.Parent.UIController)

local SettingsUI = {}

local SETTINGS = {
	{ Key = "Music", Label = "Background Music" },
	{ Key = "Effects", Label = "Confetti & Flashes" },
}

local window
local toggles: { [string]: TextButton } = {}
local music: Sound? = nil

local function getSetting(key: string): boolean
	local settings = State.Get("Settings", {})
	return settings[key] == true
end

local function applyMusic()
	if not Config.Sounds.Music or Config.Sounds.Music == 0 then
		return
	end
	if not music then
		local sound = Instance.new("Sound")
		sound.Name = "Music"
		sound.SoundId = "rbxassetid://" .. Config.Sounds.Music
		sound.Looped = true
		sound.Volume = 0.3
		sound.Parent = SoundService
		music = sound
	end
	local sound = music :: Sound
	if getSetting("Music") then
		if not sound.IsPlaying then
			sound:Play()
		end
	else
		sound:Stop()
	end
end

local function refresh()
	for key, button in pairs(toggles) do
		local on = getSetting(key)
		button.Text = on and "ON" or "OFF"
		UIKit.SetButtonColor(button, on and UIKit.Colors.Success or UIKit.Colors.Danger)
	end
end

function SettingsUI.Init()
	window = UIController.CreateWindow("Settings", "SETTINGS", UDim2.fromOffset(420, 240), UIKit.Colors.Stroke)
	local list = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Parent = window.Content })
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder, Parent = list })

	for order, setting in ipairs(SETTINGS) do
		local row = UIKit.Frame({
			Size = UDim2.new(1, 0, 0, 52),
			BackgroundColor3 = UIKit.Colors.Panel,
			LayoutOrder = order,
			Parent = list,
		})
		UIKit.Corner(row, 10)
		UIKit.Label({
			Position = UDim2.fromOffset(14, 0),
			Size = UDim2.new(1, -120, 1, 0),
			Text = setting.Label,
			TextSize = 18,
			Parent = row,
		})
		local button = UIKit.Button({
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -10, 0.5, 0),
			Size = UDim2.fromOffset(90, 36),
			Color = UIKit.Colors.Danger,
			Text = "OFF",
		}, function()
			local settings = State.Get("Settings", {})
			local newValue = not (settings[setting.Key] == true)
			settings[setting.Key] = newValue
			State.Apply({ Settings = settings })
			Remotes.Get("UpdateSetting"):FireServer(setting.Key, newValue)
		end)
		button.Parent = row
		toggles[setting.Key] = button
	end

	window.OnOpen = refresh
	State.Changed:Connect(function(patch)
		if patch.Settings ~= nil then
			refresh()
			applyMusic()
		end
	end)

	UIController.AddSideButton("Settings", "SETTINGS", UIKit.Colors.Stroke, 7, function()
		UIController.Toggle("Settings")
	end)
end

return SettingsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="50">
          <Properties>
            <string name="Name">ShopUI</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- ShopUI - gamepasses and developer products.
--------------------------------------------------------------------------------

local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local UIController = require(script.Parent.UIController)

local player = Players.LocalPlayer

local ShopUI = {}

local window
local list: ScrollingFrame
local CARD_W, CARD_H, PAD = 222, 160, 10
local COLUMNS = 3

local function sortedEntries(map)
	local entries = {}
	for key, item in pairs(map) do
		table.insert(entries, { Key = key, Item = item })
	end
	table.sort(entries, function(a, b)
		return (a.Item.Order or 0) < (b.Item.Order or 0)
	end)
	return entries
end

local function isBlocked(_key: string): boolean
	return false
end

local function promptGamepass(key, pass)
	if isBlocked(key) then
		UIController.Notify("Sorry, this item is unavailable in your region.", "error")
		return
	end
	if not pass.Id or pass.Id == 0 then
		UIController.Notify("This gamepass isn't configured yet. Set Config.Gamepasses." .. key .. ".Id", "error")
		return
	end
	MarketplaceService:PromptGamePassPurchase(player, pass.Id)
end

local function promptProduct(key, product)
	if isBlocked(key) then
		UIController.Notify("Sorry, this item is unavailable in your region.", "error")
		return
	end
	if not product.Id or product.Id == 0 then
		UIController.Notify("This product isn't configured yet. Set Config.Products." .. key .. ".Id", "error")
		return
	end
	MarketplaceService:PromptProductPurchase(player, product.Id)
end

local function describeGrant(grant): string
	if grant.Skips then
		return if grant.Skips == 1 then "Skip the stage you're stuck on. Instantly." else string.format("Jump ahead %d stages. Instantly.", grant.Skips)
	elseif grant.Coins then
		return "+" .. Util.FormatNumber(grant.Coins) .. " Coins to spend on brainrots"
	end
	return ""
end

local function sectionHeader(text: string, order: number, color: Color3)
	UIKit.Label({
		Size = UDim2.new(1, 0, 0, 34),
		Text = text,
		Font = UIKit.Fonts.Title,
		TextSize = 24,
		TextColor3 = color,
		LayoutOrder = order,
		Parent = list,
	})
end

local function gridContainer(count: number, order: number): Frame
	local rows = math.ceil(count / COLUMNS)
	local holder = UIKit.Frame({
		Size = UDim2.new(1, 0, 0, rows * (CARD_H + PAD)),
		BackgroundTransparency = 1,
		LayoutOrder = order,
		Parent = list,
	})
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(CARD_W, CARD_H),
		CellPadding = UDim2.fromOffset(PAD, PAD),
		SortOrder = Enum.SortOrder.LayoutOrder,
		Parent = holder,
	})
	return holder
end

local function card(parent: Instance, order: number, color: Color3, title: string, body: string, buttonText: string, onClick: () -> (), owned: boolean?, blocked: boolean?)
	local frame = UIKit.Frame({
		BackgroundColor3 = UIKit.Colors.Panel,
		LayoutOrder = order,
		Parent = parent,
	})
	UIKit.Corner(frame, 12)
	UIKit.Stroke(frame, color, 1.5)

	local header = UIKit.Frame({
		Size = UDim2.new(1, 0, 0, 40),
		BackgroundColor3 = color,
		Parent = frame,
	})
	UIKit.Corner(header, 12)
	UIKit.RarityGradient(header, color)
	UIKit.Label({
		Size = UDim2.new(1, -16, 1, 0),
		Position = UDim2.fromOffset(8, 0),
		Text = title,
		Font = UIKit.Fonts.Title,
		TextSize = 20,
		TextTruncate = Enum.TextTruncate.AtEnd,
		TextStrokeTransparency = 0.6,
		Parent = header,
	})

	UIKit.Label({
		Position = UDim2.fromOffset(10, 46),
		Size = UDim2.new(1, -20, 0, 60),
		Text = body,
		Font = UIKit.Fonts.Body,
		TextSize = 14,
		TextWrapped = true,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = UIKit.Colors.Muted,
		Parent = frame,
	})

	local button = UIKit.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 38),
		Color = owned and UIKit.Colors.PanelLight or UIKit.Colors.Success,
		Text = owned and "OWNED" or buttonText,
		TextSize = 17,
	}, onClick)
	button.Parent = frame
	if owned then
		UIKit.SetButtonEnabled(button, false, "OWNED")
	elseif blocked then
		UIKit.SetButtonEnabled(button, false, "UNAVAILABLE")
	end
end

local function trailCard(parent: Instance, order: number, key: string, def)
	local owned = State.Get("Trails", {})[key] == true
	local equipped = State.Get("EquippedTrail", "None") == key
	local color = def.Color or UIKit.Colors.Muted
	local frame = UIKit.Frame({ BackgroundColor3 = UIKit.Colors.Panel, LayoutOrder = order, Parent = parent })
	UIKit.Corner(frame, 12)
	UIKit.Stroke(frame, color, 1.5)
	local swatch = UIKit.Frame({ Position = UDim2.fromOffset(10, 10), Size = UDim2.new(1, -20, 0, 60), BackgroundColor3 = color, Parent = frame })
	UIKit.Corner(swatch, 10)
	UIKit.Gradient(swatch, Color3.new(1, 1, 1), color:Lerp(Color3.new(0, 0, 0), 0.3), 0)
	UIKit.Label({ Position = UDim2.fromOffset(10, 76), Size = UDim2.new(1, -20, 0, 24), Text = def.Name .. " Trail", Font = UIKit.Fonts.Title, TextSize = 18, Parent = frame })
	local button = UIKit.Button({
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -10),
		Size = UDim2.new(1, -20, 0, 38),
		Color = if equipped then UIKit.Colors.Info elseif owned then UIKit.Colors.Success else UIKit.Colors.Accent,
		Text = if equipped then "EQUIPPED" elseif owned then "EQUIP" elseif def.Price > 0 then "BUY  " .. Util.FormatNumber(def.Price) .. " coins" else "EQUIP",
		TextSize = 16,
	}, function()
		Remotes.Get(if owned then "EquipTrail" else "BuyTrail"):FireServer(key)
	end)
	button.Parent = frame
	if equipped then
		UIKit.SetButtonEnabled(button, false, "EQUIPPED")
	end
end

local function rebuild()
	if not window or not window.IsOpen() then
		return
	end
	UIKit.ClearChildren(list)

	local passes = sortedEntries(Config.Gamepasses)
	sectionHeader("GAMEPASSES", 1, UIKit.Colors.Accent)
	local passGrid = gridContainer(#passes, 2)
	for index, entry in ipairs(passes) do
		local pass = entry.Item
		local blocked = isBlocked(entry.Key)
		local description = if blocked then "Not available in your region." else pass.Description
		card(passGrid, index, pass.Color or UIKit.Colors.Accent, pass.Name, description, "R$ " .. pass.Price, function()
			promptGamepass(entry.Key, pass)
		end, State.Owns(entry.Key), blocked)
	end

	local products = sortedEntries(Config.Products)
	sectionHeader("SKIPS & COINS", 3, UIKit.Colors.Success)
	local productGrid = gridContainer(#products, 4)
	for index, entry in ipairs(products) do
		local product = entry.Item
		local color = if product.Grant.Skips then UIKit.Colors.Success else UIKit.Colors.Accent
		local blocked = isBlocked(entry.Key)
		local description = if blocked then "Not available in your region." else describeGrant(product.Grant)
		card(productGrid, index, color, product.Name, description, "R$ " .. product.Price, function()
			promptProduct(entry.Key, product)
		end, false, blocked)
	end

	local trails = Config.SortedTrails()
	sectionHeader("TRAILS (COINS)", 5, UIKit.Colors.Pink)
	local trailGrid = gridContainer(#trails, 6)
	for index, entry in ipairs(trails) do
		trailCard(trailGrid, index, entry.Key, entry.Def)
	end
end

function ShopUI.Init()
	window = UIController.CreateWindow("Shop", "SHOP", UDim2.fromOffset(760, 500), UIKit.Colors.Accent)
	local holder = UIKit.Frame({
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = UIKit.Colors.PanelDark,
		Parent = window.Content,
	})
	UIKit.Corner(holder, 12)
	UIKit.Padding(holder, 12)
	list = UIKit.ScrollList(holder, nil, 8)

	window.OnOpen = rebuild
	State.Changed:Connect(function(patch)
		if patch.Gamepasses ~= nil or patch.Trails ~= nil or patch.EquippedTrail ~= nil then
			rebuild()
		end
	end)

	UIController.AddSideButton("Shop", "SHOP", UIKit.Colors.Accent, 2, function()
		UIController.Toggle("Shop")
	end)

	MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(_, _, purchased)
		if purchased then
			UIController.PlaySound("Purchase")
		end
	end)
	MarketplaceService.PromptProductPurchaseFinished:Connect(function(_, _, purchased)
		if purchased then
			UIController.PlaySound("Purchase")
		end
	end)
end

return ShopUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="51">
          <Properties>
            <string name="Name">StagesUI</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- StagesUI - teleport back to any checkpoint you've reached, grouped by world.
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Remotes = require(Shared.Remotes)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local UIController = require(script.Parent.UIController)

local StagesUI = {}

local window
local list: ScrollingFrame
local progressLabel: TextLabel

local function rebuild()
	if not window or not window.IsOpen() then
		return
	end
	UIKit.ClearChildren(list)
	local current = State.Get("Stage", 1)
	local total = Config.TotalStages()
	progressLabel.Text = string.format("You're on stage <font color='#FFC400'>%d / %d</font>. Tap a stage to go back to it.", current, total)

	local order = 0
	for worldIndex, world in ipairs(Config.Worlds) do
		local start = Config.GetWorldStart(worldIndex)
		local unlocked = current >= start
		order += 1
		UIKit.Label({
			Size = UDim2.new(1, 0, 0, 30),
			Text = string.format("WORLD %d: %s%s", worldIndex, string.upper(world.Name), if unlocked then "" else "  <font color='#A5AAC8'>(locked)</font>"),
			Font = UIKit.Fonts.Title,
			TextSize = 20,
			TextColor3 = if unlocked then world.Theme.Accent else UIKit.Colors.Muted,
			LayoutOrder = order,
			Parent = list,
		})
		order += 1
		local rows = math.ceil(world.Stages / 10)
		local holder = UIKit.Frame({ Size = UDim2.new(1, 0, 0, rows * 50), BackgroundTransparency = 1, LayoutOrder = order, Parent = list })
		UIKit.Create("UIGridLayout", { CellSize = UDim2.fromOffset(56, 42), CellPadding = UDim2.fromOffset(6, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = holder })
		for i = 1, world.Stages do
			local stage = start + i - 1
			local reached = stage <= current
			local button = UIKit.Button({
				Text = tostring(stage),
				TextSize = 17,
				Color = if stage == current then UIKit.Colors.Accent elseif reached then world.Theme.Platform else UIKit.Colors.PanelLight,
				LayoutOrder = i,
				Radius = 10,
			}, function()
				if reached then
					Remotes.Get("TeleportStage"):FireServer(stage)
					window.Close()
				end
			end)
			if not reached then
				UIKit.SetButtonEnabled(button, false)
			end
			button.Parent = holder
		end
	end
end

function StagesUI.Init()
	window = UIController.CreateWindow("Stages", "STAGES", UDim2.fromOffset(700, 520), UIKit.Colors.Info)
	progressLabel = UIKit.Label({ Size = UDim2.new(1, 0, 0, 26), TextSize = 16, Parent = window.Content })
	local holder = UIKit.Frame({ Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 1, -32), BackgroundColor3 = UIKit.Colors.PanelDark, Parent = window.Content })
	UIKit.Corner(holder, 12)
	UIKit.Padding(holder, 10)
	list = UIKit.ScrollList(holder, nil, 4)
	local layout = list:FindFirstChildOfClass("UIListLayout")
	if layout then
		layout.HorizontalAlignment = Enum.HorizontalAlignment.Left
	end

	window.OnOpen = rebuild
	State.Changed:Connect(function(patch)
		if patch.Stage ~= nil then
			rebuild()
		end
	end)

	UIController.AddSideButton("Stages", "STAGES", UIKit.Colors.Info, 4, function()
		UIController.Toggle("Stages")
	end)
end

return StagesUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="52">
          <Properties>
            <string name="Name">StatsUI</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- StatsUI - the player's numbers: stages, deaths, coins, fragments, best run.
--------------------------------------------------------------------------------

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)
local UIController = require(script.Parent.UIController)

local StatsUI = {}

local window
local rows: { { Label: TextLabel, Get: () -> string } } = {}

local function fragmentsFound(): number
	local found = 0
	for _ in pairs(State.Get("Fragments", {})) do
		found += 1
	end
	return found
end

local function ownedCount(): number
	local count = 0
	for _ in pairs(State.Get("Owned", {})) do
		count += 1
	end
	return count
end

local STATS = {
	{ Name = "Current stage", Get = function() return tostring(State.Get("Stage", 1)) .. " / " .. Config.TotalStages() end },
	{ Name = "Best stage ever", Get = function()
		local best = State.Get("Stats", {}).BestStage or 1
		local total = Config.TotalStages()
		return if best > total then string.format("%d (prestige %d)", (best - 1) % total + 1, (best - 1) // total) else tostring(best)
	end },
	{ Name = "Prestige", Get = function() return tostring(State.Get("Prestige", 0)) end },
	{ Name = "Fastest full run", Get = function()
		local best = State.Get("Stats", {}).BestTime or 0
		return if best > 0 then Util.FormatTime(best) else "not yet"
	end },
	{ Name = "Deaths", Get = function() return Util.FormatCommas(State.Get("Stats", {}).Deaths or 0) end },
	{ Name = "Coins collected", Get = function() return Util.FormatCommas(State.Get("Stats", {}).CoinsCollected or 0) end },
	{ Name = "Total coins earned", Get = function() return Util.FormatNumber(State.Get("Stats", {}).TotalCoins or 0) end },
	{ Name = "Stages skipped", Get = function() return tostring(State.Get("Stats", {}).StagesSkipped or 0) end },
	{ Name = "Brainrots owned", Get = function() return ownedCount() .. " / " .. #Config.SortedBrainrots() end },
	{ Name = "Fragments found", Get = function() return fragmentsFound() .. " / " .. Config.Fragments.Count end },
	{ Name = "Time played", Get = function() return Util.FormatTime(State.Get("Stats", {}).Playtime or 0) end },
}

local function refresh()
	if not window or not window.IsOpen() then
		return
	end
	for _, row in ipairs(rows) do
		row.Label.Text = row.Get()
	end
end

function StatsUI.Init()
	window = UIController.CreateWindow("Stats", "MY STATS", UDim2.fromOffset(460, 520), UIKit.Colors.Purple)
	local holder = UIKit.Frame({ Size = UDim2.fromScale(1, 1), BackgroundColor3 = UIKit.Colors.PanelDark, Parent = window.Content })
	UIKit.Corner(holder, 12)
	UIKit.Padding(holder, 10)
	local list = UIKit.ScrollList(holder, nil, 6)
	for order, stat in ipairs(STATS) do
		local row = UIKit.Frame({ Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = UIKit.Colors.Panel, LayoutOrder = order, Parent = list })
		UIKit.Corner(row, 8)
		UIKit.Label({ Position = UDim2.fromOffset(12, 0), Size = UDim2.new(0.55, 0, 1, 0), Text = stat.Name, TextSize = 16, TextColor3 = UIKit.Colors.Muted, Parent = row })
		local value = UIKit.Label({ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 0), Size = UDim2.new(0.45, 0, 1, 0), Font = UIKit.Fonts.Display, TextSize = 18, TextColor3 = UIKit.Colors.Accent, TextXAlignment = Enum.TextXAlignment.Right, Parent = row })
		table.insert(rows, { Label = value, Get = stat.Get })
	end
	window.OnOpen = refresh
	State.Changed:Connect(refresh)
	UIController.AddSideButton("Stats", "STATS", UIKit.Colors.Purple, 6, function()
		UIController.Toggle("Stats")
	end)
end

return StatsUI
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="53">
          <Properties>
            <string name="Name">TrailController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- TrailController - coloured trails behind players. The colour shows a
-- player's prestige (player attribute "TrailTier", set by BrainrotService);
-- the Rainbow Trail gamepass gives the galaxy one.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)

local TrailController = {}

local rgb = Color3.fromRGB
local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, rgb(120, 70, 255)),
	ColorSequenceKeypoint.new(0.5, rgb(255, 110, 220)),
	ColorSequenceKeypoint.new(1, rgb(80, 220, 255)),
})

local function colorsFor(key: any): ColorSequence?
	if key == "Rainbow" then
		return RAINBOW
	end
	local def = type(key) == "string" and Config.Trails[key]
	if def and def.Color then
		return ColorSequence.new(def.Color, def.Color:Lerp(Color3.new(1, 1, 1), 0.5))
	end
	return nil
end

local function apply(player: Player, character: Model)
	local root = character:WaitForChild("HumanoidRootPart", 10)
	if not root or not root:IsA("BasePart") then
		return
	end
	local trail = root:FindFirstChild("SpeedTrail") :: Trail?
	if not trail then
		local top = Instance.new("Attachment")
		top.Name = "TrailTop"
		top.Position = Vector3.new(0, 1, 0.3)
		top.Parent = root
		local bottom = Instance.new("Attachment")
		bottom.Name = "TrailBottom"
		bottom.Position = Vector3.new(0, -1.2, 0.3)
		bottom.Parent = root
		local newTrail = Instance.new("Trail")
		newTrail.Name = "SpeedTrail"
		newTrail.Attachment0 = top
		newTrail.Attachment1 = bottom
		newTrail.Lifetime = 0.45
		newTrail.MinLength = 0.1
		newTrail.FaceCamera = true
		newTrail.LightEmission = 0.6
		newTrail.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
		newTrail.WidthScale = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(1, 0.2) })
		newTrail.Parent = root
		trail = newTrail
	end
	local colors = colorsFor(player:GetAttribute("Trail"))
	local t = trail :: Trail
	t.Enabled = colors ~= nil
	if colors then
		t.Color = colors
	end
end

local function watch(player: Player)
	player.CharacterAdded:Connect(function(character)
		apply(player, character)
	end)
	player:GetAttributeChangedSignal("Trail"):Connect(function()
		if player.Character then
			task.spawn(apply, player, player.Character)
		end
	end)
	if player.Character then
		task.spawn(apply, player, player.Character)
	end
end

function TrailController.Init()
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerAdded:Connect(watch)
end

return TrailController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="54">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- UIController - ScreenGui root, HUD (coins, stage, timer, skip/reset), side buttons, windows, toasts, confirms.
--------------------------------------------------------------------------------

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Config = require(Shared.Config)
local Util = require(Shared.Util)
local Remotes = require(Shared.Remotes)

local Modules = script.Parent.Parent:WaitForChild("Modules")
local State = require(Modules.ClientState)
local UIKit = require(Modules.UIKit)

local player = Players.LocalPlayer

local UIController = {}
UIController.Windows = {} :: { [string]: any }
UIController.SideButtons = {} :: { [string]: TextButton }

local screenGui: ScreenGui
local root: Frame
local uiScale: UIScale
local toastContainer: Frame
local confirmOverlay: Frame
local coinsLabel: TextLabel
local multLabel: TextLabel
local stageLabel: TextLabel
local worldLabel: TextLabel
local timerLabel: TextLabel
local prestigeLabel: TextLabel
local progressFill: Frame
local fragmentLabel: TextLabel
local sideList: Frame

local MAX_TOASTS = 4
local toastCounter = 0

local KIND_COLORS = {
	info = UIKit.Colors.Info,
	success = UIKit.Colors.Success,
	error = UIKit.Colors.Danger,
	reward = UIKit.Colors.Accent,
}

--------------------------------------------------------------------------------
-- Sounds
--------------------------------------------------------------------------------

local soundCache: { [string]: Sound } = {}

function UIController.PlaySound(key: string, volume: number?)
	local id = Config.Sounds[key]
	if not id or id == 0 then
		return
	end
	local sound = soundCache[key]
	if not sound then
		sound = Instance.new("Sound")
		sound.Name = key
		sound.SoundId = "rbxassetid://" .. id
		sound.Volume = volume or 0.5
		sound.Parent = SoundService
		soundCache[key] = sound
	end
	sound:Play()
end

--------------------------------------------------------------------------------
-- Responsive scaling
--------------------------------------------------------------------------------

local function updateScale()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local viewport = camera.ViewportSize
	local scale = math.clamp(math.min(viewport.X / 1280, viewport.Y / 720), 0.55, 1.15)
	uiScale.Scale = scale
	-- UIScale also scales Root itself, so size Root at 1/scale (centred) to keep
	-- it exactly covering the screen after scaling.
	root.AnchorPoint = Vector2.new(0.5, 0.5)
	root.Position = UDim2.fromScale(0.5, 0.5)
	root.Size = UDim2.fromScale(1 / scale, 1 / scale)
end

--------------------------------------------------------------------------------
-- HUD
--------------------------------------------------------------------------------

local function pill(parent: Instance, name: string, color: Color3, width: number, order: number): Frame
	local frame = UIKit.Frame({
		Name = name,
		Size = UDim2.fromOffset(width, 46),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.1,
		LayoutOrder = order,
		Parent = parent,
	})
	UIKit.Corner(frame, 23)
	UIKit.Stroke(frame, UIKit.Ink, 3)
	UIKit.Lip(frame, color:Lerp(Color3.new(0, 0, 0), 0.4), 3)
	return frame
end

local function bigText(parent: Instance, props: { [string]: any }): TextLabel
	local defaults = {
		Size = UDim2.fromScale(1, 1),
		Font = UIKit.Fonts.Display,
		TextSize = 24,
		TextColor3 = Color3.new(1, 1, 1),
		TextStrokeColor3 = UIKit.Ink,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = parent,
	}
	for key, value in pairs(props) do
		defaults[key] = value
	end
	return UIKit.Label(defaults)
end

local function buildHUD()
	-- Top-left: coins
	local column = UIKit.Frame({
		Name = "TopLeft",
		Position = UDim2.fromOffset(16, 12),
		Size = UDim2.fromOffset(240, 110),
		BackgroundTransparency = 1,
		Parent = root,
	})
	UIKit.Create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder, Parent = column })

	local coinPill = pill(column, "Coins", UIKit.Colors.Accent, 230, 1)
	local icon = UIKit.Frame({ Name = "Icon", Size = UDim2.fromOffset(32, 32), Position = UDim2.fromOffset(7, 7), BackgroundColor3 = UIKit.Colors.Accent, Parent = coinPill })
	UIKit.Corner(icon, 16)
	UIKit.Stroke(icon, UIKit.Ink, 2.5)
	UIKit.Gradient(icon, Color3.new(1, 1, 1), Color3.fromRGB(215, 175, 120), 90)
	bigText(icon, { Text = "$", TextSize = 18, TextColor3 = Color3.fromRGB(120, 80, 20), TextStrokeTransparency = 1 })
	coinsLabel = bigText(coinPill, { Name = "Value", Position = UDim2.fromOffset(48, 2), Size = UDim2.new(1, -100, 1, 0), TextSize = 26, TextXAlignment = Enum.TextXAlignment.Left, Text = "0" })
	local plus = UIKit.Button({ Name = "Plus", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(30, 30), Color = UIKit.Colors.Success, Text = "+", TextSize = 22, Radius = 15 }, function()
		UIController.Open("Shop")
	end)
	plus.Parent = coinPill

	local multPill = pill(column, "Multiplier", UIKit.Colors.Purple, 230, 2)
	multLabel = bigText(multPill, { TextSize = 20, TextColor3 = UIKit.Colors.Purple:Lerp(Color3.new(1, 1, 1), 0.3), Text = "x1.00 Coins" })

	-- Top-centre: stage + world + timer
	local stagePill = UIKit.Frame({
		Name = "Stage",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(300, 76),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.1,
		Parent = root,
	})
	UIKit.Corner(stagePill, 20)
	UIKit.Stroke(stagePill, UIKit.Ink, 3)
	UIKit.Lip(stagePill, UIKit.Colors.Info:Lerp(Color3.new(0, 0, 0), 0.4), 4)
	stageLabel = bigText(stagePill, { Position = UDim2.fromOffset(0, 4), Size = UDim2.new(1, 0, 0, 40), TextSize = 34, TextColor3 = Color3.fromRGB(255, 230, 90), Text = "STAGE 1" })
	worldLabel = bigText(stagePill, { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 22), Font = UIKit.Fonts.Title, TextSize = 16, TextColor3 = UIKit.Colors.Muted, TextStrokeTransparency = 0.5, Text = "" })
	local progressBar = UIKit.Frame({ Position = UDim2.new(0, 14, 1, -11), Size = UDim2.new(1, -28, 0, 6), BackgroundColor3 = UIKit.Colors.PanelLight, Parent = stagePill })
	UIKit.Corner(progressBar, 3)
	progressFill = UIKit.Frame({ Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.fromRGB(255, 230, 90), Parent = progressBar })
	UIKit.Corner(progressFill, 3)

	local fragmentPill = pill(root, "Fragments", UIKit.Colors.Purple, 170, 1)
	fragmentPill.AnchorPoint = Vector2.new(1, 0)
	fragmentPill.Position = UDim2.new(1, -16, 0, 12 + 54)
	fragmentPill.Size = UDim2.fromOffset(170, 36)
	fragmentLabel = bigText(fragmentPill, { TextSize = 16, Font = UIKit.Fonts.Title, TextColor3 = Color3.fromRGB(220, 150, 255), Text = "FRAGMENTS 0/12" })

	local timerPill = pill(root, "Timer", UIKit.Colors.Info, 190, 1)
	timerPill.AnchorPoint = Vector2.new(0.5, 0)
	timerPill.Position = UDim2.new(0.5, 0, 0, 96)
	timerPill.Size = UDim2.fromOffset(190, 36)
	timerLabel = bigText(timerPill, { TextSize = 18, Font = UIKit.Fonts.Title, Text = "RUN 0:00" })

	-- Top-right: prestige
	local prestigePill = pill(root, "Prestige", UIKit.Colors.Pink, 170, 1)
	prestigePill.AnchorPoint = Vector2.new(1, 0)
	prestigePill.Position = UDim2.new(1, -16, 0, 12)
	prestigeLabel = bigText(prestigePill, { TextSize = 20, TextColor3 = UIKit.Colors.Pink:Lerp(Color3.new(1, 1, 1), 0.3), Text = "PRESTIGE 0" })

	-- Bottom-centre: SKIP STAGE (Robux) and RESET
	local bottom = UIKit.Frame({
		Name = "BottomButtons",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -16),
		Size = UDim2.fromOffset(420, 58),
		BackgroundTransparency = 1,
		Parent = root,
	})
	UIKit.Create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 12), SortOrder = Enum.SortOrder.LayoutOrder, Parent = bottom })
	local skipProduct = Config.Products[Config.SkipProduct]
	local skip = UIKit.Button({
		Name = "Skip",
		Size = UDim2.fromOffset(250, 54),
		Color = UIKit.Colors.Success,
		Text = "SKIP STAGE  \u{E002}" .. tostring(skipProduct and skipProduct.Price or 0),
		Font = UIKit.Fonts.Display,
		TextSize = 24,
		Radius = 18,
		LayoutOrder = 1,
	}, function()
		UIController.PlaySound("Click")
		UIController.PromptSkip()
	end)
	skip.Parent = bottom
	local reset = UIKit.Button({
		Name = "Reset",
		Size = UDim2.fromOffset(130, 54),
		Color = UIKit.Colors.Danger,
		Text = "RESET",
		Font = UIKit.Fonts.Display,
		TextSize = 22,
		Radius = 18,
		LayoutOrder = 2,
	}, function()
		UIController.PlaySound("Click")
		Remotes.Get("ResetCharacter"):FireServer()
	end)
	reset.Parent = bottom
end

local lastCoins = nil

local function refreshHUD()
	local coins = State.Get("Coins", 0)
	coinsLabel.Text = Util.FormatNumber(coins)
	if lastCoins and coins > lastCoins then
		UIKit.Pop(coinsLabel.Parent :: GuiObject, 1.06)
	end
	lastCoins = coins
	local info = State.Get("Multiplier")
	if info then
		multLabel.Text = string.format("x%.2f Coins", info.Total)
	end
	local stage = State.Get("Stage", 1)
	local total = Config.TotalStages()
	stageLabel.Text = string.format("STAGE %d / %d", stage, total)
	local world, worldIndex = Config.GetWorld(stage)
	worldLabel.Text = string.format("World %d: %s", worldIndex, world.Name)
	prestigeLabel.Text = "PRESTIGE " .. tostring(State.Get("Prestige", 0))
	local _, inWorld = Config.GetWorldForStage(stage)
	UIKit.Tween(progressFill, { Size = UDim2.fromScale(math.clamp((inWorld - 1) / math.max(world.Stages - 1, 1), 0, 1), 1) }, 0.3)
	local found = 0
	for _ in pairs(State.Get("Fragments", {})) do
		found += 1
	end
	fragmentLabel.Text = string.format("FRAGMENTS %d/%d", found, Config.Fragments.Count)
end

local function refreshTimer()
	local stats = State.Get("Stats", {})
	local start = stats.RunStart or 0
	local elapsed = if start > 0 then math.max(0, State.Now() - start) else 0
	timerLabel.Text = string.format("RUN %d:%02d", elapsed // 60, elapsed % 60)
end

-- The SKIP STAGE button: prompts the skip product, or explains when it's unset.
function UIController.PromptSkip()
	local product = Config.Products[Config.SkipProduct]
	if not product then
		return
	end
	if State.Get("Stage", 1) >= Config.TotalStages() then
		UIController.Notify("You're on the last stage! Walk into the finish portal.", "info")
		return
	end
	if not product.Id or product.Id == 0 then
		UIController.Notify("Set Config.Products." .. Config.SkipProduct .. ".Id to enable stage skips.", "error")
		return
	end
	game:GetService("MarketplaceService"):PromptProductPurchase(player, product.Id)
end

--------------------------------------------------------------------------------
-- Side buttons
--------------------------------------------------------------------------------

-- Emoji icons render on every platform without uploading images.
local SIDE_ICONS = {
	Brainrots = "🧠",
	Shop = "🛒",
	Stages = "🚩",
	Rewards = "🎁",
	Settings = "⚙️",
	Quests = "📜",
	Stats = "📊",
}

function UIController.AddSideButton(name: string, label: string, color: Color3, order: number, onClick: () -> ())
	local button = UIKit.Button({
		Name = name,
		Size = UDim2.fromOffset(104, 64),
		Color = color,
		Text = "",
		LayoutOrder = order,
		Radius = 16,
	}, function()
		UIController.PlaySound("Click")
		onClick()
	end)
	UIKit.Label({
		Name = "Icon",
		Position = UDim2.fromOffset(0, 4),
		Size = UDim2.new(1, 0, 0, 32),
		Text = SIDE_ICONS[name] or "",
		TextSize = 28,
		RichText = false,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = button,
	})
	UIKit.Label({
		Name = "Caption",
		Position = UDim2.new(0, 0, 1, -26),
		Size = UDim2.new(1, 0, 0, 22),
		Text = label,
		Font = UIKit.Fonts.Title,
		TextSize = 15,
		TextStrokeColor3 = UIKit.Ink,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		Parent = button,
	})
	button.Parent = sideList

	local badge = UIKit.Frame({
		Name = "Badge",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, 6, 0, -6),
		Size = UDim2.fromOffset(20, 20),
		BackgroundColor3 = UIKit.Colors.Danger,
		Visible = false,
		ZIndex = 5,
		Parent = button,
	})
	UIKit.Corner(badge, 10)
	UIKit.Stroke(badge, Color3.new(1, 1, 1), 2)
	UIKit.Label({
		Size = UDim2.fromScale(1, 1),
		Text = "!",
		TextSize = 14,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 6,
		Parent = badge,
	})

	UIController.SideButtons[name] = button
	return button
end

function UIController.SetBadge(name: string, visible: boolean)
	local button = UIController.SideButtons[name]
	local badge = button and button:FindFirstChild("Badge")
	if badge then
		badge.Visible = visible
	end
end

--------------------------------------------------------------------------------
-- Windows
--------------------------------------------------------------------------------

function UIController.RegisterWindow(name: string, window)
	UIController.Windows[name] = window
end

function UIController.CloseAll(except: string?)
	for name, window in pairs(UIController.Windows) do
		if name ~= except then
			window.Close()
		end
	end
end

function UIController.Open(name: string)
	local window = UIController.Windows[name]
	if not window then
		return
	end
	UIController.CloseAll(name)
	window.Open()
end

function UIController.Close(name: string)
	local window = UIController.Windows[name]
	if window then
		window.Close()
	end
end

function UIController.Toggle(name: string)
	local window = UIController.Windows[name]
	if not window then
		return
	end
	if window.IsOpen() then
		window.Close()
	else
		UIController.Open(name)
	end
end

function UIController.CreateWindow(name: string, title: string, size: UDim2, accent: Color3?)
	local window = UIKit.Window(root, title, size, accent)
	UIController.RegisterWindow(name, window)
	return window
end

--------------------------------------------------------------------------------
-- Toasts
--------------------------------------------------------------------------------

function UIController.Notify(text: string, kind: string?)
	-- Keep at most MAX_TOASTS on screen: drop the oldest first.
	local existing = {}
	for _, child in ipairs(toastContainer:GetChildren()) do
		if child:IsA("GuiObject") then
			table.insert(existing, child)
		end
	end
	table.sort(existing, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for index = 1, #existing - MAX_TOASTS + 1 do
		existing[index]:Destroy()
	end
	toastCounter += 1

	local color = KIND_COLORS[kind or "info"] or UIKit.Colors.Info
	local toast = UIKit.Frame({
		Size = UDim2.fromOffset(420, 44),
		BackgroundColor3 = UIKit.Colors.Background,
		BackgroundTransparency = 0.1,
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = toastCounter,
		ZIndex = 50,
		Parent = toastContainer,
	})
	UIKit.Corner(toast, 12)
	UIKit.Stroke(toast, color, 2)
	local label = UIKit.Label({
		Size = UDim2.new(1, -24, 0, 44),
		Position = UDim2.fromOffset(12, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Text = text,
		TextSize = 17,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextColor3 = Color3.new(1, 1, 1),
		ZIndex = 51,
		Parent = toast,
	})
	label.TextColor3 = if kind == "error" then UIKit.Colors.Danger:Lerp(Color3.new(1, 1, 1), 0.5) else Color3.new(1, 1, 1)

	toast.BackgroundTransparency = 1
	label.TextTransparency = 1
	UIKit.Tween(toast, { BackgroundTransparency = 0.1 }, 0.2)
	UIKit.Tween(label, { TextTransparency = 0 }, 0.2)

	if kind == "error" then
		UIController.PlaySound("Error")
	end

	task.delay(4, function()
		if not toast.Parent then
			return -- already pushed out by newer toasts
		end
		UIKit.Tween(toast, { BackgroundTransparency = 1 }, 0.3)
		UIKit.Tween(label, { TextTransparency = 1 }, 0.3)
		task.wait(0.3)
		toast:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Big centre-screen banner (zone unlocked, rebirth, legendary hatch, events)
--------------------------------------------------------------------------------

function UIController.Banner(title: string, subtitle: string?, color: Color3?)
	local holder = UIKit.Frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.3),
		Size = UDim2.fromOffset(760, 140),
		BackgroundTransparency = 1,
		ZIndex = 150,
		Parent = root,
	})
	local titleLabel = UIKit.Label({
		Size = UDim2.new(1, 0, 0, 84),
		Text = title,
		Font = UIKit.Fonts.Title,
		TextSize = 72,
		TextColor3 = color or UIKit.Colors.Accent,
		TextStrokeTransparency = 0,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 151,
		Parent = holder,
	})
	local subLabel = UIKit.Label({
		Position = UDim2.fromOffset(0, 84),
		Size = UDim2.new(1, 0, 0, 40),
		Text = subtitle or "",
		TextSize = 28,
		TextStrokeTransparency = 0.2,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 151,
		Parent = holder,
	})
	local scale = UIKit.Create("UIScale", { Scale = 0.2, Parent = holder })
	TweenService:Create(scale, TweenInfo.new(0.55, Enum.EasingStyle.Elastic, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(2.4, function()
		UIKit.Tween(titleLabel, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.4)
		UIKit.Tween(subLabel, { TextTransparency = 1, TextStrokeTransparency = 1 }, 0.4)
		task.wait(0.45)
		holder:Destroy()
	end)
end

--------------------------------------------------------------------------------
-- Confirm dialog
--------------------------------------------------------------------------------

local confirmCallback: (() -> ())? = nil
local confirmTitle: TextLabel
local confirmBody: TextLabel

function UIController.Confirm(title: string, body: string, onConfirm: () -> ())
	confirmCallback = onConfirm
	confirmTitle.Text = title
	confirmBody.Text = body
	confirmOverlay.Visible = true
end

local function buildConfirm()
	confirmOverlay = UIKit.Frame({
		Name = "ConfirmOverlay",
		Size = UDim2.fromScale(1, 1),
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.5,
		Visible = false,
		ZIndex = 100,
		Parent = root,
	})
	local box = UIKit.Frame({
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(400, 220),
		BackgroundColor3 = UIKit.Colors.Background,
		ZIndex = 101,
		Parent = confirmOverlay,
	})
	UIKit.Corner(box, 16)
	UIKit.Stroke(box, UIKit.Colors.Accent, 2)

	confirmTitle = UIKit.Label({
		Position = UDim2.fromOffset(20, 16),
		Size = UDim2.new(1, -40, 0, 36),
		Font = UIKit.Fonts.Title,
		TextSize = 26,
		TextXAlignment = Enum.TextXAlignment.Center,
		ZIndex = 102,
		Parent = box,
	})
	confirmBody = UIKit.Label({
		Position = UDim2.fromOffset(20, 60),
		Size = UDim2.new(1, -40, 0, 80),
		Font = UIKit.Fonts.Body,
		TextSize = 17,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = UIKit.Colors.Muted,
		ZIndex = 102,
		Parent = box,
	})

	local yes = UIKit.Button({
		Position = UDim2.new(0.5, -150, 1, -62),
		Size = UDim2.fromOffset(140, 44),
		Color = UIKit.Colors.Success,
		Text = "CONFIRM",
		ZIndex = 102,
	}, function()
		confirmOverlay.Visible = false
		if confirmCallback then
			confirmCallback()
		end
		confirmCallback = nil
	end)
	yes.Parent = box

	local no = UIKit.Button({
		Position = UDim2.new(0.5, 10, 1, -62),
		Size = UDim2.fromOffset(140, 44),
		Color = UIKit.Colors.Danger,
		Text = "CANCEL",
		ZIndex = 102,
	}, function()
		confirmOverlay.Visible = false
		confirmCallback = nil
	end)
	no.Parent = box
end

--------------------------------------------------------------------------------
-- Init
--------------------------------------------------------------------------------

function UIController.Init()
	local playerGui = player:WaitForChild("PlayerGui")

	screenGui = UIKit.Create("ScreenGui", {
		Name = "BrainrotObbyUI",
		ResetOnSpawn = false,
		IgnoreGuiInset = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
		DisplayOrder = 10,
	})

	root = UIKit.Frame({
		Name = "Root",
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		Parent = screenGui,
	})
	uiScale = UIKit.Create("UIScale", { Parent = root })

	toastContainer = UIKit.Frame({
		Name = "Toasts",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 14),
		Size = UDim2.fromOffset(420, 300),
		BackgroundTransparency = 1,
		ZIndex = 50,
		Parent = root,
	})
	UIKit.Create("UIListLayout", {
		Padding = UDim.new(0, 6),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		Parent = toastContainer,
	})

	-- Two-column grid of menu buttons on the left edge.
	sideList = UIKit.Frame({
		Name = "SideButtons",
		AnchorPoint = Vector2.new(0, 0.5),
		Position = UDim2.new(0, 16, 0.55, 0),
		Size = UDim2.fromOffset(216, 310),
		BackgroundTransparency = 1,
		Parent = root,
	})
	UIKit.Create("UIGridLayout", {
		CellSize = UDim2.fromOffset(104, 64),
		CellPadding = UDim2.fromOffset(8, 10),
		SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = Enum.VerticalAlignment.Center,
		Parent = sideList,
	})

	buildHUD()
	buildConfirm()

	UIController.Root = root
	UIController.ScreenGui = screenGui
	screenGui.Parent = playerGui

	updateScale()
	local camera = workspace.CurrentCamera
	if camera then
		camera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
	end
	workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
		local newCamera = workspace.CurrentCamera
		if newCamera then
			newCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)
			updateScale()
		end
	end)

	State.OnLoaded(refreshHUD)
	State.OnLoaded(refreshTimer)
	State.Changed:Connect(function(patch)
		if patch.Coins ~= nil or patch.Multiplier ~= nil or patch.Stage ~= nil or patch.Prestige ~= nil or patch.Fragments ~= nil then
			refreshHUD()
		end
	end)

	Remotes.Get("Notify").OnClientEvent:Connect(function(text, kind)
		UIController.Notify(tostring(text), kind)
	end)

	-- Run timer
	local accumulator = 0
	RunService.Heartbeat:Connect(function(dt)
		accumulator += dt
		if accumulator >= 1 then
			accumulator = 0
			if State.Loaded then
				refreshTimer()
			end
		end
	end)

	-- Close windows with Escape-like key (Backspace is unused in Roblox by default)
	game:GetService("UserInputService").InputBegan:Connect(function(input, processed)
		if processed then
			return
		end
		if input.KeyCode == Enum.KeyCode.Backspace then
			UIController.CloseAll()
		end
	end)
end

return UIController
]]></string>
