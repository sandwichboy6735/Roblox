	c.BodyCenter, c.BodySize = V(0, 1.5, 0), V(2.3, 2.0, 2.1)
	c.HeadCenter, c.HeadSize, c.HeadTop = V(0, 1.7, -0.4), 1.5, V(0, 2.5, 0)
	c.TailTip = V(0, 1.2, 1.0)
end

--------------------------------------------------------------------------------
-- Extras
--------------------------------------------------------------------------------

local function addExtras(c, extras: { string })
	local set = {}
	for _, name in ipairs(extras) do
		set[name] = true
	end

	if set.Stripes then
		local b, sz = c.BodyCenter, c.BodySize
		for _, dz in ipairs({ -0.5, 0, 0.5 }) do
			c:add("Ellipsoid", V(sz.X * 1.03, sz.Y * 1.03, 0.22), b + V(0, 0, dz * sz.Z * 0.6), nil, "Accent", { Role = "Detail" })
		end
	end
	if set.Spots then
		local b, sz = c.BodyCenter, c.BodySize
		local glow = set.Glow == true
		for _, o in ipairs({ V(0.25, 0.47, -0.25), V(-0.3, 0.45, 0.1), V(0.15, 0.48, 0.35), V(-0.1, 0.5, -0.05) }) do
			c:add("Ellipsoid", V(0.36, 0.12, 0.36), b + V(o.X * sz.X, o.Y * sz.Y, o.Z * sz.Z), nil, "Secondary", { Role = "Detail", Material = if glow then "Neon" else nil })
		end
	end
	if set.Sprinkles then
		local colors = { Color3.fromRGB(255, 90, 140), Color3.fromRGB(90, 200, 255), Color3.fromRGB(255, 230, 80), Color3.fromRGB(120, 255, 140) }
		local b, sz = c.BodyCenter, c.BodySize
		for i = 1, 8 do
			local angle = i * 2.4
			local p = b + V(math.cos(angle) * sz.X * 0.28, sz.Y * 0.47, math.sin(angle) * sz.Z * 0.3)
			c:add("Block", V(0.08, 0.06, 0.25), p, V(0, i * 47, 0), colors[(i % #colors) + 1], { Role = "Detail" })
		end
	end
	if set.Aurora then
		local b, sz = c.BodyCenter, c.BodySize
		for i, dz in ipairs({ 0.05, 0.25, 0.45 }) do
			local band = c:add("Ellipsoid", V(sz.X * 0.8, 0.3, 0.32), b + V(0, sz.Y * 0.38 - dz * 0.4, dz * sz.Z), V(-20, 0, 0), "Accent", { Role = "Detail", Material = "Neon", KeepColor = true })
			band:SetAttribute("AuroraPhase", i * 0.25)
			table.insert(c.Rainbow, band)
		end
	end
	if set.Crown then
		local top = c.HeadTop
		c:add("Cylinder", V(0.32, 0.85, 0.85), top + V(0, 0.16, 0), V(0, 0, 90), GOLD, { Material = "Foil", Role = "Detail", KeepColor = true })
		for i = 0, 4 do
			local angle = i * (math.pi * 2 / 5)
			c:add("Ellipsoid", V(0.14, 0.32, 0.14), top + V(math.cos(angle) * 0.36, 0.42, math.sin(angle) * 0.36), nil, GOLD, { Material = "Foil", Role = "Detail", KeepColor = true })
		end
		c:add("Ball", V(0.17, 0, 0), top + V(0, 0.2, -0.43), nil, Color3.fromRGB(255, 50, 90), { Material = "Neon", Role = "Detail", KeepColor = true })
	end
	if set.Halo then
		local center = c.HeadTop + V(0, 0.3, 0)
		for i = 0, 11 do
			local angle = i * (math.pi * 2 / 12)
			c:add("Ball", V(0.13, 0, 0), center + V(math.cos(angle) * 0.45, 0, math.sin(angle) * 0.45), nil, Color3.fromRGB(255, 235, 140), { Material = "Neon", Role = "Detail", KeepColor = true })
		end
	end
	if set.Helmet then
		c:add("Ball", V(c.HeadSize * 1.45, 0, 0), c.HeadCenter + V(0, 0.08, 0), nil, Color3.fromRGB(190, 230, 255), { Material = "Glass", Transparency = 0.7, Role = "Detail", KeepColor = true })
	end
	if set.Antenna then
		local top = c.HeadTop
		c:segment("Cylinder", top, top + V(0.05, 0.7, 0.1), 0.07, DARK, { Role = "Detail", KeepColor = true })
		c:add("Ball", V(0.24, 0, 0), top + V(0.05, 0.78, 0.1), nil, "Accent", { Material = "Neon", Role = "Detail" })
	end
	if set.AngelWings then
		local b, sz = c.BodyCenter, c.BodySize
		local r, l = c:pair("Ellipsoid", V(0.12, 1.0, 1.15), b + V(0.75, sz.Y * 0.45 + 0.3, 0.25), V(0, 0, -58), WHITE, { Role = "Detail", KeepColor = true })
		c:flap(r, b + V(0.4, sz.Y * 0.45, 0.25), 1, 22, 4)
		c:flap(l, b + V(-0.4, sz.Y * 0.45, 0.25), -1, 22, 4)
	end
	if set.Lollipop then
		local b = c.BodyCenter
		c:segment("Cylinder", b + V(0.55, 0.35, 0.45), b + V(0.75, 1.4, 0.6), 0.09, WHITE, { Role = "Detail", KeepColor = true })
		c:add("Cylinder", V(0.14, 0.8, 0.8), b + V(0.8, 1.7, 0.62), V(0, 90, 0), "Accent", { Role = "Detail" })
		c:add("Cylinder", V(0.16, 0.45, 0.45), b + V(0.8, 1.7, 0.6), V(0, 90, 0), WHITE, { Role = "Detail", KeepColor = true })
	end
	if set.Sneakers then
		-- chunky white sneakers on every foot-level accent part
		for _, part in ipairs(c.Model:GetChildren()) do
			if part:IsA("BasePart") and part ~= c.Root and part:GetAttribute("Role") == "Detail" and part.Position.Y < 0.3 * c.S and part.Size.Y < 0.4 * c.S then
				part.Color = WHITE
				part.Size = part.Size * V(1.25, 1.7, 1.3)
				part.Position = part.Position + V(0, 0.1 * c.S, 0)
				c:addCF("Block", V(part.Size.X / c.S * 0.7, 0.08, part.Size.Z / c.S * 0.5), CFrame.new(part.Position / c.S + V(0, part.Size.Y / c.S * 0.5, -0.05)), "Accent", { Role = "Detail" })
			end
		end
	end
	if set.Bongos then
		local b = c.BodyCenter
		for _, x in ipairs({ -0.55, 0.55 }) do
			c:add("Cylinder", V(0.7, 0.75, 0.75), b + V(x, -0.2, -0.95), V(0, 0, 90), Color3.fromRGB(200, 120, 60), { Role = "Detail", KeepColor = true })
			c:add("Cylinder", V(0.08, 0.65, 0.65), b + V(x, 0.16, -0.95), V(0, 0, 90), Color3.fromRGB(245, 225, 190), { Role = "Detail", KeepColor = true })
		end
	end
	if set.CupHeld then
		local b = c.BodyCenter
		c:add("Cylinder", V(0.55, 0.42, 0.42), b + V(0.75, 0.1, -0.7), V(0, 0, 90), WHITE, { Role = "Detail", KeepColor = true })
		c:add("Cylinder", V(0.08, 0.36, 0.36), b + V(0.75, 0.4, -0.7), V(0, 0, 90), Color3.fromRGB(110, 70, 40), { Role = "Detail", KeepColor = true })
	end
	if set.Pizza then
		local b = c.BodyCenter
		c:triangle(b + V(0.8, 0.1, -0.6), 0.9, 1.0, 0.12, 0, Color3.fromRGB(240, 200, 90), 0, { Role = "Detail", KeepColor = true })
		c:add("Ball", V(0.2, 0, 0), b + V(0.8, 0.2, -0.72), nil, Color3.fromRGB(200, 40, 40), { Role = "Detail", KeepColor = true })
		c:add("Ball", V(0.2, 0, 0), b + V(0.65, -0.1, -0.72), nil, Color3.fromRGB(200, 40, 40), { Role = "Detail", KeepColor = true })
	end
	if set.Cone then
		local top = c.HeadTop
		c:add("Ellipsoid", V(0.5, 0.75, 0.5), top + V(0, 0.3, 0), nil, Color3.fromRGB(230, 180, 110), { Role = "Detail", KeepColor = true })
		c:add("Ball", V(0.55, 0, 0), top + V(0, 0.8, 0), nil, Color3.fromRGB(255, 150, 200), { Role = "Detail", KeepColor = true })
		c:add("Ball", V(0.45, 0, 0), top + V(0, 1.2, 0), nil, Color3.fromRGB(255, 240, 220), { Role = "Detail", KeepColor = true })
		c:add("Ball", V(0.16, 0, 0), top + V(0, 1.45, 0), nil, Color3.fromRGB(220, 30, 50), { Role = "Detail", KeepColor = true })
	end
	if set.Tube then
		local b, sz = c.BodyCenter, c.BodySize
		c:add("Cylinder", V(1.6, 0.55, 0.55), b + V(0, sz.Y * 0.55, 0.1), V(0, 0, 0), Color3.fromRGB(225, 180, 120), { Role = "Detail", KeepColor = true })
		for _, x in ipairs({ -0.82, 0.82 }) do
			c:add("Cylinder", V(0.06, 0.4, 0.4), b + V(x, sz.Y * 0.55, 0.1), nil, WHITE, { Role = "Detail", KeepColor = true })
		end
	end
	if set.Jet then
		local b, sz = c.BodyCenter, c.BodySize
		c:pair("Block", V(1.6, 0.1, 0.8), b + V(1.1, sz.Y * 0.2, 0.1), V(0, 0, 0), Color3.fromRGB(190, 195, 205), { Role = "Detail", KeepColor = true })
		c:pair("Cylinder", V(0.9, 0.45, 0.45), b + V(1.3, sz.Y * 0.2 - 0.25, 0.3), V(0, 90, 0), Color3.fromRGB(90, 95, 110), { Role = "Detail", KeepColor = true })
		c:pair("Cylinder", V(0.1, 0.36, 0.36), b + V(1.3, sz.Y * 0.2 - 0.25, 0.78), V(0, 90, 0), Color3.fromRGB(255, 140, 40), { Role = "Detail", KeepColor = true, Material = "Neon" })
	end
	if set.Bat then
		local b = c.BodyCenter
		c:segment("Cylinder", b + V(0.95, -0.3, -0.3), b + V(1.25, 1.4, -0.6), 0.14, Color3.fromRGB(150, 100, 55), { Role = "Detail", KeepColor = true })
		c:add("Ellipsoid", V(0.3, 0.75, 0.3), b + V(1.3, 1.65, -0.65), V(0, 0, -10), Color3.fromRGB(150, 100, 55), { Role = "Detail", KeepColor = true })
	end
	if set.Tutu then
		local b, sz = c.BodyCenter, c.BodySize
		for i = 0, 9 do
			local angle = i * (math.pi * 2 / 10)
			c:add("Ellipsoid", V(0.55, 0.12, 0.7), b + V(math.cos(angle) * sz.X * 0.62, -sz.Y * 0.4, math.sin(angle) * sz.Z * 0.62), V(0, -math.deg(angle), 0), Color3.fromRGB(255, 190, 225), { Role = "Detail", KeepColor = true })
		end
	end
	if set.Spikes then
		local b, sz = c.BodyCenter, c.BodySize
		for i = 1, 10 do
			local angle = i * 2.1
			local p = b + V(math.cos(angle) * sz.X * 0.42, sz.Y * 0.35 + (i % 3) * 0.12, math.sin(angle) * sz.Z * 0.42)
			c:add("Ellipsoid", V(0.1, 0.4, 0.1), p, V(0, 0, math.deg(angle)), Color3.fromRGB(240, 230, 150), { Role = "Detail", KeepColor = true })
		end
	end
	if set.Propeller then
		local top = c.HeadTop
		c:segment("Cylinder", top, top + V(0, 0.45, 0), 0.1, DARK, { Role = "Detail", KeepColor = true })
		local blade = c:add("Block", V(1.6, 0.06, 0.22), top + V(0, 0.5, 0), nil, Color3.fromRGB(230, 230, 240), { Role = "Detail", KeepColor = true, Name = "Propeller" })
		blade:SetAttribute("Spin", true)
	end
	if set.Glasses then
		local head = c.HeadCenter
		for _, x in ipairs({ -0.33, 0.33 }) do
			c:add("Cylinder", V(0.1, 0.42, 0.42), head + V(x, 0.15, -c.HeadSize * 0.52), V(0, 90, 0), DARK, { Role = "Detail", KeepColor = true })
		end
		c:add("Block", V(0.2, 0.06, 0.06), head + V(0, 0.15, -c.HeadSize * 0.52), nil, DARK, { Role = "Detail", KeepColor = true })
	end
	if set.Bomb then
		local b, sz = c.BodyCenter, c.BodySize
		c:add("Ball", V(0.85, 0, 0), b + V(-0.95, sz.Y * 0.1, -0.5), nil, DARK, { Role = "Detail", KeepColor = true })
		c:segment("Cylinder", b + V(-0.95, sz.Y * 0.1 + 0.4, -0.5), b + V(-0.8, sz.Y * 0.1 + 0.75, -0.6), 0.08, Color3.fromRGB(200, 170, 120), { Role = "Detail", KeepColor = true })
		c:add("Ball", V(0.2, 0, 0), b + V(-0.8, sz.Y * 0.1 + 0.8, -0.6), nil, Color3.fromRGB(255, 160, 40), { Role = "Detail", KeepColor = true, Material = "Neon" })
	end
	if set.Scarf then
		local head = c.HeadCenter
		c:add("Cylinder", V(0.5, c.HeadSize * 0.95, c.HeadSize * 0.95), head + V(0, -c.HeadSize * 0.55, 0), V(0, 0, 90), Color3.fromRGB(220, 60, 70), { Role = "Detail", KeepColor = true })
	end
end


-- Cute "chibi" proportions: grow the head (and everything on it) and lift it a
-- little. Only for body plans with a separate head; owls, penguins and crabs
-- are already one round shape.
local CHIBI = {
	Dog = true,
	Wolf = true,
	Cat = true,
	Fox = true,
	Bunny = true,
	Bear = true,
	Lamb = true,
	Deer = true,
	Unicorn = true,
	Dragon = true,
	Phoenix = true,
	Seal = true,
	Lizard = true,
	Capybara = true,
}
local HEAD_SCALE = 1.3
local EYE_SCALE = 1.12

local function chibify(c, archetype: string)
	if not CHIBI[archetype] then
		return
	end
	local s = c.S
	local center = c.HeadCenter * s
	local radius = c.HeadSize * 0.85 * s
	local top = (c.HeadCenter.Y + 0.3) * s
	local lift = V(0, (HEAD_SCALE - 1) * c.HeadSize * 0.4 * s, 0)
	local flapping = {}
	for _, flapper in ipairs(c.Flappers) do
		flapping[flapper.Part] = true
	end
	for _, part in ipairs(c.Model:GetChildren()) do
		if part:IsA("BasePart") and part ~= c.Root and part ~= c.BodyPart and not flapping[part] then
			local position = part.Position
			local near = (position - center).Magnitude < radius
			local above = position.Y > top and math.abs(position.Z - center.Z) < c.HeadSize * 0.9 * s
			if near or above then
				local k = if part:GetAttribute("Role") == "Eye" then HEAD_SCALE * EYE_SCALE else HEAD_SCALE
				part.Size *= k
				part.CFrame = CFrame.new(center + (position - center) * HEAD_SCALE + lift) * part.CFrame.Rotation
			end
		end
	end
	c.HeadCenter += lift / s
	c.HeadTop = c.HeadCenter + (c.HeadTop - c.HeadCenter) * HEAD_SCALE
end

local function addEffects(c, def, extras: { string })
	local body = c.BodyPart
	if not body then
		return
	end
	local set = {}
	for _, name in ipairs(extras) do
		set[name] = true
	end
	local rarity = Config.Rarities[def.Rarity]
	local order = rarity and rarity.Order or 1

	if set.Glow then
		local light = Instance.new("PointLight")
		light.Color = c:color("Secondary")
		light.Range = 7 * c.S
		light.Brightness = 0.9
		light.Shadows = false
		light.Parent = body
	end
	if set.Fire and c.TailPart then
		local fire = Instance.new("Fire")
		fire.Size = 2.2 * c.S
		fire.Heat = 4
		fire.Color = c:color("Secondary")
		fire.SecondaryColor = c:color("Primary")
		fire.Parent = c.TailPart
	end

	local sparkle: Color3? = nil
	if c.Tier == 1 then
		sparkle = GOLD
	elseif c.Tier >= 2 then
		sparkle = Color3.fromRGB(255, 255, 255)
	elseif order >= Config.Rarities.Legendary.Order and rarity then
		sparkle = rarity.Color
	end
	if sparkle then
		local emitter = Instance.new("ParticleEmitter")
		emitter.Color = ColorSequence.new(sparkle)
		emitter.LightEmission = 1
		emitter.Rate = if order >= Config.Rarities.Mythic.Order or c.Tier >= 2 then 10 else 5
		emitter.Lifetime = NumberRange.new(0.6, 1.1)
		emitter.Speed = NumberRange.new(0.5, 1.5)
		emitter.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.32 * c.S), NumberSequenceKeypoint.new(1, 0) })
		emitter.SpreadAngle = Vector2.new(180, 180)
		emitter.Parent = body
	end
	if order >= Config.Rarities.Mythic.Order and rarity then
		local aura = Instance.new("ParticleEmitter")
		aura.Color = ColorSequence.new(rarity.Color, c:color("Secondary"))
		aura.LightEmission = 0.8
		aura.Rate = 4
		aura.Lifetime = NumberRange.new(1.2, 1.8)
		aura.Speed = NumberRange.new(0.1, 0.4)
		aura.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.2 * c.S), NumberSequenceKeypoint.new(1, 0.2) })
		aura.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.5), NumberSequenceKeypoint.new(1, 1) })
		aura.Parent = body
		local light = body:FindFirstChildOfClass("PointLight") or Instance.new("PointLight")
		light.Color = rarity.Color
		light.Range = 9 * c.S
		light.Brightness = 1.2
		light.Parent = body
	end
end

--------------------------------------------------------------------------------
-- Public API
--------------------------------------------------------------------------------

local customModels: Instance? = nil

local function prepareCustom(model: Model)
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			descendant.Anchored = true
			descendant.CanCollide = false
			descendant.CanTouch = false
			descendant.CanQuery = false
			descendant.Massless = true
		elseif descendant:IsA("Script") or descendant:IsA("LocalScript") then
			descendant:Destroy()
		end
	end
end

local function weld(built: Built)
	local root = built.Root
	local flapping: { [BasePart]: Flapper } = {}
	for _, flapper in ipairs(built.Flappers) do
		flapping[flapper.Part] = flapper
	end
	for _, part in ipairs(built.Model:GetDescendants()) do
		if part:IsA("BasePart") and part ~= root then
			local flapper = flapping[part]
			if flapper then
				-- Part = Root * C0 * C1^-1 ; animate by rotating C0 at the hinge.
				local partRel = root.CFrame:ToObjectSpace(part.CFrame)
				local motor = Instance.new("Motor6D")
				motor.Part0 = root
				motor.Part1 = part
				motor.C0 = flapper.Hinge
				motor.C1 = partRel:Inverse() * flapper.Hinge
				motor.Parent = part
				flapper.Joint = motor
			else
				local constraint = Instance.new("WeldConstraint")
				constraint.Part0 = root
				constraint.Part1 = part
				constraint.Parent = part
			end
			part.Anchored = false
		end
	end
end

-- opts: Effects (particles/lights/fire), Weld (for a moving character), Scale
function BrainrotBuilder.Build(name: string, opts: { [string]: any }?): Built
	local o = opts or {}
	local def = Config.Brainrots[name]
	local style = BrainrotStyles.Characters[name]
	local rarityScale = def and RARITY_SCALE[def.Rarity] or 1
	local scale = (o.Scale or 1) * rarityScale * (style and style.Scale or 1)

	local model = Instance.new("Model")
	model.Name = name

	local root = Instance.new("Part")
	root.Name = "Root"
	root.Size = V(0.2, 0.2, 0.2)
	root.Transparency = 1
	root.Anchored = true
	root.CanCollide = false
	root.CanTouch = false
	root.CanQuery = false
	root.Massless = true
	root.CFrame = CFrame.new()
	root.Parent = model
	model.PrimaryPart = root

	local built: Built = { Model = model, Root = root, Height = 3 * scale, Flappers = {} }

	-- Want real art? A Model named like the brainrot in ReplicatedStorage.BrainrotModels wins.
	if not customModels then
		customModels = ReplicatedStorage:FindFirstChild("BrainrotModels")
	end
	local custom = customModels and customModels:FindFirstChild(name)
	if custom and custom:IsA("Model") then
		local clone = custom:Clone()
		prepareCustom(clone)
		local cf, size = clone:GetBoundingBox()
		local target = CFrame.new(0, size.Y / 2, 0) * cf.Rotation
		clone:PivotTo(target * cf:Inverse() * clone:GetPivot())
		for _, child in ipairs(clone:GetChildren()) do
			child.Parent = model
		end
		clone:Destroy()
		built.Height = size.Y
		if o.Weld then
			weld(built)
		end
		return built
	end

	local resolvedStyle = style or { Archetype = "Blob", Primary = Color3.fromRGB(200, 200, 200), Secondary = Color3.fromRGB(240, 240, 240), Accent = Color3.fromRGB(120, 120, 120) }
	local c = newCtx(model, root, scale, resolvedStyle, 0)
	local archetype = Archetypes[resolvedStyle.Archetype] or Archetypes.Blob
	archetype(c)
	local extras = resolvedStyle.Extras or {}
	addExtras(c, extras)
	chibify(c, resolvedStyle.Archetype)
	if o.Effects then
		addEffects(c, def or { Rarity = "Common" }, extras)
	end

	built.Flappers = c.Flappers
	local _, size = model:GetBoundingBox()
	built.Height = size.Y
	if o.Weld then
		weld(built)
	end
	return built
end

-- Animates flapping wings. Call every frame (or less).
function BrainrotBuilder.Animate(built: Built, t: number, phase: number)
	for _, flapper in ipairs(built.Flappers) do
		if flapper.Joint then
			local angle = math.sin(t * flapper.Speed + phase) * flapper.Amount * flapper.Side
			flapper.Joint.C0 = flapper.Hinge * CFrame.Angles(0, 0, angle)
		end
	end
end

--------------------------------------------------------------------------------
-- 3D previews for UI
--------------------------------------------------------------------------------

-- Frames a camera so the whole model is visible from the front-left.
function BrainrotBuilder.FrameCamera(viewport: ViewportFrame, model: Model, zoom: number?)
	local camera = viewport.CurrentCamera
	if not camera then
		local newCamera = Instance.new("Camera")
		newCamera.Parent = viewport
		viewport.CurrentCamera = newCamera
		camera = newCamera
	end
	local cam = camera :: Camera
	cam.FieldOfView = 30
	local cf, size = model:GetBoundingBox()
	local radius = size.Magnitude / 2
	local distance = radius / math.tan(math.rad(cam.FieldOfView / 2)) * (zoom or 1.05)
	local direction = V(-0.55, 0.35, -1).Unit
	cam.CFrame = CFrame.lookAt(cf.Position + direction * distance, cf.Position)
end

local VIEW_AMBIENT = Color3.fromRGB(170, 170, 185)
local VIEW_LIGHT = Color3.fromRGB(255, 250, 240)

-- Shows the character as a black shape (locked brainrots).
function BrainrotBuilder.SetSilhouette(viewport: ViewportFrame, silhouette: boolean)
	viewport.ImageColor3 = if silhouette then Color3.new(0, 0, 0) else Color3.new(1, 1, 1)
	viewport.Ambient = if silhouette then Color3.new(0, 0, 0) else VIEW_AMBIENT
	viewport.LightColor = if silhouette then Color3.new(0, 0, 0) else VIEW_LIGHT
end

-- props: any ViewportFrame properties, plus Silhouette = true, Zoom, Parent.
function BrainrotBuilder.CreateViewport(name: string, props: { [string]: any }?): (ViewportFrame, Model)
	local p = props or {}
	local viewport = Instance.new("ViewportFrame")
	viewport.BackgroundTransparency = 1
	viewport.Ambient = VIEW_AMBIENT
	viewport.LightColor = VIEW_LIGHT
	viewport.LightDirection = V(-0.6, -1, -0.7)
	for key, value in pairs(p) do
		if key ~= "Silhouette" and key ~= "Zoom" and key ~= "Parent" then
			(viewport :: any)[key] = value
		end
	end
	local built = BrainrotBuilder.Build(name, { Effects = false, Weld = false })
	built.Model.Parent = viewport
	BrainrotBuilder.FrameCamera(viewport, built.Model, p.Zoom)
	if p.Silhouette then
		BrainrotBuilder.SetSilhouette(viewport, true)
	end
	if p.Parent then
		viewport.Parent = p.Parent
	end
	return viewport, built.Model
end

return BrainrotBuilder
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">BrainrotStyles</string>
          <string name="Source"><![CDATA[--------------------------------------------------------------------------------
-- BrainrotStyles - how each brainrot looks (used by BrainrotBuilder).
--
--   Archetype: body plan. Animals: Dog, Wolf, Cat, Fox, Bunny, Deer, Unicorn,
--              Bear, Lamb, Owl, Penguin, Phoenix, Dragon, Seal, Crab, Lizard,
--              Capybara. Brainrot shapes: Banana, Frog, Squid, Turtle, Shark,
--              Log, Cup, Elephant, Giraffe, Dolphin, Blob
--   Primary / Secondary / Accent: main body, belly & details, feet/extras
--   Material / Transparency: optional body material (Foil, Glass, Neon, ...)
--   Scale: optional size tweak (1 = normal)
--   Extras: Crown, Halo, Helmet, AngelWings, Fire, Glow, Spots, Stripes,
--           Sprinkles, Antenna, Aurora, Lollipop, Sneakers, Bongos, CupHeld,
--           Pizza, Cone, Tube, Jet, Bat, Tutu, Spikes, Propeller, Glasses,
--           Bomb, Scarf
--
-- Want real art? Put a Model named exactly like the brainrot inside
-- ReplicatedStorage.BrainrotModels and it is used instead of the generated one.
--------------------------------------------------------------------------------

local function rgb(r, g, b)
	return Color3.fromRGB(r, g, b)
end

local GOLD = rgb(255, 205, 60)
local BLACK = rgb(30, 28, 34)
local WHITE = rgb(245, 245, 250)

local Characters = {
	["Pasta Panda"] = { Archetype = "Bear", Primary = WHITE, Secondary = BLACK, Accent = rgb(255, 215, 120), Extras = { "Spots" } },
	["Bongo Banana"] = { Archetype = "Banana", Primary = rgb(255, 225, 60), Secondary = rgb(255, 245, 180), Accent = rgb(120, 85, 40), Extras = { "Bongos" } },
	["Espresso Frog"] = { Archetype = "Frog", Primary = rgb(95, 190, 70), Secondary = rgb(200, 240, 150), Accent = rgb(110, 70, 40), Extras = { "CupHeld" } },
	["Pizza Pigeon"] = { Archetype = "Owl", Primary = rgb(150, 160, 185), Secondary = rgb(215, 220, 235), Accent = rgb(255, 150, 60), Extras = { "Pizza" } },

	["Gelato Goat"] = { Archetype = "Deer", Primary = rgb(240, 235, 225), Secondary = rgb(255, 200, 220), Accent = rgb(140, 110, 90), Extras = { "Cone" } },
	["Mozzarella Moth"] = { Archetype = "Phoenix", Primary = rgb(250, 245, 230), Secondary = rgb(255, 230, 180), Accent = rgb(210, 160, 90), Extras = { "Antenna" } },
	["Spaghetti Squid"] = { Archetype = "Squid", Primary = rgb(255, 200, 110), Secondary = rgb(230, 70, 60), Accent = rgb(255, 240, 200) },
	["Tiramisu Turtle"] = { Archetype = "Turtle", Primary = rgb(120, 80, 55), Secondary = rgb(245, 230, 200), Accent = rgb(90, 160, 90) },

	["Capybara Cannoli"] = { Archetype = "Capybara", Primary = rgb(175, 125, 80), Secondary = rgb(235, 205, 160), Accent = rgb(90, 60, 40), Extras = { "Tube" } },
	["Sneaker Shark"] = { Archetype = "Shark", Primary = rgb(70, 130, 220), Secondary = rgb(225, 240, 255), Accent = rgb(230, 60, 80), Extras = { "Sneakers" } },
	["Croco Jet"] = { Archetype = "Lizard", Primary = rgb(80, 150, 70), Secondary = rgb(200, 230, 150), Accent = rgb(110, 85, 45), Extras = { "Jet" }, Scale = 1.15 },
	["Timber Tapper"] = { Archetype = "Log", Primary = rgb(150, 100, 60), Secondary = rgb(225, 190, 140), Accent = rgb(90, 60, 40), Extras = { "Bat" } },

	["Ballerina Latte"] = { Archetype = "Cup", Primary = rgb(255, 250, 245), Secondary = rgb(235, 200, 160), Accent = rgb(170, 110, 70), Extras = { "Tutu" } },
	["Cactus Elephante"] = { Archetype = "Elephant", Primary = rgb(90, 170, 90), Secondary = rgb(160, 215, 130), Accent = rgb(255, 120, 160), Extras = { "Spikes" } },
	["Fridge Giraffe"] = { Archetype = "Giraffe", Primary = rgb(240, 240, 245), Secondary = rgb(180, 180, 195), Accent = rgb(255, 170, 40) },
	["Drone Dolphino"] = { Archetype = "Dolphin", Primary = rgb(110, 160, 230), Secondary = rgb(225, 240, 255), Accent = rgb(60, 60, 75), Extras = { "Propeller" } },

	["Nuke Nonna"] = { Archetype = "Bear", Primary = rgb(230, 200, 190), Secondary = rgb(245, 235, 230), Accent = rgb(160, 100, 120), Extras = { "Glasses", "Scarf", "Bomb" } },
	["Galaxy Gnocchi"] = { Archetype = "Blob", Primary = rgb(70, 40, 140), Secondary = rgb(190, 120, 255), Accent = rgb(120, 230, 255), Extras = { "Spots", "Glow" } },
	["Tralala Titan"] = { Archetype = "Shark", Primary = rgb(40, 60, 130), Secondary = rgb(190, 220, 255), Accent = rgb(255, 60, 60), Extras = { "Sneakers", "Crown", "Glow" }, Scale = 1.15 },

	["Omega Brainrot"] = { Archetype = "Dragon", Primary = rgb(40, 20, 70), Secondary = rgb(255, 80, 200), Accent = rgb(120, 255, 240), Extras = { "Crown", "Halo", "Glow", "Fire" }, Scale = 1.1 },

	["Sahur Stick"] = { Archetype = "Log", Primary = rgb(110, 75, 45), Secondary = rgb(210, 170, 120), Accent = rgb(255, 160, 40), Extras = { "Bat", "Glow" } },
	["Cloud Croissant"] = { Archetype = "Banana", Primary = rgb(235, 180, 110), Secondary = rgb(255, 235, 200), Accent = rgb(255, 255, 255), Extras = { "AngelWings" } },
	["Prestige Pastaroni"] = { Archetype = "Blob", Primary = rgb(255, 200, 90), Secondary = rgb(230, 60, 60), Accent = rgb(255, 250, 230), Extras = { "Crown", "Sprinkles", "Glow" } },

	["Fragment Phantom"] = { Archetype = "Squid", Primary = rgb(60, 20, 90), Secondary = rgb(170, 90, 255), Accent = rgb(120, 255, 240), Material = "Glass", Transparency = 0.25, Extras = { "Glow", "Halo", "Aurora" } },

	["Golden Goatini"] = { Archetype = "Deer", Primary = GOLD, Secondary = rgb(255, 240, 190), Accent = rgb(200, 140, 20), Material = "Foil", Extras = { "Crown", "Glow" } },
}

local BrainrotStyles = {}
BrainrotStyles.Characters = Characters

BrainrotStyles.Archetypes = {
	Dog = true,
	Wolf = true,
	Cat = true,
	Fox = true,
	Bunny = true,
	Deer = true,
	Unicorn = true,
	Bear = true,
	Lamb = true,
	Owl = true,
	Penguin = true,
	Phoenix = true,
	Dragon = true,
	Seal = true,
	Crab = true,
	Lizard = true,
	Capybara = true,
	Banana = true,
	Frog = true,
	Squid = true,
	Turtle = true,
	Shark = true,
	Log = true,
	Cup = true,
	Elephant = true,
	Giraffe = true,
	Dolphin = true,
	Blob = true,
}

BrainrotStyles.Extras = {
	Crown = true,
	Halo = true,
	Helmet = true,
	AngelWings = true,
	Fire = true,
	Glow = true,
	Spots = true,
	Stripes = true,
	Sprinkles = true,
	Antenna = true,
	Aurora = true,
	Lollipop = true,
	Sneakers = true,
	Bongos = true,
	CupHeld = true,
	Pizza = true,
	Cone = true,
	Tube = true,
	Jet = true,
	Bat = true,
	Tutu = true,
	Spikes = true,
	Propeller = true,
	Glasses = true,
	Bomb = true,
	Scarf = true,
}

return BrainrotStyles
]]></string>
