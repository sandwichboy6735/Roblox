	c:pair("Ellipsoid", V(0.2, 0.35, 0.95), V(0.75, 1.9, -0.05), V(0, 0, -30), "Primary")
	c:add("Ellipsoid", V(1.3, 0.18, 0.6), V(0, 0.15, 0.5), nil, "Primary") -- tail flukes
