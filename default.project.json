{
  "name": "HatchLegends",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": {
        "$path": "src/Shared"
      },
      "PetModels": {
        "$className": "Folder"
      }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "src/Server"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "$properties": {
        "CharacterWalkSpeed": 20
      },
      "StarterPlayerScripts": {
        "$className": "StarterPlayerScripts",
        "$path": "src/Client"
      }
    },
    "Workspace": {
      "$className": "Workspace",
      "$properties": {
        "StreamingEnabled": false
      },
      "Terrain": {
        "$properties": {
          "Decoration": true
        }
      }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": {
        "Technology": "Future",
        "ClockTime": 14,
        "Brightness": 3,
        "Ambient": [
          0.35,
          0.35,
          0.4
        ],
        "OutdoorAmbient": [
          0.5,
          0.5,
          0.55
        ],
        "GlobalShadows": true,
        "EnvironmentDiffuseScale": 0.6,
        "EnvironmentSpecularScale": 0.6
      }
    },
    "SoundService": {
      "$className": "SoundService",
      "$properties": {
        "RespectFilteringEnabled": true
      }
    },
    "StarterGui": {
      "$className": "StarterGui",
      "$properties": {
        "ShowDevelopmentGui": true
      }
    }
  }
}